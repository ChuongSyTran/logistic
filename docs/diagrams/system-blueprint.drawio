          <mxGeometry x="7350" y="4260" width="1224" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n452" value="Thu hồi quyền" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="8594" y="4260" width="388" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n453" value="&lt;b&gt;Vì sao cần cơ chế này.&lt;/b&gt; Quy tắc an toàn yêu cầu cổng quản trị chỉ mở cho dải địa chỉ cố định, nhưng tiến trình triển khai tự động được cấp địa chỉ khác nhau ở mỗi lần chạy. Giải pháp là mở quyền cho đúng địa chỉ hiện hành ngay trước khi thực thi và thu hồi ngay sau đó — &lt;b&gt;bước thu hồi luôn được thực thi kể cả khi tiến trình thất bại giữa chừng&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Nguyên tắc bổ sung.&lt;/b&gt; Máy chủ đích không lưu thông tin xác thực của kho mã nguồn và không chạy trình biên dịch; nó chỉ tải ảnh đã dựng sẵn. Tệp biến môi trường được sinh tại thời điểm triển khai từ kho bí mật, không tồn tại trong kho mã." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="4338" width="2652" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e454" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6220" y="3725" as="sourcePoint" />
            <mxPoint x="6280" y="3725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e455" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6280" y="3725" as="sourcePoint" />
            <mxPoint x="6280" y="5174" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e456" value="Tiếp tục sang chặng IV — bước 31" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=13;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6280" y="5174" as="sourcePoint" />
            <mxPoint x="60" y="5174" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e457" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="5174" as="sourcePoint" />
            <mxPoint x="60" y="5365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e458" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="5365" as="sourcePoint" />
            <mxPoint x="160" y="5365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n459" value="CHẶNG IV · TRUY CẬP DỮ LIỆU, PHÁT SỰ KIỆN VÀ ĐƯỜNG PHẢN HỒI VỀ NGƯỜI DÙNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="5220" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n460" value="31" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n461" value="&lt;b&gt;Chọn nhóm kết nối&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Repo — tầng truy cập dữ liệu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n462" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Tầng này hiện thực hoá giao diện do tầng nghiệp vụ khai báo và là nơi &lt;b&gt;duy nhất&lt;/b&gt; biết tới câu truy vấn, tên bảng và cấu hình kết nối.&lt;br&gt;&lt;br&gt;Quyết định đầu tiên: thao tác này là ghi hay đọc — từ đó chọn nhóm kết nối tương ứng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="5470" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n463" value="&lt;b&gt;Hai nhóm kết nối riêng biệt&lt;/b&gt;&lt;br&gt;&lt;code&gt;dbMaster&lt;/code&gt; — mọi lệnh ghi, và các truy vấn đọc cần dữ liệu mới nhất tuyệt đối.&lt;br&gt;&lt;code&gt;dbSlave&lt;/code&gt; — các truy vấn đọc chấp nhận độ trễ đồng bộ vài mili-giây.&lt;br&gt;&lt;br&gt;Đây là cái giá phải trả của mô hình nhân bản: ứng dụng phải tự phân luồng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="5774" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n464" value="&lt;b&gt;Tham số kết nối cần khai báo tường minh&lt;/b&gt;&lt;br&gt;&lt;b&gt;Kích thước nhóm&lt;/b&gt; — quá nhỏ thì yêu cầu xếp hàng, quá lớn thì vượt giới hạn kết nối đồng thời của hệ quản trị.&lt;br&gt;&lt;b&gt;Thời gian chờ&lt;/b&gt; — không đặt thì tiến trình chờ vô hạn.&lt;br&gt;&lt;b&gt;Giữ kết nối&lt;/b&gt; — thiếu thì kết nối bị thiết bị trung gian đóng âm thầm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="6072" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n465" value="&lt;b&gt;Nguyên tắc phân tách&lt;/b&gt;&lt;br&gt;Mỗi dịch vụ sở hữu cơ sở dữ liệu riêng và không truy cập trực tiếp dữ liệu của dịch vụ khác. Mọi trao đổi diễn ra qua giao diện hoặc thông điệp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="6362" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n466" value="32" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n467" value="&lt;b&gt;Ghi vào máy chủ chính&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PostgreSQL Master — WAL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n468" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Trước khi thay đổi dữ liệu trên đĩa, hệ quản trị &lt;b&gt;luôn ghi ý định thay đổi&lt;/b&gt; vào một nhật ký tuần tự trước.&lt;br&gt;&lt;br&gt;Nhật ký này được gọi là WAL trong PostgreSQL, binlog trong MySQL và translog trong Elasticsearch — ba tên gọi cho cùng một nguyên lý." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="5470" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n469" value="&lt;b&gt;Vì sao thiết kế như vậy&lt;/b&gt;&lt;br&gt;Ghi tuần tự có thông lượng gần với bộ nhớ trong, cao hơn nhiều so với ghi ngẫu nhiên.&lt;br&gt;&lt;br&gt;Đồng thời nhật ký này là cơ sở để khôi phục sau sự cố: hệ quản trị phát lại phần chưa kịp ghi xuống cấu trúc dữ liệu chính." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="5782" width="480" height="284" as="geometry" />
        </mxCell>
        <mxCell id="n470" value="&lt;b&gt;Ranh giới của giao dịch&lt;/b&gt;&lt;br&gt;Thao tác lập chỉ mục tìm kiếm ở bước 38 &lt;b&gt;không được&lt;/b&gt; đặt bên trong giao dịch này.&lt;br&gt;&lt;br&gt;Nếu đặt bên trong, độ trễ hoặc lỗi của hệ thống tìm kiếm sẽ kéo dài thời gian giữ khoá và có thể làm huỷ cả giao dịch nghiệp vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="6078" width="480" height="272" as="geometry" />
        </mxCell>
        <mxCell id="n471" value="&lt;b&gt;Cấu hình liên quan&lt;/b&gt;&lt;br&gt;&lt;code&gt;wal_level = replica&lt;/code&gt; — bật định dạng nhật ký phù hợp để truyền cho bản sao&lt;br&gt;&lt;code&gt;max_wal_senders&lt;/code&gt; — số bản sao kết nối đồng thời" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="6362" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n472" value="33" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n473" value="&lt;b&gt;Nhân bản sang máy chủ phụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Streaming Replication&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n474" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Máy chủ chính truyền liên tục dòng nhật ký qua mạng. Máy chủ phụ nhận và thực thi lại đúng trình tự thao tác đó trên ổ đĩa cục bộ.&lt;br&gt;&lt;br&gt;Mọi lệnh ghi gửi tới máy chủ phụ đều bị từ chối ở mức bộ máy lưu trữ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="5470" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n475" value="&lt;b&gt;Độ trễ đồng bộ và hệ quả&lt;/b&gt;&lt;br&gt;Dữ liệu vừa ghi có thể mất từ vài mili-giây tới vài giây mới xuất hiện ở bản sao.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tình huống điển hình:&lt;/b&gt; người dùng cập nhật thông tin (ghi vào máy chính) rồi chuyển sang màn hình xem lại (đọc từ bản sao) và vẫn thấy dữ liệu cũ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cách xử lý:&lt;/b&gt; định tuyến truy vấn đọc ngay sau thao tác ghi về máy chủ chính, hoặc trả thẳng dữ liệu vừa ghi mà không đọc lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="5768" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n476" value="&lt;b&gt;Tuỳ chọn cho môi trường tải cao&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nhân bản đồng bộ&lt;/b&gt; — máy chính chờ bản sao xác nhận rồi mới báo thành công. Không mất dữ liệu khi sự cố nhưng thông lượng ghi giảm.&lt;br&gt;&lt;b&gt;Khe nhân bản&lt;/b&gt; — giữ lại nhật ký chưa được xác nhận để bản sao mất kết nối dài vẫn đồng bộ tiếp được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="6092" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n477" value="&lt;b&gt;Rủi ro vận hành&lt;/b&gt;&lt;br&gt;Khe nhân bản không được thu hồi sau khi bản sao ngừng hoạt động vĩnh viễn sẽ làm nhật ký tích tụ và đầy ổ đĩa của máy chủ chính." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="6372" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n478" value="34" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n479" value="&lt;b&gt;Đọc qua bộ nhớ đệm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Redis — mẫu cache-aside&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n480" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;① Truy vấn bộ nhớ đệm trước.&lt;br&gt;② Có dữ liệu ⇒ trả về ngay, không chạm tới cơ sở dữ liệu.&lt;br&gt;③ Không có ⇒ đọc từ cơ sở dữ liệu, ghi kết quả vào bộ nhớ đệm kèm &lt;b&gt;thời gian sống&lt;/b&gt;, rồi trả về.&lt;br&gt;&lt;br&gt;Các yêu cầu tiếp theo trong khoảng thời gian sống được phục vụ hoàn toàn từ bộ nhớ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="5470" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n481" value="&lt;b&gt;Ba rủi ro vận hành&lt;/b&gt;&lt;br&gt;&lt;b&gt;Hết hạn đồng loạt&lt;/b&gt; — nhiều khoá cùng hết hạn khiến tải dồn vào cơ sở dữ liệu. Xử lý bằng cách phân tán thời gian sống với một khoảng ngẫu nhiên nhỏ.&lt;br&gt;&lt;b&gt;Truy vấn khoá không tồn tại&lt;/b&gt; — lưu giá trị rỗng với thời gian sống ngắn.&lt;br&gt;&lt;b&gt;Bộ đệm lệch dữ liệu&lt;/b&gt; — xoá khoá tương ứng ngay trong luồng xử lý ghi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="5768" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n482" value="&lt;b&gt;Vai trò của thời gian sống&lt;/b&gt;&lt;br&gt;Đây là ràng buộc dự phòng cuối cùng: kể cả khi logic xoá bộ đệm bị bỏ sót ở đâu đó, dữ liệu sai lệch cũng chỉ tồn tại trong khoảng thời gian hữu hạn thay vì vĩnh viễn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="6080" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n483" value="&lt;b&gt;Các mục đích sử dụng khác&lt;/b&gt;&lt;br&gt;Khoá phân tán để ngăn hai tiến trình cùng xử lý một đối tượng, và lưu trạng thái tạm của nghiệp vụ ghép chuyến cần độ trễ rất thấp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="6350" width="480" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n484" value="35" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n485" value="&lt;b&gt;Phát sự kiện — Producer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kafka — chọn phân vùng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n486" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Sự kiện nghiệp vụ được đẩy vào nhật ký phân tán để các thành phần khác xử lý bất đồng bộ.&lt;br&gt;&lt;br&gt;Thành phần gửi tự quyết định phân vùng đích:&lt;br&gt;• Có khoá ⇒ băm khoá để chọn phân vùng cố định.&lt;br&gt;• Không có khoá ⇒ gom thành lô lớn gửi vào một phân vùng cho tới khi đầy lô." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="5470" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n487" value="&lt;b&gt;Vì sao khoá phân vùng quan trọng&lt;/b&gt;&lt;br&gt;Thông điệp cùng khoá luôn tới cùng một phân vùng. Đây là &lt;b&gt;điều kiện duy nhất&lt;/b&gt; để bảo toàn trình tự cho một thực thể nghiệp vụ.&lt;br&gt;&lt;br&gt;Hệ thống dùng định danh chuyến đi làm khoá, bảo đảm mọi sự kiện của cùng một chuyến giữ đúng thứ tự phát sinh." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="5782" width="480" height="288" as="geometry" />
        </mxCell>
        <mxCell id="n488" value="&lt;b&gt;Mức xác nhận và độ bền&lt;/b&gt;&lt;br&gt;&lt;code&gt;acks=0&lt;/code&gt; — không chờ phản hồi, thông lượng cao nhất, rủi ro mất dữ liệu lớn.&lt;br&gt;&lt;code&gt;acks=1&lt;/code&gt; — chờ nút chính ghi xong.&lt;br&gt;&lt;code&gt;acks=all&lt;/code&gt; — chờ toàn bộ bản sao đồng bộ xác nhận. &lt;b&gt;Hệ thống chọn mức này.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="6082" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n489" value="&lt;b&gt;Chống ghi trùng&lt;/b&gt;&lt;br&gt;Khi phản hồi xác nhận bị mất trên đường về, thành phần gửi sẽ gửi lại. Bật cơ chế đánh số thứ tự để nút nhận phát hiện và loại bỏ bản trùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="6362" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n490" value="36" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n491" value="&lt;b&gt;Lưu vào nhật ký phân tán&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Broker — Leader và tập bản sao&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n492" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Mỗi phân vùng có một nút giữ vai trò chính; thành phần gửi chỉ ghi vào nút đó. Các nút còn lại sao chép về.&lt;br&gt;&lt;br&gt;Dữ liệu chỉ được nối thêm vào &lt;b&gt;cuối tệp&lt;/b&gt; và không bao giờ sửa. Mỗi bản ghi nhận một số thứ tự tăng dần trong phạm vi phân vùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="5470" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n493" value="&lt;b&gt;Tập bản sao đồng bộ&lt;/b&gt;&lt;br&gt;Bản sao bắt kịp nút chính trong ngưỡng thời gian cho phép được xếp vào tập đồng bộ; bản sao chậm bị loại khỏi tập.&lt;br&gt;&lt;br&gt;Khi nút chính dừng, &lt;b&gt;chỉ bản sao trong tập này&lt;/b&gt; được đề cử thay thế — đây là điều kiện bảo đảm không mất dữ liệu đã xác nhận." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="5782" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n494" value="&lt;b&gt;Ba tính chất chi phối thiết kế&lt;/b&gt;&lt;br&gt;① Dữ liệu &lt;b&gt;bất biến&lt;/b&gt;, không sửa hay xoá từng bản ghi.&lt;br&gt;② Trình tự chỉ bảo đảm &lt;b&gt;trong một phân vùng&lt;/b&gt;, không có trình tự toàn cục.&lt;br&gt;③ &lt;b&gt;Không truy vấn được&lt;/b&gt; theo điều kiện — cách duy nhất lấy dữ liệu là đọc tuần tự." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="6086" width="480" height="274" as="geometry" />
        </mxCell>
        <mxCell id="n495" value="&lt;b&gt;Chính sách lưu trữ&lt;/b&gt;&lt;br&gt;Giữ theo thời gian, theo dung lượng, hoặc nén theo khoá để chỉ giữ bản ghi mới nhất của mỗi khoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="6372" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n496" value="37" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n497" value="&lt;b&gt;Tiêu thụ và ghi nhận tiến độ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Consumer Group — offset&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n498" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Tiến trình tiêu thụ chủ động kéo dữ liệu về, xử lý, rồi ghi nhận vị trí đã xử lý vào một chủ đề nội bộ.&lt;br&gt;&lt;br&gt;Nhờ đó khi tiến trình khởi động lại, nó biết đọc tiếp từ đâu thay vì bắt đầu lại từ đầu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="5470" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n499" value="&lt;b&gt;Vị trí ghi nhận quyết định độ tin cậy&lt;/b&gt;&lt;br&gt;Ghi nhận &lt;b&gt;trước&lt;/b&gt; khi xử lý ⇒ mất thông điệp nếu tiến trình dừng giữa chừng.&lt;br&gt;Ghi nhận &lt;b&gt;sau&lt;/b&gt; khi xử lý ⇒ có thể xử lý lặp khi tiến trình dừng trước lúc ghi nhận.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ thống chọn phương án thứ hai&lt;/b&gt;, do đó mọi logic xử lý &lt;b&gt;bắt buộc phải cho kết quả không đổi khi chạy lại&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="5774" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n500" value="&lt;b&gt;Ràng buộc về khả năng mở rộng&lt;/b&gt;&lt;br&gt;Trong cùng một nhóm, mỗi phân vùng chỉ được đọc bởi tối đa một tiến trình. Số phân vùng là &lt;b&gt;trần mở rộng theo chiều ngang&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Tăng số phân vùng về sau sẽ thay đổi kết quả băm khoá và làm mất trình tự đã thiết lập với dữ liệu cũ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="6086" width="480" height="276" as="geometry" />
        </mxCell>
        <mxCell id="n501" value="&lt;b&gt;Nhiều nhóm trên một chủ đề&lt;/b&gt;&lt;br&gt;Mỗi nhóm giữ con trỏ tiến độ độc lập, cho phép nhiều mục đích sử dụng khác nhau cùng đọc một luồng sự kiện mà không ảnh hưởng lẫn nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="6374" width="480" height="206" as="geometry" />
        </mxCell>
        <mxCell id="n502" value="38" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n503" value="&lt;b&gt;Cập nhật mô hình đọc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Elasticsearch — lập chỉ mục&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n504" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Dữ liệu được đưa vào bộ đệm trong bộ nhớ và đồng thời ghi vào nhật ký giao dịch trên đĩa.&lt;br&gt;&lt;br&gt;Sau chu kỳ làm mới — mặc định một giây — bộ đệm được chuyển thành một &lt;b&gt;phân đoạn&lt;/b&gt; mới và dữ liệu bắt đầu tìm kiếm được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="5470" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n505" value="&lt;b&gt;Hệ quả: dữ liệu không tìm thấy ngay&lt;/b&gt;&lt;br&gt;Đây không phải lỗi mà là đặc tính thiết kế. Giao diện cần hiển thị kết quả ngay sau khi ghi phải dùng tuỳ chọn chờ tới chu kỳ làm mới kế tiếp.&lt;br&gt;&lt;br&gt;Ép làm mới ở mỗi thao tác ghi sẽ sinh ra rất nhiều phân đoạn nhỏ và gây tải nặng cho tiến trình hợp nhất — chỉ dùng khi viết kiểm thử." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="5782" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n506" value="&lt;b&gt;Phân đoạn là bất biến&lt;/b&gt;&lt;br&gt;Thao tác xoá chỉ đánh dấu bản ghi là đã loại bỏ; thao tác sửa được thực hiện bằng cách đánh dấu bản cũ và ghi bản mới.&lt;br&gt;&lt;br&gt;Dung lượng chỉ thực sự thu hồi khi tiến trình hợp nhất chạy — đó là lý do chỉ mục bị cập nhật thường xuyên phình lớn hơn dữ liệu thực tế." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="6090" width="480" height="274" as="geometry" />
        </mxCell>
        <mxCell id="n507" value="&lt;b&gt;Vị trí trong kiến trúc&lt;/b&gt;&lt;br&gt;Đây là &lt;b&gt;mô hình đọc&lt;/b&gt;, không phải nguồn sự thật. Mất toàn bộ chỉ mục phải là sự cố khắc phục được bằng lập chỉ mục lại từ cơ sở dữ liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="6376" width="480" height="204" as="geometry" />
        </mxCell>
        <mxCell id="n508" value="39" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n509" value="&lt;b&gt;Đường phản hồi qua tầng ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gRPC → JSON → nén → mã hoá&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n510" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Kết quả đi ngược lại đúng chuỗi đã qua:&lt;br&gt;&lt;br&gt;① Tầng nghiệp vụ trả kết quả cho tầng tiếp nhận.&lt;br&gt;② Chuyển thành thông điệp nhị phân gửi về cổng vào.&lt;br&gt;③ Cổng vào chuyển đổi sang dạng văn bản có cấu trúc.&lt;br&gt;④ Máy chủ web nén nội dung và mã hoá bằng khoá phiên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="5470" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n511" value="&lt;b&gt;Ranh giới đồng bộ và bất đồng bộ&lt;/b&gt;&lt;br&gt;Bước 32 tới 34 nằm &lt;b&gt;trong&lt;/b&gt; đường phản hồi: người dùng phải chờ chúng hoàn tất.&lt;br&gt;&lt;br&gt;Bước 35 tới 38 nằm &lt;b&gt;ngoài&lt;/b&gt; đường phản hồi: phản hồi được trả về ngay, còn việc phát sự kiện và cập nhật mô hình đọc hoàn tất sau đó.&lt;br&gt;&lt;br&gt;Đây là nguồn gốc của độ trễ hiển thị đã nêu ở bước 38." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="5778" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n512" value="&lt;b&gt;Khuyến nghị vận hành&lt;/b&gt;&lt;br&gt;Đưa định danh vết vào tiêu đề phản hồi. Khi tiếp nhận báo cáo sự cố, định danh này cho phép truy xuất chính xác yêu cầu tương ứng thay vì tìm kiếm theo thời điểm gần đúng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="6090" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n513" value="&lt;b&gt;Xử lý lỗi&lt;/b&gt;&lt;br&gt;Mã lỗi của giao thức nội bộ được ánh xạ sang mã trạng thái tương ứng của giao thức bên ngoài, kèm thông báo đã được bản địa hoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="6370" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n514" value="40" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="5346" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n515" value="&lt;b&gt;Đường phản hồi về thiết bị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;NAT ra → biên → mạng cục bộ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="5300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n516" value="&lt;b&gt;Việc diễn ra — trình tự đảo ngược&lt;/b&gt;&lt;br&gt;① Cổng kết nối Internet biên dịch địa chỉ nguồn thành địa chỉ công cộng.&lt;br&gt;② Mạng biên nhận, giải mã, có thể lưu đệm, rồi mã hoá lại bằng khoá của phiên với người dùng.&lt;br&gt;③ Gói tin đi ngược qua chuỗi thiết bị định tuyến về mạng của nhà cung cấp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="5470" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n517" value="&lt;b&gt;Khôi phục nhãn tại thiết bị biên&lt;/b&gt;&lt;br&gt;Thiết bị định tuyến của mạng cục bộ nhận gói tin có địa chỉ đích là địa chỉ công cộng của chính nó, tra &lt;b&gt;bảng phiên NAT&lt;/b&gt; đã lập ở bước 8, và khôi phục lại địa chỉ cùng cổng nội bộ ban đầu.&lt;br&gt;&lt;br&gt;Ứng dụng trên thiết bị người dùng hoàn toàn không biết quá trình thay thế nhãn đã diễn ra." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="5782" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n518" value="&lt;b&gt;Hoàn tất chu trình&lt;/b&gt;&lt;br&gt;Bộ chuyển mạch chuyển khung tới đúng thiết bị. Nhân hệ điều hành tháo lần lượt các lớp và chuyển tải trọng cho tiến trình đang giữ cổng nguồn ban đầu.&lt;br&gt;&lt;br&gt;Thư viện mã hoá giải mã nội dung và ứng dụng hiển thị kết quả." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="6090" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n519" value="&lt;b&gt;Điều kiện để chiều về hoạt động&lt;/b&gt;&lt;br&gt;Mỗi thiết bị kiểm soát trên đường đi phải cho phép lưu lượng phản hồi. Lớp có ghi nhớ trạng thái tự động cho qua; lớp phi trạng thái cần luật khai báo tường minh cho chiều ra." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="6370" width="480" height="212" as="geometry" />
        </mxCell>
