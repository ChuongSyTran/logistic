        <mxCell id="n939" value="11000000 . 10101000 . 00000001 . 00000000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
