        <mxCell id="n593" value="PHỤ LỤC E · NỘI BỘ KAFKA — ĐƯỜNG ĐI CỦA MỘT THÔNG ĐIỆP BÊN TRONG CỤM  (chi tiết hoá bước 35–37)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="6860" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n594" value="E1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n595" value="&lt;b&gt;Tiếp nhận bản ghi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Producer — hàng đợi trong bộ nhớ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n596" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Lời gọi gửi thông điệp &lt;b&gt;không&lt;/b&gt; đẩy dữ liệu ra mạng ngay. Bản ghi được đặt vào vùng đệm trong bộ nhớ của tiến trình gửi và lời gọi trả về ngay lập tức.&lt;br&gt;&lt;br&gt;Một luồng nền riêng biệt chịu trách nhiệm gom lô và truyền đi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="7110" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n597" value="&lt;b&gt;Cấu tạo một bản ghi&lt;/b&gt;&lt;br&gt;&lt;code&gt;Khoá&lt;/code&gt; — tuỳ chọn, quyết định phân vùng đích&lt;br&gt;&lt;code&gt;Giá trị&lt;/code&gt; — nội dung nghiệp vụ&lt;br&gt;&lt;code&gt;Tiêu đề&lt;/code&gt; — cặp khoá-giá trị bổ sung&lt;br&gt;&lt;code&gt;Nhãn thời gian&lt;/code&gt; — do bên gửi hoặc bên nhận gán&lt;br&gt;&lt;code&gt;Chủ đề và phân vùng&lt;/code&gt; — đích đến" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="7408" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n598" value="&lt;b&gt;Hệ quả của việc trả về ngay&lt;/b&gt;&lt;br&gt;Lời gọi thành công &lt;b&gt;không&lt;/b&gt; có nghĩa thông điệp đã tới nơi. Nó chỉ có nghĩa bản ghi đã vào vùng đệm.&lt;br&gt;&lt;br&gt;Muốn biết kết quả thật phải chờ phản hồi bất đồng bộ hoặc gọi phương thức chờ. Bỏ qua điểm này là nguyên nhân phổ biến khiến thông điệp mất mà không ai phát hiện." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="7698" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n599" value="&lt;b&gt;Vùng đệm đầy&lt;/b&gt;&lt;br&gt;Khi tốc độ sinh vượt tốc độ truyền, vùng đệm đầy và lời gọi gửi bị chặn lại theo thời gian cấu hình, sau đó ném lỗi.&lt;br&gt;&lt;br&gt;Đây là cơ chế phản áp: nó buộc tầng ứng dụng phải chậm lại thay vì tiêu thụ hết bộ nhớ tiến trình." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="8002" width="480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n600" value="E2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n601" value="&lt;b&gt;Tuần tự hoá&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Chuyển cấu trúc thành chuỗi byte&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n602" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Khoá và giá trị được chuyển thành chuỗi byte bằng bộ tuần tự hoá đã cấu hình.&lt;br&gt;&lt;br&gt;Hệ thống truyền thông điệp &lt;b&gt;không hiểu&lt;/b&gt; cấu trúc dữ liệu — với nó, mọi thứ chỉ là chuỗi byte không có ý nghĩa." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="7110" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n603" value="&lt;b&gt;Vì sao lược đồ phải được quản lý riêng&lt;/b&gt;&lt;br&gt;Vì tầng lưu trữ không kiểm tra cấu trúc, mọi ràng buộc phải do hai đầu tự thoả thuận.&lt;br&gt;&lt;br&gt;Bên gửi đổi cấu trúc mà bên nhận chưa cập nhật sẽ dẫn tới lỗi giải mã &lt;b&gt;lúc chạy&lt;/b&gt;, không phải lúc biên dịch — và lỗi xuất hiện ở tiến trình tiêu thụ chứ không phải nơi gây ra thay đổi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="7390" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n604" value="&lt;b&gt;Quy tắc tương thích&lt;/b&gt;&lt;br&gt;Thay đổi cấu trúc thông điệp phải tương thích cả hai chiều: bên nhận cũ đọc được dữ liệu mới, bên nhận mới đọc được dữ liệu cũ.&lt;br&gt;&lt;br&gt;Lý do: dữ liệu tồn tại trong nhật ký nhiều ngày, nên trong cùng một chủ đề luôn có đồng thời nhiều phiên bản cấu trúc." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="7694" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n605" value="&lt;b&gt;Ảnh hưởng tới dung lượng&lt;/b&gt;&lt;br&gt;Kích thước sau tuần tự hoá quyết định trực tiếp chi phí lưu trữ và băng thông nhân bản. Với hệ số nhân bản bằng ba, mỗi byte ghi vào sẽ chiếm ba byte trên đĩa và phát sinh hai lần truyền qua mạng nội bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="7984" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n606" value="E3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n607" value="&lt;b&gt;Chọn phân vùng đích&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Partitioner — băm khoá&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n608" value="&lt;b&gt;Công thức định tuyến&lt;/b&gt;&lt;br&gt;&lt;code&gt;partition =&lt;/code&gt;&lt;br&gt;&lt;code&gt;&amp;nbsp; abs( murmur2(khoá) ) % số_phân_vùng&lt;/code&gt;&lt;br&gt;&lt;br&gt;Hàm băm được chọn vì tốc độ thực thi cao và phân phối đều, không nhằm mục đích mật mã." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="7110" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n609" value="&lt;b&gt;Bốn chiến lược&lt;/b&gt;&lt;br&gt;&lt;b&gt;Băm khoá&lt;/b&gt; — mặc định khi có khoá. Cùng khoá luôn về cùng phân vùng.&lt;br&gt;&lt;b&gt;Sticky&lt;/b&gt; — mặc định khi khoá rỗng. Gom lô vào một phân vùng tới khi đầy lô rồi mới đổi.&lt;br&gt;&lt;b&gt;Luân phiên&lt;/b&gt; — cũ, tạo nhiều lô nhỏ, hiệu quả kém.&lt;br&gt;&lt;b&gt;Tự định nghĩa&lt;/b&gt; — ánh xạ theo quy tắc nghiệp vụ riêng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="7390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n610" value="&lt;b&gt;Hệ quả không thể đảo ngược&lt;/b&gt;&lt;br&gt;Số phân vùng nằm ở &lt;b&gt;mẫu số&lt;/b&gt; của phép chia lấy dư. Tăng số phân vùng làm toàn bộ ánh xạ khoá thay đổi.&lt;br&gt;&lt;br&gt;Dữ liệu cũ vẫn nằm ở phân vùng cũ, dữ liệu mới của cùng một khoá lại đi vào phân vùng khác ⇒ &lt;b&gt;trình tự theo khoá bị phá vỡ vĩnh viễn&lt;/b&gt; đối với các bản ghi đã tồn tại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="7702" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n611" value="&lt;b&gt;Phân bố lệch&lt;/b&gt;&lt;br&gt;Nếu một khoá chiếm tỷ trọng lớn bất thường, phân vùng chứa khoá đó trở thành điểm nghẽn trong khi các phân vùng còn lại nhàn rỗi.&lt;br&gt;&lt;br&gt;Cần đo phân bố khoá trước khi chọn, thay vì giả định dữ liệu phân tán đều." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="8014" width="480" height="272" as="geometry" />
        </mxCell>
        <mxCell id="n612" value="E4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n613" value="&lt;b&gt;Gom lô và nén&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Batch · linger · compression&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n614" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Các bản ghi cùng đích được gom thành lô. Lô được gửi đi khi đạt một trong hai điều kiện:&lt;br&gt;&lt;br&gt;• Kích thước lô đạt ngưỡng cấu hình.&lt;br&gt;• Thời gian chờ gom lô kết thúc.&lt;br&gt;&lt;br&gt;Nén được áp dụng trên &lt;b&gt;toàn bộ lô&lt;/b&gt;, không phải từng bản ghi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="7110" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n615" value="&lt;b&gt;Vì sao nén theo lô hiệu quả hơn&lt;/b&gt;&lt;br&gt;Các bản ghi trong cùng một chủ đề thường có cấu trúc lặp lại — cùng tên trường, cùng dạng giá trị. Nén cả lô cho phép thuật toán khai thác phần lặp này.&lt;br&gt;&lt;br&gt;Tỷ lệ nén vì thế tăng theo kích thước lô, khác hẳn khi nén từng bản ghi riêng lẻ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="7414" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n616" value="&lt;b&gt;Đánh đổi giữa độ trễ và thông lượng&lt;/b&gt;&lt;br&gt;Thời gian chờ gom lô bằng không cho độ trễ thấp nhất nhưng tạo ra rất nhiều gói tin nhỏ, làm giảm thông lượng tổng thể và tăng tải cho cụm.&lt;br&gt;&lt;br&gt;Giá trị lớn hơn cải thiện thông lượng nhưng cộng thêm độ trễ cố định cho mọi thông điệp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="7718" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n617" value="&lt;b&gt;Nén được giữ nguyên trên đĩa&lt;/b&gt;&lt;br&gt;Lô đã nén được ghi thẳng xuống nhật ký ở dạng nén và truyền tới bên tiêu thụ cũng ở dạng nén.&lt;br&gt;&lt;br&gt;Nhờ đó chi phí giải nén chỉ phát sinh một lần tại bên tiêu thụ, và tiết kiệm được cả dung lượng đĩa lẫn băng thông nhân bản." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="8016" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n618" value="E5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n619" value="&lt;b&gt;Gửi tới nút giữ vai trò chính&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Leader của phân vùng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n620" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Bên gửi tra bản đồ cụm để xác định nút nào đang giữ vai trò chính của phân vùng đích, rồi mở kết nối trực tiếp tới nút đó.&lt;br&gt;&lt;br&gt;Bản đồ cụm được lấy về khi khởi động qua một lời gọi truy vấn siêu dữ liệu, và được làm mới định kỳ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="7110" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n621" value="&lt;b&gt;Chỉ cần khai báo một địa chỉ&lt;/b&gt;&lt;br&gt;Cấu hình kết nối chỉ cần địa chỉ của một nút bất kỳ trong cụm. Nút đó trả về danh sách đầy đủ các nút còn lại kèm sơ đồ phân bố phân vùng.&lt;br&gt;&lt;br&gt;Sau đó bên gửi tự mở kết nối thẳng tới đúng nút cần thiết, không đi qua trung gian." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="7414" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n622" value="&lt;b&gt;Khi vai trò chính thay đổi&lt;/b&gt;&lt;br&gt;Nút giữ vai trò chính dừng hoạt động ⇒ bản đồ cụm trong bộ nhớ của bên gửi trở nên lạc hậu.&lt;br&gt;&lt;br&gt;Lời gọi tiếp theo trả về lỗi báo sai nút; thư viện tự động truy vấn lại siêu dữ liệu và gửi lại. Quá trình này minh bạch với tầng ứng dụng nhưng gây ra một khoảng tăng độ trễ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="7718" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n623" value="&lt;b&gt;Vì sao chỉ ghi vào một nút&lt;/b&gt;&lt;br&gt;Cho phép ghi đồng thời vào nhiều bản sao sẽ dẫn tới xung đột thứ tự. Tập trung mọi thao tác ghi vào một điểm là cách đơn giản nhất để có một trình tự xác định duy nhất cho mỗi phân vùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="8016" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n624" value="E6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n625" value="&lt;b&gt;Ghi vào nhật ký phân đoạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sequential I/O · page cache&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n626" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Dữ liệu chỉ được &lt;b&gt;nối thêm vào cuối&lt;/b&gt; tệp phân đoạn đang mở. Không có thao tác ghi ngẫu nhiên, không có cập nhật tại chỗ.&lt;br&gt;&lt;br&gt;Mỗi phân vùng là một thư mục chứa nhiều tệp phân đoạn kèm tệp chỉ mục ánh xạ số thứ tự sang vị trí byte." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="7110" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n627" value="&lt;b&gt;Vì sao thông lượng cao dù ghi xuống đĩa&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Ghi tuần tự&lt;/b&gt; — không phát sinh thời gian di chuyển đầu đọc, thông lượng tiệm cận giới hạn phần cứng.&lt;br&gt;② &lt;b&gt;Bộ đệm trang của hệ điều hành&lt;/b&gt; — dữ liệu vào bộ nhớ trước, hệ điều hành ghi xuống đĩa theo lô. Tiến trình không tự quản lý bộ đệm riêng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="7422" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n628" value="&lt;b&gt;Hệ quả với cấu hình bộ nhớ&lt;/b&gt;&lt;br&gt;Vì dựa vào bộ đệm trang, phần lớn bộ nhớ máy chủ nên để trống cho hệ điều hành thay vì cấp hết cho tiến trình.&lt;br&gt;&lt;br&gt;Cấp quá nhiều bộ nhớ cho tiến trình sẽ làm giảm bộ đệm trang và khiến thông lượng đọc &lt;b&gt;giảm&lt;/b&gt; thay vì tăng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="7734" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n629" value="&lt;b&gt;Số thứ tự bản ghi&lt;/b&gt;&lt;br&gt;Mỗi bản ghi nhận một số nguyên tăng dần trong phạm vi phân vùng. Số này là vị trí, không phải định danh nội dung — cùng một giá trị số ở hai phân vùng khác nhau trỏ tới hai bản ghi hoàn toàn khác nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="8038" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n630" value="E7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n631" value="&lt;b&gt;Nhân bản sang bản sao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tập bản sao đồng bộ — ISR&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n632" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Các nút giữ bản sao chủ động &lt;b&gt;kéo&lt;/b&gt; dữ liệu từ nút chính, giống hệt cách một bên tiêu thụ hoạt động.&lt;br&gt;&lt;br&gt;Nút chính theo dõi vị trí đã sao chép của từng bản sao để xác định bản sao nào còn bắt kịp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="7110" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n633" value="&lt;b&gt;Tập bản sao đồng bộ&lt;/b&gt;&lt;br&gt;Bản sao nằm trong tập này khi khoảng cách so với nút chính không vượt ngưỡng thời gian cấu hình.&lt;br&gt;&lt;br&gt;Bản sao chậm — do sự cố mạng hoặc đĩa — bị loại khỏi tập và &lt;b&gt;không còn được tính&lt;/b&gt; khi xác nhận thao tác ghi, cũng không đủ điều kiện thay thế nút chính." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="7414" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n634" value="&lt;b&gt;Ngưỡng bản sao tối thiểu&lt;/b&gt;&lt;br&gt;Tham số này quy định số bản sao đồng bộ tối thiểu để thao tác ghi được chấp nhận.&lt;br&gt;&lt;br&gt;Kết hợp với mức xác nhận cao nhất: cụm ba nút, ngưỡng bằng hai ⇒ chịu được mất một nút. Đặt ngưỡng bằng ba ⇒ mất một nút là &lt;b&gt;toàn bộ thao tác ghi bị từ chối&lt;/b&gt; dù cụm vẫn còn hai nút hoạt động." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="7726" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n635" value="&lt;b&gt;Cấu hình sai thường gặp&lt;/b&gt;&lt;br&gt;Hệ số nhân bản bằng một khiến mọi cơ chế trên vô hiệu: mất nút chứa phân vùng là mất dữ liệu vĩnh viễn, không có bản sao nào để thay thế." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="8038" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n636" value="E8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n637" value="&lt;b&gt;Xác nhận về bên gửi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mức acks và tính bất biến lần gửi&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n638" value="&lt;b&gt;Ba mức xác nhận&lt;/b&gt;&lt;br&gt;&lt;code&gt;acks=0&lt;/code&gt; — không chờ. Thông lượng cao nhất, thông điệp có thể mất mà bên gửi không biết.&lt;br&gt;&lt;code&gt;acks=1&lt;/code&gt; — chờ nút chính ghi xong. Mất dữ liệu nếu nút chính dừng trước khi bản sao kịp đồng bộ.&lt;br&gt;&lt;code&gt;acks=all&lt;/code&gt; — chờ toàn bộ tập bản sao đồng bộ. &lt;b&gt;Cấu hình đang áp dụng.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="7110" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n639" value="&lt;b&gt;Chống ghi trùng khi thử lại&lt;/b&gt;&lt;br&gt;Kịch bản: nút nhận đã ghi thành công nhưng phản hồi xác nhận mất trên đường về. Bên gửi hiểu là thất bại và gửi lại ⇒ bản ghi bị nhân đôi.&lt;br&gt;&lt;br&gt;Bật cơ chế bất biến lần gửi: mỗi tiến trình gửi nhận một định danh, mỗi bản ghi mang một số thứ tự tăng dần. Nút nhận phát hiện số thứ tự đã xử lý và loại bỏ bản trùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="7422" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n640" value="&lt;b&gt;Phạm vi hiệu lực&lt;/b&gt;&lt;br&gt;Cơ chế trên chỉ bảo đảm &lt;b&gt;không trùng khi ghi vào cụm&lt;/b&gt;. Nó không liên quan tới việc bên tiêu thụ xử lý lặp — đó là bài toán riêng ở bước E10.&lt;br&gt;&lt;br&gt;Hai vấn đề thường bị gộp làm một và dẫn tới kỳ vọng sai về mức bảo đảm của hệ thống." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="7746" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n641" value="&lt;b&gt;Thứ tự khi thử lại&lt;/b&gt;&lt;br&gt;Cho phép nhiều lời gọi chưa xác nhận đồng thời có thể làm đảo thứ tự khi một lời gọi thất bại và được gửi lại. Cơ chế bất biến lần gửi đồng thời giải quyết cả vấn đề này." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="8026" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n642" value="E9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n643" value="&lt;b&gt;Bên tiêu thụ kéo dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pull model · zero-copy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n644" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Bên tiêu thụ &lt;b&gt;chủ động gọi&lt;/b&gt; để lấy dữ liệu từ vị trí nó đang đứng, thay vì bị đẩy dữ liệu tới.&lt;br&gt;&lt;br&gt;Mỗi lời gọi trả về một tập bản ghi giới hạn theo kích thước và thời gian chờ đã cấu hình." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="7110" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n645" value="&lt;b&gt;Vì sao chọn mô hình kéo&lt;/b&gt;&lt;br&gt;Bên tiêu thụ tự quyết định nhịp độ nên không bao giờ bị quá tải bởi bên gửi.&lt;br&gt;&lt;br&gt;Đồng thời cho phép đọc lại từ một vị trí bất kỳ trong quá khứ — cơ sở để dựng lại trạng thái hoặc khắc phục sự cố xử lý mà không cần bên gửi phát lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="7414" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n646" value="&lt;b&gt;Truyền dữ liệu không qua vùng nhớ ứng dụng&lt;/b&gt;&lt;br&gt;Dữ liệu đi thẳng từ bộ đệm đĩa ra giao diện mạng thông qua lời gọi hệ thống chuyên dụng, &lt;b&gt;không&lt;/b&gt; sao chép lên vùng nhớ của tiến trình.&lt;br&gt;&lt;br&gt;Nhờ đó chi phí xử lý cho mỗi byte truyền đi giảm đáng kể — đây là yếu tố then chốt giúp một nút phục vụ được lưu lượng rất lớn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="7718" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n647" value="&lt;b&gt;Điều kiện để cơ chế trên có hiệu lực&lt;/b&gt;&lt;br&gt;Chỉ áp dụng khi dữ liệu được truyền nguyên trạng. Nếu cụm phải giải nén hoặc biến đổi định dạng — chẳng hạn do bên gửi và bên nhận dùng phiên bản giao thức khác nhau — cơ chế này bị vô hiệu và tải xử lý tăng vọt." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="8030" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n648" value="E10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="6986" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n649" value="&lt;b&gt;Ghi nhận tiến độ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Offset · nhóm tiêu thụ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="6940" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n650" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Sau khi xử lý, bên tiêu thụ ghi vị trí đã hoàn tất vào một chủ đề nội bộ do cụm quản lý.&lt;br&gt;&lt;br&gt;Tiến độ được lưu &lt;b&gt;ở phía cụm&lt;/b&gt;, không phải phía ứng dụng — nhờ đó tiến trình khởi động lại trên máy khác vẫn đọc tiếp đúng chỗ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="7110" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n651" value="&lt;b&gt;Vị trí ghi nhận quyết định mức bảo đảm&lt;/b&gt;&lt;br&gt;Ghi nhận &lt;b&gt;trước&lt;/b&gt; khi xử lý ⇒ mất thông điệp nếu tiến trình dừng giữa chừng.&lt;br&gt;Ghi nhận &lt;b&gt;sau&lt;/b&gt; khi xử lý ⇒ có thể xử lý lặp. &lt;b&gt;Đây là lựa chọn của hệ thống.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hệ quả bắt buộc: mọi logic xử lý phải cho kết quả không đổi khi chạy lại cùng một thông điệp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="7414" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n652" value="&lt;b&gt;Cách bảo đảm tính bất biến khi xử lý lặp&lt;/b&gt;&lt;br&gt;• Dùng khoá duy nhất từ nội dung thông điệp làm ràng buộc ở tầng lưu trữ.&lt;br&gt;• Ghi nhận định danh thông điệp đã xử lý và bỏ qua khi gặp lại.&lt;br&gt;• Thiết kế thao tác dạng gán giá trị thay vì cộng dồn.&lt;br&gt;&lt;br&gt;Với thao tác gửi thông báo, cần khoá chống trùng theo định danh sự kiện." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="7726" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n653" value="&lt;b&gt;Nhiều nhóm trên một chủ đề&lt;/b&gt;&lt;br&gt;Mỗi nhóm giữ con trỏ tiến độ độc lập. Nhờ đó cùng một luồng sự kiện phục vụ được nhiều mục đích khác nhau — gửi thông báo, thống kê, đồng bộ mô hình đọc — mà không ảnh hưởng lẫn nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="8038" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="e654" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n595" target="n601">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
