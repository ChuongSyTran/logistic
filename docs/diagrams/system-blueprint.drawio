        </mxCell>
        <mxCell id="n170" value="Hệ điều hành cấp cổng tạm; cổng dịch vụ theo quy ước" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="8264" y="1192" width="752" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n171" value="Dải địa chỉ riêng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="1276" width="340" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n172" value="Số địa chỉ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6704" y="1276" width="300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n173" value="Ghi chú khi quy hoạch mạng riêng ảo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7004" y="1276" width="2012" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n174" value="&lt;code&gt;10.0.0.0/8&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="1308" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n175" value="16.777.216" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="1308" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n176" value="&lt;b&gt;Được chọn cho hệ thống này.&lt;/b&gt; Không trùng với dải mặc định của thiết bị mạng gia đình, mạng ảo container hay mạng mặc định của nhà cung cấp đám mây. An toàn khi về sau cần kết nối mạng với đối tác." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7004" y="1308" width="2012" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n177" value="&lt;code&gt;172.16.0.0/12&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="1368" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n178" value="1.048.576" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="1368" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n179" value="Trùng dải mặc định của mạng riêng ảo do nhà cung cấp tự khởi tạo và dải mặc định của mạng ảo container. Dễ xung đột." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7004" y="1368" width="2012" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n180" value="&lt;code&gt;192.168.0.0/16&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="1428" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n181" value="65.536" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="1428" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n182" value="Trùng dải phổ biến của thiết bị định tuyến gia đình. Khi kết nối từ xa qua mạng riêng ảo, bảng định tuyến trên máy trạm bị trùng lặp và không phân biệt được đích nội bộ với đích từ xa." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7004" y="1428" width="2012" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n183" value="&lt;b&gt;Phép toán xác định phạm vi mạng.&lt;/b&gt; Ký hiệu &lt;code&gt;/24&lt;/code&gt; nghĩa là 24 bit đầu thuộc phần mạng, 8 bit còn lại dành cho máy trạm — tương ứng mặt nạ &lt;code&gt;255.255.255.0&lt;/code&gt; và 254 địa chỉ dùng được. Chia dải &lt;code&gt;10.0.0.0/16&lt;/code&gt; thành các mạng con &lt;code&gt;/24&lt;/code&gt; cho phép tách biệt vùng công khai và vùng riêng tư, giới hạn phạm vi ảnh hưởng khi có sự cố bảo mật. Cùng phép AND này được thực hiện ở bước 4 để quyết định gửi trực tiếp hay chuyển cho cổng mặc định, và được dùng lại ở bước 18 khi bảng định tuyến của mạng riêng ảo so khớp địa chỉ đích." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="1494" width="2652" height="92" as="geometry" />
        </mxCell>
        <mxCell id="e184" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6220" y="445" as="sourcePoint" />
            <mxPoint x="6280" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e185" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6280" y="445" as="sourcePoint" />
            <mxPoint x="6280" y="1894" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e186" value="Tiếp tục sang chặng II — bước 11" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=13;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6280" y="1894" as="sourcePoint" />
            <mxPoint x="60" y="1894" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e187" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="1894" as="sourcePoint" />
            <mxPoint x="60" y="2085" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e188" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#12314f;strokeWidth=4;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="2085" as="sourcePoint" />
            <mxPoint x="160" y="2085" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n189" value="CHẶNG II · XỬ LÝ TẠI BIÊN VÀ ĐI QUA RANH GIỚI HẠ TẦNG ĐÁM MÂY" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="100" y="1940" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n190" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n191" value="&lt;b&gt;Phân giải tên miền&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cloudflare — DNS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n192" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Trước khi gửi gói tin đầu tiên, thiết bị người dùng phải đổi tên miền thành địa chỉ IP.&lt;br&gt;&lt;br&gt;Quyền quản lý bản ghi tên miền đã được chuyển cho nhà cung cấp dịch vụ biên, nên câu trả lời trả về là &lt;b&gt;địa chỉ của mạng biên&lt;/b&gt;, không phải địa chỉ máy chủ thật." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="2190" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n193" value="&lt;b&gt;Hệ quả trực tiếp&lt;/b&gt;&lt;br&gt;Địa chỉ thật của máy chủ không xuất hiện trong bất kỳ bản ghi công khai nào.&lt;br&gt;&lt;br&gt;Người ngoài không xác định được vị trí hạ tầng thật, và mọi lưu lượng bắt buộc phải đi qua lớp kiểm soát tại biên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="2470" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n194" value="&lt;b&gt;Giới hạn cần nhớ khi vận hành&lt;/b&gt;&lt;br&gt;Lớp proxy tại biên chỉ xử lý HTTP và HTTPS.&lt;br&gt;&lt;br&gt;Các giao thức khác — điển hình là SSH cổng 22 dùng để quản trị máy chủ — &lt;b&gt;không đi qua được&lt;/b&gt;. Khi cần kết nối quản trị phải gọi trực tiếp địa chỉ công cộng của máy chủ thay vì dùng tên miền." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="2740" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n195" value="&lt;b&gt;Bản ghi liên quan&lt;/b&gt;&lt;br&gt;Bản ghi loại A trỏ tên miền tới địa chỉ máy chủ gốc, có bật cờ proxy để lưu lượng đi vòng qua mạng biên. Bản ghi này được tạo tự động khi cấp phát hạ tầng, không nhập thủ công." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="3038" width="480" height="244" as="geometry" />
        </mxCell>
        <mxCell id="n196" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n197" value="&lt;b&gt;Kết thúc phiên TLS tại biên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Giải mã để kiểm tra nội dung&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n198" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Mạng biên &lt;b&gt;đóng vai máy chủ&lt;/b&gt; trong quá trình bắt tay TLS với thiết bị người dùng: trình chứng thư, thoả thuận thuật toán, sinh khoá phiên.&lt;br&gt;&lt;br&gt;Nhờ đó nội dung lớp 7 được giải mã ngay tại biên và có thể đưa vào kiểm tra ở bước tiếp theo." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="2190" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n199" value="&lt;b&gt;Hai phiên mã hoá độc lập&lt;/b&gt;&lt;br&gt;Phiên thứ nhất: thiết bị người dùng ↔ mạng biên.&lt;br&gt;Phiên thứ hai: mạng biên ↔ máy chủ gốc (bước 15).&lt;br&gt;&lt;br&gt;Hai phiên dùng khoá khác nhau. Dữ liệu tồn tại ở dạng rõ trong khoảng thời gian rất ngắn bên trong hạ tầng biên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="2492" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n200" value="&lt;b&gt;Đánh đổi phải chấp nhận&lt;/b&gt;&lt;br&gt;Mô hình này đòi hỏi tin cậy nhà cung cấp dịch vụ biên, vì họ có khả năng đọc toàn bộ nội dung.&lt;br&gt;&lt;br&gt;Đổi lại, hệ thống có được khả năng lọc tấn công ở lớp ứng dụng, lưu đệm nội dung tĩnh và che giấu hạ tầng gốc." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="2782" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n201" value="&lt;b&gt;Liên hệ với chứng thư&lt;/b&gt;&lt;br&gt;Chứng thư trình cho người dùng do nhà cung cấp biên quản lý. Máy chủ gốc dùng một chứng thư riêng cho phiên thứ hai, được cấu hình trong máy chủ web ở bước 22." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="3062" width="480" height="246" as="geometry" />
        </mxCell>
        <mxCell id="n202" value="13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n203" value="&lt;b&gt;Lọc tường lửa lớp ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kiểm tra nội dung đã giải mã&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n204" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Toàn bộ nội dung yêu cầu được đối chiếu với tập luật: thân dữ liệu, tham số trên đường dẫn, tiêu đề và cookie.&lt;br&gt;&lt;br&gt;Các dạng bị chặn: chuỗi tiêm mã truy vấn cơ sở dữ liệu, mã kịch bản chèn vào nội dung trả về, chuỗi vượt thư mục, tải trọng bất thường về kích thước." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2190" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n205" value="&lt;b&gt;Vì sao lớp 4 không thay thế được lớp này&lt;/b&gt;&lt;br&gt;Một yêu cầu mang chuỗi tiêm mã vẫn đi đúng cổng 443 và có tiêu đề hoàn toàn hợp lệ.&lt;br&gt;&lt;br&gt;Tường lửa lớp 3/4 ở bước 19 và 20 chỉ đọc phần tiêu đề nên sẽ cho qua. Chỉ lớp kiểm tra nội dung mới phát hiện được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2502" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n206" value="&lt;b&gt;Giới hạn theo chiều ngược lại&lt;/b&gt;&lt;br&gt;Lớp này cũng không thay thế được các lớp dưới: nó không ngăn được kết nối trực tiếp tới cổng cơ sở dữ liệu nếu cổng đó vô tình được mở ra Internet.&lt;br&gt;&lt;br&gt;Đây là cơ sở của mô hình phòng thủ nhiều lớp — mỗi lớp kiểm tra một khía cạnh khác nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2800" width="480" height="270" as="geometry" />
        </mxCell>
        <mxCell id="n207" value="&lt;b&gt;Vị trí trong tổng thể&lt;/b&gt;&lt;br&gt;Đây là vòng phòng thủ thứ nhất. Vòng thứ hai là kiểm soát ở cấp mạng con và giao diện mạng (bước 19–20). Vòng thứ ba là chính sách của vùng mạng riêng tư." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="3082" width="480" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n208" value="14" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n209" value="&lt;b&gt;Giới hạn tần suất và chống quá tải&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bảo vệ tài nguyên phía sau&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n210" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Lưu lượng được thống kê theo địa chỉ nguồn, theo đường dẫn và theo đặc trưng của bên gọi.&lt;br&gt;&lt;br&gt;Vượt ngưỡng cấu hình thì yêu cầu bị từ chối, bị làm chậm, hoặc bị yêu cầu xác minh trước khi phục vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="2190" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n211" value="&lt;b&gt;Vì sao đặt tại biên thay vì tại máy chủ&lt;/b&gt;&lt;br&gt;Lưu lượng tấn công bị hấp thụ bởi hạ tầng phân tán toàn cầu của nhà cung cấp biên, không tới được hạ tầng gốc.&lt;br&gt;&lt;br&gt;Nếu lọc tại máy chủ, băng thông và tài nguyên xử lý vẫn bị tiêu tốn để từ chối — nghĩa là tấn công vẫn đạt mục đích." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="2488" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n212" value="&lt;b&gt;Rủi ro cấu hình&lt;/b&gt;&lt;br&gt;Ngưỡng đặt quá thấp sẽ chặn nhầm người dùng hợp lệ, đặc biệt với các đối tác gọi qua một địa chỉ chung.&lt;br&gt;&lt;br&gt;Cần loại trừ theo danh sách đã biết cho lưu lượng giữa các hệ thống thay vì áp dụng cùng một ngưỡng cho mọi nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="2790" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n213" value="&lt;b&gt;Điểm giao với tự động hoá triển khai&lt;/b&gt;&lt;br&gt;Tiến trình triển khai tự động không đi qua đường này mà kết nối trực tiếp tới máy chủ; cơ chế kiểm soát tương ứng nằm ở phần cấp quyền tạm thời trong phụ lục C." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="3070" width="480" height="232" as="geometry" />
        </mxCell>
        <mxCell id="n214" value="15" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n215" value="&lt;b&gt;Mở phiên mã hoá tới máy chủ gốc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kết nối biên ↔ hạ tầng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n216" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Sau khi nội dung được kiểm tra, mạng biên mã hoá lại và mở một kết nối TCP mới hướng tới địa chỉ công cộng của máy chủ gốc.&lt;br&gt;&lt;br&gt;Với hạ tầng phía sau, bên gọi lúc này là &lt;b&gt;mạng biên&lt;/b&gt;, không phải thiết bị người dùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="2190" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n217" value="&lt;b&gt;Bảo toàn thông tin nguồn&lt;/b&gt;&lt;br&gt;Địa chỉ thật của người dùng được đưa vào các tiêu đề bổ sung để tầng ứng dụng vẫn xác định được ai đang gọi.&lt;br&gt;&lt;br&gt;Máy chủ web ở bước 23 chuyển tiếp các tiêu đề này xuống tầng ứng dụng; nếu thiếu, mọi yêu cầu sẽ hiện ra như đến từ cùng một nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="2470" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n218" value="&lt;b&gt;Ràng buộc bảo mật quan trọng&lt;/b&gt;&lt;br&gt;Địa chỉ công cộng của máy chủ gốc vẫn tồn tại và vẫn nhận kết nối trực tiếp nếu ai đó biết được.&lt;br&gt;&lt;br&gt;Vì vậy lớp kiểm soát ở bước 20 cần giới hạn nguồn được phép truy cập cổng 80 và 443 theo dải địa chỉ của nhà cung cấp biên, thay vì mở cho toàn bộ Internet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="2774" width="480" height="274" as="geometry" />
        </mxCell>
        <mxCell id="n219" value="&lt;b&gt;Chuyển giao phạm vi&lt;/b&gt;&lt;br&gt;Từ bước tiếp theo, gói tin đi vào hạ tầng do tổ chức tự quản lý và chịu sự chi phối của các quy tắc định tuyến và kiểm soát truy cập tự cấu hình." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="3060" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n220" value="16" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n221" value="&lt;b&gt;Vùng địa lý và vùng sẵn sàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Region · Availability Zone&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n222" value="&lt;b&gt;Khái niệm&lt;/b&gt;&lt;br&gt;&lt;b&gt;Region&lt;/b&gt; — cụm trung tâm dữ liệu của một khu vực địa lý.&lt;br&gt;&lt;b&gt;Availability Zone&lt;/b&gt; — trung tâm dữ liệu độc lập bên trong region, có nguồn điện, hệ thống làm mát và tuyến cáp riêng.&lt;br&gt;&lt;br&gt;Hệ thống này triển khai tại region Singapore." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="2190" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n223" value="&lt;b&gt;Ranh giới phải nắm&lt;/b&gt;&lt;br&gt;Mạng riêng ảo bị giới hạn trong &lt;b&gt;một region&lt;/b&gt; nhưng trải được qua &lt;b&gt;nhiều vùng sẵn sàng&lt;/b&gt;.&lt;br&gt;Mỗi mạng con lại nằm trọn trong &lt;b&gt;đúng một vùng sẵn sàng&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Do đó khả năng chịu lỗi chỉ đạt được khi tài nguyên được đặt tại tối thiểu hai vùng và có bộ cân bằng tải phía trước." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="2480" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n224" value="&lt;b&gt;Hiện trạng và khoảng cách&lt;/b&gt;&lt;br&gt;Toàn bộ hệ thống hiện chạy trên một máy chủ tại một vùng sẵn sàng duy nhất. Vùng đó ngừng hoạt động đồng nghĩa toàn hệ thống ngừng phục vụ.&lt;br&gt;&lt;br&gt;Đây là hạn chế đã biết, được chấp nhận ở giai đoạn hiện tại và nằm trong lộ trình chuẩn hoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="2778" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n225" value="&lt;b&gt;Chi phí phát sinh cần lưu ý&lt;/b&gt;&lt;br&gt;Lưu lượng giữa hai vùng sẵn sàng bị tính cước. Với hệ thống truyền thông điệp có lưu lượng lớn, đây là khoản chi phí đáng kể cần tính khi thiết kế mô hình nhiều vùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="3058" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n226" value="17" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n227" value="&lt;b&gt;Internet Gateway — NAT Inbound&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Biên dịch địa chỉ đích&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n228" value="&lt;b&gt;Việc diễn ra — tráo nhãn chiều vào&lt;/b&gt;&lt;br&gt;Cổng kết nối Internet gắn ở ranh giới mạng riêng ảo thực hiện thao tác ngược với bước 8:&lt;br&gt;&lt;br&gt;① Nhận gói tin có địa chỉ đích là &lt;b&gt;địa chỉ công cộng&lt;/b&gt;.&lt;br&gt;② Tra ánh xạ tới &lt;b&gt;địa chỉ riêng&lt;/b&gt; của giao diện mạng tương ứng.&lt;br&gt;③ Ghi đè địa chỉ đích và chuyển gói tin vào mạng con." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="2190" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n229" value="&lt;b&gt;Ánh xạ tại ranh giới&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:10px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Công cộng&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Riêng&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;13.212.0.5&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;10.0.1.20&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Địa chỉ công cộng được gán cố định (Elastic IP) thay vì cấp động, để bản ghi tên miền và các danh sách cho phép không bị sai lệch sau mỗi lần khởi động lại máy chủ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="2494" width="480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n230" value="&lt;b&gt;Mặc định là cách ly hoàn toàn&lt;/b&gt;&lt;br&gt;Mạng riêng ảo khi mới tạo không có lưu lượng ra hoặc vào. Khả năng kết nối chỉ xuất hiện khi thiết bị định tuyến được gắn vào &lt;b&gt;và&lt;/b&gt; bảng định tuyến có luật tương ứng.&lt;br&gt;&lt;br&gt;Thiếu một trong hai điều kiện, gói tin bị huỷ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="2786" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n231" value="&lt;b&gt;Chiều ngược lại&lt;/b&gt;&lt;br&gt;Cùng thiết bị này thực hiện biên dịch địa chỉ nguồn khi phản hồi đi ra, tương ứng bước 39 ở chặng IV." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="3056" width="480" height="172" as="geometry" />
        </mxCell>
        <mxCell id="n232" value="&lt;b&gt;Điểm quan trọng — xem chi tiết tại bước G7 và G8&lt;/b&gt;&lt;br&gt;Cổng này chỉ làm &lt;b&gt;ánh xạ một–một&lt;/b&gt;. Máy ảo &lt;b&gt;không có địa chỉ công cộng&lt;/b&gt; thì dù nằm trong mạng con công khai vẫn &lt;b&gt;không ra được Internet&lt;/b&gt;, vì không tồn tại mục ánh xạ để ghi đè địa chỉ nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="3240" width="480" height="222" as="geometry" />
        </mxCell>
        <mxCell id="n233" value="18" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n234" value="&lt;b&gt;Bảng định tuyến mạng riêng ảo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Quyết định phân loại mạng con&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n235" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Mỗi mạng con gắn với một bảng định tuyến. Địa chỉ đích của gói tin được so khớp theo nguyên tắc &lt;b&gt;tiền tố dài nhất khớp trước&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;code&gt;10.0.0.0/16 → local&lt;/code&gt;&lt;br&gt;&lt;code&gt;0.0.0.0/0&amp;nbsp;&amp;nbsp; → igw-id&lt;/code&gt;&lt;br&gt;&lt;br&gt;Gói tin tới địa chỉ nội bộ khớp luật thứ nhất; mọi đích còn lại khớp luật thứ hai." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="2190" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n236" value="&lt;b&gt;Luật mặc định không thể xoá&lt;/b&gt;&lt;br&gt;Luật &lt;code&gt;local&lt;/code&gt; luôn tồn tại và bảo đảm mọi mạng con trong cùng mạng riêng ảo giao tiếp được với nhau, kể cả khi nằm ở hai vùng sẵn sàng khác nhau.&lt;br&gt;&lt;br&gt;Lưu lượng nội bộ này không tính cước trong cùng vùng sẵn sàng và không đi qua thiết bị định tuyến biên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="2502" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n237" value="&lt;b&gt;Chính dòng route quyết định phân loại&lt;/b&gt;&lt;br&gt;Mạng con là &lt;b&gt;công khai&lt;/b&gt; khi bảng định tuyến của nó có luật trỏ ra cổng kết nối Internet. Không có dòng đó thì nó là &lt;b&gt;riêng tư&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Không có thuộc tính riêng nào đánh dấu điều này — sự khác biệt nằm hoàn toàn ở nội dung bảng định tuyến." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="2814" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n238" value="&lt;b&gt;Trường hợp mạng riêng tư&lt;/b&gt;&lt;br&gt;Bảng định tuyến của mạng riêng tư trỏ &lt;code&gt;0.0.0.0/0&lt;/code&gt; tới cổng biên dịch địa chỉ, cho phép khởi tạo kết nối ra ngoài nhưng không nhận kết nối vào." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="3094" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n239" value="19" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n240" value="&lt;b&gt;Kiểm soát ở cấp mạng con&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Network ACL — lớp 3/4, phi trạng thái&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n241" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Gói tin đi vào mạng con được đối chiếu với danh sách luật theo thứ tự số hiệu, dừng ở luật khớp đầu tiên.&lt;br&gt;&lt;br&gt;Luật xét trên địa chỉ nguồn, địa chỉ đích, giao thức và khoảng cổng — tức là chỉ phần tiêu đề lớp 3 và lớp 4." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="2190" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n242" value="&lt;b&gt;Đặc tính phi trạng thái&lt;/b&gt;&lt;br&gt;Lớp này &lt;b&gt;không ghi nhớ&lt;/b&gt; kết nối đã cho qua.&lt;br&gt;&lt;br&gt;Hệ quả: cho phép chiều vào thì &lt;b&gt;vẫn phải khai báo riêng&lt;/b&gt; luật cho chiều ra, nếu không phản hồi sẽ bị chặn và bên gọi chỉ thấy hiện tượng hết thời gian chờ.&lt;br&gt;&lt;br&gt;Đây là nguồn gốc phổ biến của lỗi khó chẩn đoán ở tầng mạng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="2488" width="480" height="298" as="geometry" />
        </mxCell>
        <mxCell id="n243" value="&lt;b&gt;Điểm mạnh riêng&lt;/b&gt;&lt;br&gt;Đây là lớp duy nhất viết được luật &lt;b&gt;từ chối&lt;/b&gt;. Khi cần chặn nhanh một dải địa chỉ đang rà quét, luật đặt tại đây có hiệu lực cho toàn bộ mạng con mà không phải sửa cấu hình của từng máy." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="2798" width="480" height="266" as="geometry" />
        </mxCell>
        <mxCell id="n244" value="&lt;b&gt;Hiện trạng&lt;/b&gt;&lt;br&gt;Hệ thống hiện chưa cấu hình lớp này và đang dùng giá trị mặc định cho phép toàn bộ. Bổ sung lớp này nằm trong lộ trình chuẩn hoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="3076" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n245" value="20" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="2066" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n246" value="&lt;b&gt;Kiểm soát ở cấp giao diện mạng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Security Group — lớp 3/4, có trạng thái&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="2020" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n247" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Tập luật gắn trực tiếp vào giao diện mạng ảo của máy chủ. Mặc định mọi kết nối vào bị chặn; chỉ những gì được khai báo tường minh mới đi qua.&lt;br&gt;&lt;br&gt;Cấu hình đang áp dụng: cho phép cổng 80 và 443 từ Internet, cổng 22 từ dải địa chỉ quản trị." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="2190" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n248" value="&lt;b&gt;Đặc tính có trạng thái&lt;/b&gt;&lt;br&gt;Lớp này &lt;b&gt;ghi nhớ&lt;/b&gt; kết nối đã cho phép. Phản hồi tương ứng tự động được đi ra mà không cần luật riêng cho chiều ra.&lt;br&gt;&lt;br&gt;Đây là khác biệt cơ bản so với bước 19 và là lý do hai lớp không thay thế được nhau: một lớp thuận tiện và chính xác theo từng máy, một lớp có khả năng từ chối trên diện rộng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="2488" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n249" value="&lt;b&gt;Nguyên tắc quyền tối thiểu&lt;/b&gt;&lt;br&gt;Cổng của cơ sở dữ liệu, bộ nhớ đệm và hệ thống truyền thông điệp &lt;b&gt;không bao giờ&lt;/b&gt; được mở ra Internet. Chúng chỉ nhận kết nối từ địa chỉ riêng của tầng ứng dụng.&lt;br&gt;&lt;br&gt;Giao thức chẩn đoán mạng cũng được vô hiệu hoá để hạn chế khả năng dò quét." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="2800" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n250" value="&lt;b&gt;Kết thúc chặng II&lt;/b&gt;&lt;br&gt;Gói tin đã vượt qua toàn bộ lớp kiểm soát và tới được giao diện mạng của máy chủ. Từ đây bắt đầu chặng III: xử lý bên trong máy chủ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="3070" width="480" height="212" as="geometry" />
        </mxCell>
