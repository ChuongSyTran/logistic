        <mxCell id="e668" value="hết thời gian chờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n665" target="n666">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e669" value="đạt quá bán phiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n666" target="n667">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e670" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="7139" y="7078" as="sourcePoint" />
            <mxPoint x="7139" y="7112" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e671" value="phát hiện thế hệ cao hơn ⇒ tự hạ cấp" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="7139" y="7112" as="sourcePoint" />
            <mxPoint x="6479" y="7112" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e672" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6479" y="7112" as="sourcePoint" />
            <mxPoint x="6479" y="7078" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n673" value="&lt;b&gt;Vì sao cần số thế hệ (epoch).&lt;/b&gt; Mỗi lần bầu cử, số thế hệ tăng thêm một đơn vị. Mọi mệnh lệnh mang số thế hệ cũ đều bị từ chối.&lt;br&gt;Nhờ đó cụm không thể tồn tại đồng thời hai nút cùng tự nhận là điều phối, kể cả khi mạng bị chia cắt tạm thời rồi phục hồi. &lt;b&gt;Đây là cùng một nguyên lý&lt;/b&gt; với số hiệu thế hệ của nhóm tiêu thụ ở bảng bên dưới và với cặp số phiên bản của Elasticsearch ở phụ lục F." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="7304" y="7016" width="1712" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n674" value="Bước" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7148" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n675" value="Tình huống" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7148" width="380" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n676" value="Diễn biến trong cụm ba nút điều phối" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7148" width="2142" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n677" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7180" width="130" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n678" value="Vận hành ổn định" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7180" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n679" value="Nút thứ nhất giữ vai trò điều phối ở &lt;b&gt;thế hệ 1&lt;/b&gt; và ghi mọi thay đổi cấu hình vào chủ đề siêu dữ liệu nội bộ. Hai nút còn lại sao chép trạng thái và gửi tín hiệu duy trì kết nối định kỳ. Ngưỡng đồng thuận là hai trên ba." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7180" width="2142" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n680" value="2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7238" width="130" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n681" value="Nút điều phối dừng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7238" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n682" value="Tín hiệu duy trì kết nối không còn. Hai nút còn lại bắt đầu đếm ngược theo khoảng thời gian chờ ngẫu nhiên — giá trị ngẫu nhiên nhằm tránh việc cả hai cùng ứng cử đồng thời." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7238" width="2142" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n683" value="3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7296" width="130" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n684" value="Ứng cử" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7296" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n685" value="Nút hết thời gian chờ trước chuyển sang trạng thái ứng cử, tăng số thế hệ lên &lt;b&gt;2&lt;/b&gt;, tự bỏ phiếu cho chính nó và gửi yêu cầu bỏ phiếu kèm bằng chứng về mức độ đầy đủ của bản ghi cấu hình đang giữ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7296" width="2142" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n686" value="4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7354" width="130" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n687" value="Bỏ phiếu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7354" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n688" value="Nút còn lại đối chiếu: số thế hệ phải lớn hơn thế hệ hiện tại, và bản ghi cấu hình của ứng cử viên không được cũ hơn bản ghi của chính nó. Thoả mãn thì chấp thuận. Ứng cử viên đạt hai phiếu và trở thành nút điều phối của thế hệ 2." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7354" width="2142" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n689" value="5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7412" width="130" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n690" value="Nút cũ trở lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6494" y="7412" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n691" value="Nút cũ hoạt động lại với nhận thức vẫn thuộc thế hệ 1 và phát mệnh lệnh quản trị. Các nút khác từ chối và phản hồi kèm số thế hệ hiện hành. Nút cũ nhận ra trạng thái đã lạc hậu, &lt;b&gt;tự hạ cấp&lt;/b&gt; xuống trạng thái theo dõi, huỷ trạng thái dở dang và đồng bộ lại từ đầu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6874" y="7412" width="2142" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n692" value="Khái niệm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7504" width="330" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n693" value="Mục đích" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7504" width="1160" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n694" value="Điểm thường bị hiểu sai" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7854" y="7504" width="1162" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n695" value="Partition" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7536" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n696" value="Chia nhỏ dữ liệu để nhiều tiến trình xử lý song song. Một chủ đề 100 GB chia hai phân vùng thì mỗi phân vùng giữ 50 GB &lt;b&gt;khác nhau&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7536" width="1160" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n697" value="Phân vùng 1 &lt;b&gt;không phải&lt;/b&gt; bản sao của phân vùng 0. Chúng chứa dữ liệu hoàn toàn khác nhau." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7854" y="7536" width="1162" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n698" value="Replication Factor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7612" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n699" value="Sao chép nguyên vẹn để chống mất mát. Hệ số bằng ba nghĩa là mỗi phân vùng có ba bản giống hệt trên ba nút khác nhau." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7612" width="1160" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n700" value="Bản sao của phân vùng 0 &lt;b&gt;vẫn mang tên&lt;/b&gt; phân vùng 0, chỉ nằm trên nút khác. Với hệ số N, cụm chịu được mất tối đa N−1 nút." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7854" y="7612" width="1162" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n701" value="Consumer group" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7688" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n702" value="Tập tiến trình cùng chia nhau đọc một chủ đề. Mỗi phân vùng chỉ giao cho tối đa một tiến trình trong nhóm." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7688" width="1160" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n703" value="Số phân vùng là &lt;b&gt;trần mở rộng&lt;/b&gt;. Thêm tiến trình vượt quá số phân vùng thì phần dư không nhận được việc." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7854" y="7688" width="1162" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n704" value="Cơ chế" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7772" width="330" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n705" value="Nội dung" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7772" width="2322" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n706" value="Tái cân bằng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7804" width="330" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n707" value="&lt;b&gt;Chiến lược dừng toàn bộ&lt;/b&gt; — mọi tiến trình trả lại tất cả phân vùng rồi nhận phân công mới; cả nhóm ngừng xử lý trong khoảng thời gian đó. &lt;b&gt;Chiến lược tăng dần&lt;/b&gt; — chỉ thu hồi tập phân vùng thực sự cần dịch chuyển, các tiến trình không liên quan tiếp tục hoạt động bình thường. Chiến lược thứ hai được khuyến nghị." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7804" width="2322" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n708" value="Số hiệu thế hệ nhóm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7892" width="330" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n709" value="Mỗi lần tái cân bằng, bộ điều phối tăng số hiệu thế hệ. Tình huống xử lý: một tiến trình xử lý vượt ngưỡng thời gian bị coi là đã dừng, phân vùng của nó được giao cho tiến trình khác. Khi tiến trình cũ hoàn tất và gửi lệnh ghi nhận tiến độ mang số hiệu thế hệ cũ, lệnh bị từ chối — nhờ đó tránh được việc ghi đè tiến độ sai lệch." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7892" width="2322" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n710" value="Chính sách lưu trữ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="7980" width="330" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n711" value="&lt;b&gt;Theo thời gian&lt;/b&gt; — giữ trong khoảng thời gian định trước, mặc định bảy ngày. &lt;b&gt;Theo dung lượng&lt;/b&gt; — giữ tối đa một lượng dữ liệu cho mỗi phân vùng. &lt;b&gt;Nén theo khoá&lt;/b&gt; — chỉ giữ bản ghi mới nhất của mỗi khoá, phù hợp để lưu trạng thái hiện hành thay vì toàn bộ lịch sử biến đổi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6694" y="7980" width="2322" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n712" value="&lt;b&gt;Cấu hình đang áp dụng cho cụm.&lt;/b&gt; Ba nút điều phối và ba nút dữ liệu được tách riêng để mặt phẳng điều khiển không tranh chấp tài nguyên với mặt phẳng dữ liệu. Danh sách thành viên hội đồng bầu chọn phải khai báo đầy đủ ngay từ thời điểm khởi động, vì nút mất tín hiệu cần biết trước gửi yêu cầu bỏ phiếu cho ai và ngưỡng quá bán là bao nhiêu.&lt;br&gt;&lt;b&gt;Chủ đề nghiệp vụ chính:&lt;/b&gt; ba phân vùng, khoá phân vùng là định danh chuyến đi, mức xác nhận cao nhất kèm cơ chế chống ghi trùng, ghi nhận tiến độ thủ công sau khi hoàn tất xử lý." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8072" width="2652" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n713" value="PHỤ LỤC F · NỘI BỘ ELASTICSEARCH — VÒNG ĐỜI MỘT TÀI LIỆU VÀ ĐƯỜNG ĐI CỦA MỘT TRUY VẤN  (chi tiết hoá bước 38)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="8500" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n714" value="F1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n715" value="&lt;b&gt;Tiếp nhận yêu cầu ghi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nút điều phối&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n716" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Bất kỳ nút nào trong cụm cũng nhận được yêu cầu và tạm thời đóng vai trò điều phối cho yêu cầu đó.&lt;br&gt;&lt;br&gt;Nút này không nhất thiết chứa dữ liệu liên quan; nhiệm vụ của nó là xác định đích và tổng hợp kết quả." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="8750" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n717" value="&lt;b&gt;Ba vai trò của nút trong cụm&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nút chủ&lt;/b&gt; — quản lý trạng thái cụm: có những chỉ mục nào, phân mảnh nằm ở đâu. &lt;b&gt;Không&lt;/b&gt; tham gia xử lý dữ liệu.&lt;br&gt;&lt;b&gt;Nút dữ liệu&lt;/b&gt; — lưu phân mảnh, thực hiện ghi và tìm kiếm.&lt;br&gt;&lt;b&gt;Nút điều phối&lt;/b&gt; — nhận yêu cầu, phân phát, gộp kết quả." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="9048" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n718" value="&lt;b&gt;Vì sao số nút chủ phải là số lẻ&lt;/b&gt;&lt;br&gt;Nút chủ được bầu theo ngưỡng quá bán. Với hai nút, khi đường truyền giữa chúng đứt, mỗi bên đều thấy còn một phiếu và có thể tự nhận quyền quản lý ⇒ hai bên ghi dữ liệu khác nhau, hợp nhất lại là hỏng.&lt;br&gt;&lt;br&gt;Với ba nút, chỉ bên giữ được hai nút mới đạt ngưỡng; bên còn lại tự ngừng phục vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="9352" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n719" value="&lt;b&gt;Hiện trạng triển khai&lt;/b&gt;&lt;br&gt;Cụm đang chạy ở chế độ một nút duy nhất. Toàn bộ cơ chế bầu chọn và nhân bản mô tả trong phụ lục này chưa có hiệu lực — đây là hạn chế đã biết, nằm trong lộ trình chuẩn hoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="9664" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n720" value="F2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n721" value="&lt;b&gt;Định tuyến tới phân mảnh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Routing — phép chia lấy dư&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n722" value="&lt;b&gt;Công thức định tuyến&lt;/b&gt;&lt;br&gt;&lt;code&gt;shard =&lt;/code&gt;&lt;br&gt;&lt;code&gt;&amp;nbsp; hash(_routing) % số_phân_mảnh_chính&lt;/code&gt;&lt;br&gt;&lt;br&gt;Giá trị định tuyến mặc định là định danh của tài liệu, có thể ghi đè bằng một trường nghiệp vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="8750" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n723" value="&lt;b&gt;Hệ quả: không thể đổi số phân mảnh chính&lt;/b&gt;&lt;br&gt;Số phân mảnh nằm ở &lt;b&gt;mẫu số&lt;/b&gt;. Thay đổi nó làm phép chia lấy dư cho kết quả khác, khiến hệ thống tìm sai vị trí của &lt;b&gt;toàn bộ&lt;/b&gt; tài liệu đã lưu — biểu hiện là dữ liệu cũ đột nhiên biến mất khỏi kết quả.&lt;br&gt;&lt;br&gt;Muốn thay đổi phải lập chỉ mục lại sang một chỉ mục mới rồi chuyển bí danh trỏ sang." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="9030" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n724" value="&lt;b&gt;Chọn số phân mảnh ngay từ đầu&lt;/b&gt;&lt;br&gt;Quá ít: không phân tán được tải, một phân mảnh trở nên quá lớn và chậm.&lt;br&gt;Quá nhiều: mỗi phân mảnh là một chỉ mục độc lập có chi phí cố định về bộ nhớ và tệp; hàng nghìn phân mảnh nhỏ làm suy giảm hiệu năng toàn cụm.&lt;br&gt;&lt;br&gt;Nguyên tắc thực dụng: giữ mỗi phân mảnh trong khoảng vài chục gigabyte." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="9354" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n725" value="&lt;b&gt;Ứng dụng của định tuyến tuỳ chỉnh&lt;/b&gt;&lt;br&gt;Đặt giá trị định tuyến theo định danh khách hàng khiến toàn bộ dữ liệu của khách hàng đó nằm trên một phân mảnh. Truy vấn giới hạn theo khách hàng khi đó chỉ chạm một phân mảnh thay vì toàn bộ cụm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="9658" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n726" value="F3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n727" value="&lt;b&gt;Phân tích văn bản&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Char filter → Tokenizer → Token filter&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n728" value="&lt;b&gt;Ba chặng xử lý&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Lọc ký tự&lt;/b&gt; — gỡ thẻ đánh dấu, thay thế ký tự đặc biệt.&lt;br&gt;② &lt;b&gt;Tách token&lt;/b&gt; — bắt buộc, chỉ được một bộ. Cắt theo ranh giới từ và loại bỏ dấu câu.&lt;br&gt;③ &lt;b&gt;Biến đổi token&lt;/b&gt; — xếp chồng nhiều lớp: chuyển chữ thường, loại từ dừng, đưa về nguyên thể, mở rộng từ đồng nghĩa, bỏ dấu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="8750" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n729" value="&lt;b&gt;Nguyên tắc bắt buộc&lt;/b&gt;&lt;br&gt;Câu truy vấn phải đi qua &lt;b&gt;đúng chuỗi xử lý&lt;/b&gt; đã dùng khi lập chỉ mục.&lt;br&gt;&lt;br&gt;Khi lập chỉ mục, một cụm từ được lưu thành nhiều token đã chuẩn hoá. Nếu câu truy vấn không qua cùng chuỗi xử lý, hệ thống đi tìm token nguyên bản còn chữ hoa — không tồn tại trong chỉ mục — và trả về kết quả rỗng.&lt;br&gt;&lt;br&gt;Đây là nguyên nhân phổ biến nhất của hiện tượng tìm không ra dù dữ liệu có tồn tại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="9062" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n730" value="&lt;b&gt;Hai kiểu trường dễ nhầm&lt;/b&gt;&lt;br&gt;&lt;code&gt;text&lt;/code&gt; — đi qua chuỗi phân tích, bị tách nhỏ. Dùng cho văn bản tự do, đi với truy vấn dạng so khớp. &lt;b&gt;Không&lt;/b&gt; sắp xếp và tổng hợp trực tiếp được.&lt;br&gt;&lt;code&gt;keyword&lt;/code&gt; — giữ nguyên vẹn thành một token. Dùng cho định danh, mã trạng thái, thẻ phân loại. Sắp xếp và tổng hợp được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="9374" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n731" value="&lt;b&gt;Với tiếng Việt&lt;/b&gt;&lt;br&gt;Bộ tách token tiêu chuẩn cắt theo khoảng trắng nên từ ghép bị tách rời. Hệ quả: truy vấn đảo thứ tự các tiếng vẫn cho kết quả. Cần bổ sung bộ tách từ chuyên biệt nếu yêu cầu độ chính xác cao." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n732" value="F4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n733" value="&lt;b&gt;Dựng chỉ mục ngược&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Inverted index trong bộ đệm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n734" value="&lt;b&gt;Nguyên lý&lt;/b&gt;&lt;br&gt;Thay vì lưu &quot;bản ghi này chứa từ nào&quot;, cấu trúc lưu &lt;b&gt;ngược lại&lt;/b&gt;: &quot;từ này xuất hiện ở những bản ghi nào&quot;.&lt;br&gt;&lt;br&gt;&lt;code&gt;tiền → [1, 2, 3]&lt;/code&gt;&lt;br&gt;&lt;code&gt;cọc&amp;nbsp; → [1, 2]&lt;/code&gt;&lt;br&gt;&lt;br&gt;Truy vấn nhiều từ trở thành phép giao các danh sách, thực hiện hoàn toàn trên chỉ mục mà không đọc dữ liệu gốc." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="8750" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n735" value="&lt;b&gt;Vì sao chi phí không tăng theo lượng dữ liệu&lt;/b&gt;&lt;br&gt;Quét tuần tự có chi phí tỷ lệ với &lt;b&gt;số bản ghi&lt;/b&gt;. Tra cứu trên chỉ mục ngược có chi phí tỷ lệ với &lt;b&gt;số từ khoá khác nhau&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Vốn từ của một ngôn ngữ là hữu hạn nên đại lượng thứ hai gần như bão hoà. Dữ liệu tăng gấp trăm lần nhưng thời gian tra cứu gần như không đổi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="9062" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n736" value="&lt;b&gt;Ghi song song vào nhật ký giao dịch&lt;/b&gt;&lt;br&gt;Cùng lúc với việc dựng cấu trúc trong bộ nhớ, dữ liệu được ghi vào một nhật ký tuần tự &lt;b&gt;xuống đĩa ngay&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Nhờ đó mất điện đột ngột không làm mất phần dữ liệu chưa kịp chuyển thành phân đoạn: khi khởi động lại, hệ thống phát lại nhật ký này." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="9374" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n737" value="&lt;b&gt;Cùng một nguyên lý ba lần&lt;/b&gt;&lt;br&gt;Nhật ký giao dịch ở đây, nhật ký ghi trước của cơ sở dữ liệu quan hệ ở bước 32, và nhật ký phân đoạn của hệ thống truyền thông điệp ở bước E6 — ba tên gọi cho cùng một ý tưởng: ghi ý định trước, áp dụng sau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n738" value="F5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n739" value="&lt;b&gt;Làm mới chỉ mục&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Refresh — chu kỳ mặc định một giây&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n740" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Nội dung trong bộ đệm được đóng gói thành một &lt;b&gt;phân đoạn&lt;/b&gt; mới. Từ thời điểm này dữ liệu mới tìm kiếm được.&lt;br&gt;&lt;br&gt;Phân đoạn nằm ở bộ đệm trang của hệ điều hành, chưa nhất thiết đã ghi xuống đĩa vật lý." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="8750" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n741" value="&lt;b&gt;Hệ quả trực tiếp: ghi xong chưa tìm thấy ngay&lt;/b&gt;&lt;br&gt;Đây &lt;b&gt;không phải lỗi&lt;/b&gt; mà là đặc tính thiết kế, thường gây bất ngờ khi kiểm thử.&lt;br&gt;&lt;br&gt;Ba tuỳ chọn:&lt;br&gt;• Mặc định — trả về ngay, khoảng một giây sau mới tìm được.&lt;br&gt;• Chờ chu kỳ kế tiếp — dùng khi giao diện cần thấy kết quả ngay.&lt;br&gt;• Ép làm mới — &lt;b&gt;chỉ dùng khi viết kiểm thử&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="9054" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n742" value="&lt;b&gt;Vì sao không được ép làm mới ở môi trường vận hành&lt;/b&gt;&lt;br&gt;Mỗi lần làm mới sinh ra &lt;b&gt;một phân đoạn mới&lt;/b&gt;. Ép làm mới sau mỗi thao tác ghi tạo ra hàng nghìn phân đoạn rất nhỏ.&lt;br&gt;&lt;br&gt;Hệ quả: tiến trình hợp nhất chạy liên tục, tiêu tốn toàn bộ tài nguyên đĩa và xử lý; đồng thời mỗi truy vấn phải hỏi từng phân đoạn rồi gộp kết quả nên tốc độ tìm kiếm giảm mạnh." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="9366" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n743" value="&lt;b&gt;Điều chỉnh theo đặc thù&lt;/b&gt;&lt;br&gt;Với chỉ mục dạng nhật ký — ghi rất nhiều, không cần đọc ngay — kéo dài chu kỳ làm mới lên hàng chục giây là cách tăng thông lượng ghi hiệu quả và ít rủi ro nhất." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n744" value="F6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n745" value="&lt;b&gt;Nhân bản sang bản sao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Primary → Replica shard&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n746" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Thao tác ghi được thực hiện trên phân mảnh chính trước, sau đó chuyển tiếp song song tới các phân mảnh bản sao.&lt;br&gt;&lt;br&gt;Yêu cầu chỉ được xác nhận sau khi đủ số bản sao phản hồi theo cấu hình." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="8750" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n747" value="&lt;b&gt;Quy tắc bố trí&lt;/b&gt;&lt;br&gt;Bản sao &lt;b&gt;không bao giờ&lt;/b&gt; được đặt cùng nút với phân mảnh chính tương ứng. Đặt cùng nút thì mất nút là mất cả hai, cơ chế nhân bản trở nên vô nghĩa.&lt;br&gt;&lt;br&gt;Cụm tự động phân bố lại khi có nút gia nhập hoặc rời đi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="9054" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n748" value="&lt;b&gt;Bản sao gánh cả tải đọc&lt;/b&gt;&lt;br&gt;Khác với mô hình chỉ dùng để dự phòng, bản sao ở đây &lt;b&gt;tham gia phục vụ truy vấn&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Do đó tăng số bản sao là cách mở rộng năng lực đọc nhanh nhất — không cần lập chỉ mục lại, không thay đổi cấu trúc, có hiệu lực ngay. Đổi lại là chi phí lưu trữ và tải ghi tăng tương ứng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="9358" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n749" value="&lt;b&gt;Mức nhất quán&lt;/b&gt;&lt;br&gt;Quan hệ giữa phân mảnh chính và bản sao là nhất quán cuối cùng: bản sao có độ trễ so với bản chính.&lt;br&gt;&lt;br&gt;Hai truy vấn liên tiếp có thể rơi vào hai bản khác nhau và cho kết quả lệch nhau trong khoảng thời gian ngắn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="9670" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n750" value="F7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n751" value="&lt;b&gt;Ghi bền vững xuống đĩa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Flush — đồng bộ và xoá nhật ký&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n752" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Phân đoạn được đồng bộ xuống đĩa vật lý, sau đó nhật ký giao dịch tương ứng được xoá vì không còn cần thiết cho việc khôi phục.&lt;br&gt;&lt;br&gt;Kích hoạt khi nhật ký đạt ngưỡng dung lượng hoặc theo chu kỳ thời gian." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="8750" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n753" value="&lt;b&gt;Mức bền vững của nhật ký giao dịch&lt;/b&gt;&lt;br&gt;Mặc định: đồng bộ xuống đĩa sau &lt;b&gt;mỗi&lt;/b&gt; yêu cầu trước khi báo thành công. An toàn nhất, chi phí cao nhất.&lt;br&gt;&lt;br&gt;Chuyển sang chế độ đồng bộ theo chu kỳ giúp tăng thông lượng đáng kể nhưng &lt;b&gt;chấp nhận mất dữ liệu của vài giây cuối&lt;/b&gt; khi có sự cố." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="9054" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n754" value="&lt;b&gt;Nguyên tắc lựa chọn&lt;/b&gt;&lt;br&gt;Chế độ chu kỳ chấp nhận được với dữ liệu nhật ký và chỉ số vận hành — mất vài giây không gây hậu quả.&lt;br&gt;&lt;br&gt;Với dữ liệu nghiệp vụ thì &lt;b&gt;không&lt;/b&gt;. Nhưng ở kiến trúc hiện tại điều này ít quan trọng hơn: chỉ mục là mô hình đọc, mất dữ liệu ở đây luôn khôi phục được bằng cách lập chỉ mục lại từ nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="9366" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n755" value="&lt;b&gt;Phân biệt hai thao tác&lt;/b&gt;&lt;br&gt;Làm mới quyết định &lt;b&gt;khi nào tìm thấy&lt;/b&gt;. Ghi bền vững quyết định &lt;b&gt;khi nào an toàn trước sự cố&lt;/b&gt;. Hai thao tác độc lập, chu kỳ khác nhau, mục đích khác nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n756" value="F8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n757" value="&lt;b&gt;Hợp nhất phân đoạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Merge — thu hồi dung lượng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n758" value="&lt;b&gt;Phân đoạn là bất biến&lt;/b&gt;&lt;br&gt;Đã ghi ra đĩa thì không bao giờ sửa. Hệ quả:&lt;br&gt;&lt;br&gt;• &lt;b&gt;Xoá&lt;/b&gt; — chỉ đánh dấu bản ghi là đã loại bỏ trong một tệp riêng. Dữ liệu vẫn nằm nguyên trên đĩa.&lt;br&gt;• &lt;b&gt;Sửa&lt;/b&gt; — đánh dấu bản cũ đã loại bỏ và ghi bản mới vào phân đoạn khác." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="8750" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n759" value="&lt;b&gt;Vì sao chỉ mục phình to hơn dữ liệu thật&lt;/b&gt;&lt;br&gt;Chỉ mục bị cập nhật thường xuyên tích luỹ rất nhiều bản ghi đã đánh dấu loại bỏ nhưng chưa được dọn.&lt;br&gt;&lt;br&gt;Dung lượng chỉ thực sự thu hồi khi tiến trình hợp nhất chạy và ghi lại phân đoạn mới, bỏ qua các bản đã đánh dấu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="9062" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n760" value="&lt;b&gt;Đổi lại được bốn điều&lt;/b&gt;&lt;br&gt;① Đọc không cần khoá — nhiều luồng truy vấn song song thoải mái.&lt;br&gt;② Bộ đệm luôn hợp lệ — tệp không đổi thì không cần vô hiệu hoá bộ đệm.&lt;br&gt;③ Nén tối ưu — biết trước toàn bộ nội dung khi ghi.&lt;br&gt;④ Bộ đệm trang của hệ điều hành phát huy tối đa với tệp tĩnh." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="9366" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n761" value="&lt;b&gt;Chi phí và cách kiểm soát&lt;/b&gt;&lt;br&gt;Hợp nhất tiêu tốn nhiều tài nguyên đĩa. Với chỉ mục đã ngừng ghi, có thể chủ động gộp về một phân đoạn duy nhất để tối ưu tốc độ đọc.&lt;br&gt;&lt;br&gt;&lt;b&gt;Không&lt;/b&gt; thực hiện thao tác này với chỉ mục đang được ghi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n762" value="F9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n763" value="&lt;b&gt;Truy vấn — pha thu thập&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Query phase&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n764" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Nút điều phối gửi truy vấn tới &lt;b&gt;toàn bộ&lt;/b&gt; phân mảnh liên quan. Mỗi phân mảnh tự tìm kiếm, tự chấm điểm, và chỉ trả về &lt;b&gt;danh sách định danh kèm điểm số&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Nội dung tài liệu chưa được truyền ở pha này nên lượng dữ liệu qua mạng rất nhỏ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="8750" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n765" value="&lt;b&gt;Hai bước chấm điểm&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Lọc ứng viên&lt;/b&gt; — xác định tập tài liệu thoả điều kiện. Mệnh đề dạng lọc không tính điểm nên kết quả được lưu đệm và tái sử dụng.&lt;br&gt;② &lt;b&gt;Tính độ liên quan&lt;/b&gt; — cân nhắc tần suất từ khoá trong tài liệu, độ hiếm của từ khoá trên toàn tập, và độ dài tài liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="9054" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n766" value="&lt;b&gt;Điểm số có thể lệch nhẹ giữa các phân mảnh&lt;/b&gt;&lt;br&gt;Độ hiếm của từ khoá được tính &lt;b&gt;cục bộ trên từng phân mảnh&lt;/b&gt;, không phải trên toàn cụm.&lt;br&gt;&lt;br&gt;Với chỉ mục nhỏ chia nhiều phân mảnh và dữ liệu phân bố không đều, thứ hạng có thể sai lệch. Khắc phục bằng chế độ thu thập thống kê toàn cục trước, đổi lại thêm một vòng truyền tin." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="9366" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n767" value="&lt;b&gt;Bốn mệnh đề của truy vấn tổ hợp&lt;/b&gt;&lt;br&gt;&lt;code&gt;must&lt;/code&gt; — bắt buộc khớp, có tính điểm.&lt;br&gt;&lt;code&gt;filter&lt;/code&gt; — bắt buộc khớp, không tính điểm, được lưu đệm.&lt;br&gt;&lt;code&gt;should&lt;/code&gt; — khớp thì tăng điểm.&lt;br&gt;&lt;code&gt;must_not&lt;/code&gt; — loại trừ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="9678" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n768" value="F10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="8626" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n769" value="&lt;b&gt;Truy vấn — pha lấy nội dung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fetch phase&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="8580" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n770" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Nút điều phối gộp toàn bộ danh sách nhận được, sắp xếp theo điểm số và chọn ra tập kết quả cuối cùng.&lt;br&gt;&lt;br&gt;Sau đó hỏi lại &lt;b&gt;đúng những phân mảnh&lt;/b&gt; chứa các tài liệu được chọn để lấy nội dung đầy đủ, rồi trả về cho bên gọi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="8750" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n771" value="&lt;b&gt;Chi phí phân trang sâu&lt;/b&gt;&lt;br&gt;Để lấy trang thứ một nghìn, &lt;b&gt;mỗi&lt;/b&gt; phân mảnh phải trả về toàn bộ kết quả tính từ đầu tới trang đó.&lt;br&gt;&lt;br&gt;Năm phân mảnh, mỗi phân mảnh trả về hơn mười nghìn bản ghi ⇒ nút điều phối phải xử lý hơn năm mươi nghìn bản ghi trong bộ nhớ chỉ để lấy ra mười dòng. Vì vậy có ngưỡng chặn cứng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="9048" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n772" value="&lt;b&gt;Giải pháp thay thế&lt;/b&gt;&lt;br&gt;&lt;b&gt;Phân trang theo con trỏ&lt;/b&gt; — dùng giá trị sắp xếp của bản ghi cuối trang trước làm điểm bắt đầu. Chi phí không đổi theo độ sâu.&lt;br&gt;&lt;br&gt;Kết hợp với &lt;b&gt;ảnh chụp thời điểm&lt;/b&gt; khi cần bảo đảm tập kết quả nhất quán trong suốt quá trình duyệt, tránh việc dữ liệu mới chèn vào làm lệch trang." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="9372" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n773" value="&lt;b&gt;Chống ghi đè đồng thời&lt;/b&gt;&lt;br&gt;Mỗi tài liệu mang một cặp số phiên bản. Bên ghi gửi kèm giá trị đã đọc; nếu tài liệu đã bị thay đổi trong thời gian đó, yêu cầu bị từ chối để bên gọi tự xử lý.&lt;br&gt;&lt;br&gt;Đây là khoá lạc quan — cùng nguyên lý số thế hệ ở phụ lục E." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="9684" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="e774" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n715" target="n721">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e775" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n721" target="n727">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e776" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n727" target="n733">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e777" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n733" target="n739">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e778" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n739" target="n745">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e779" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n745" target="n751">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e780" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n751" target="n757">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e781" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n757" target="n763">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e782" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n763" target="n769">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n783" value="THAM CHIẾU F · CẤU TRÚC LƯU TRỮ, THUẬT TOÁN CHẤM ĐIỂM VÀ TIÊU CHÍ ÁP DỤNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=10;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="6340" y="8580" width="2700" height="1490" as="geometry" />
        </mxCell>
        <mxCell id="n784" value="Cấu trúc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8626" width="380" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n785" value="Lưu giữ điều gì" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6744" y="8626" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n786" value="Vì sao chọn cấu trúc này" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7444" y="8626" width="1572" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n787" value="Từ điển từ khoá&lt;br&gt;&lt;i&gt;(Finite State Transducer)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8660" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n788" value="Tập toàn bộ từ khoá khác nhau, ánh xạ tới vị trí danh sách bản ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6744" y="8660" width="700" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n789" value="Các từ khoá chia sẻ tiền tố và hậu tố chung được gộp lại thành một đồ thị trạng thái. Nhờ đó toàn bộ từ điển nằm gọn trong bộ nhớ ngay cả với hàng chục triệu từ khoá, và tra cứu chỉ mất thời gian tỷ lệ với độ dài từ chứ không phải số lượng từ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7444" y="8660" width="1572" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n790" value="Danh sách bản ghi&lt;br&gt;&lt;i&gt;(Delta encoding)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8748" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n791" value="Danh sách định danh các bản ghi chứa một từ khoá." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6744" y="8748" width="700" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n792" value="Định danh được sắp tăng dần nên chỉ cần lưu &lt;b&gt;khoảng cách&lt;/b&gt; giữa hai giá trị liên tiếp thay vì giá trị đầy đủ. Khoảng cách là số nhỏ, mã hoá được bằng ít bit hơn nhiều lần." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7444" y="8748" width="1572" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n793" value="Danh sách nhảy cóc&lt;br&gt;&lt;i&gt;(Skip list)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8836" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n794" value="Các điểm mốc rải rác trong danh sách bản ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6744" y="8836" width="700" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n795" value="Khi giao hai danh sách để tìm bản ghi chứa đồng thời nhiều từ khoá, cấu trúc này cho phép bỏ qua từng đoạn dài thay vì duyệt tuần tự — giảm mạnh chi phí của truy vấn nhiều điều kiện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7444" y="8836" width="1572" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n796" value="Bản đồ bit nén&lt;br&gt;&lt;i&gt;(Roaring bitmap)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="8924" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n797" value="Kết quả của các mệnh đề lọc đã thực hiện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6744" y="8924" width="700" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n798" value="Mệnh đề lọc không tính điểm nên kết quả luôn giống nhau với cùng điều kiện. Lưu dưới dạng bản đồ bit nén cho phép tái sử dụng và thực hiện phép giao bằng toán tử bit — nhanh hơn nhiều so với duyệt danh sách." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7444" y="8924" width="1572" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n799" value="Giá trị theo cột&lt;br&gt;&lt;i&gt;(Doc values)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9012" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n800" value="Giá trị các trường, tổ chức theo cột thay vì theo bản ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6744" y="9012" width="700" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n801" value="Chỉ mục ngược trả lời &quot;từ này ở bản ghi nào&quot; nhưng không trả lời được &quot;bản ghi này có giá trị bao nhiêu&quot;. Sắp xếp và tổng hợp cần chiều ngược lại, nên phải có cấu trúc cột riêng. Đây là lý do trường kiểu văn bản tự do không sắp xếp được nếu chưa bật cấu trúc này." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7444" y="9012" width="1572" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n802" value="BA THÀNH PHẦN CỦA ĐIỂM ĐỘ LIÊN QUAN" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#7b5ea7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9120" width="1200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n803" value="Tần suất từ khoá&lt;br&gt;trong tài liệu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9150" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n804" value="Xuất hiện càng nhiều lần thì càng liên quan, nhưng mức tăng &lt;b&gt;giảm dần&lt;/b&gt; — lần thứ hai mươi đóng góp ít hơn nhiều lần thứ hai." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6756" y="9150" width="466" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n805" value="Độ hiếm của từ khoá&lt;br&gt;trên toàn tập" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7254" y="9150" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n806" value="Từ xuất hiện ở hầu hết tài liệu gần như không mang thông tin phân biệt nên trọng số rất thấp. Từ hiếm có trọng số cao." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="7646" y="9150" width="466" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n807" value="Độ dài tài liệu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="8144" y="9150" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n808" value="Cùng số lần xuất hiện, tài liệu ngắn được coi là liên quan hơn tài liệu dài — vì mật độ thông tin cao hơn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="8536" y="9150" width="466" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n809" value="&lt;b&gt;Ý nghĩa thực tiễn.&lt;/b&gt; Ba thành phần trên giải thích vì sao kết quả tìm kiếm không đơn thuần là &quot;khớp hay không khớp&quot;. Hai bản ghi cùng chứa từ khoá vẫn được xếp hạng khác nhau. Khi cần thứ tự xác định tuyệt đối — chẳng hạn danh sách giao dịch theo thời gian — phải chỉ định trường sắp xếp tường minh thay vì dựa vào điểm số mặc định." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9226" width="2652" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n810" value="Phù hợp áp dụng khi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9308" width="1326" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n811" value="Không phù hợp khi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9308" width="1326" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n812" value="Dữ liệu vượt một triệu bản ghi và tiếp tục tăng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9340" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n813" value="Dưới năm trăm nghìn bản ghi — cơ chế toàn văn của cơ sở dữ liệu quan hệ đủ đáp ứng và không phát sinh chi phí vận hành." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9340" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n814" value="Cần tìm kiếm văn bản tự do kèm xếp hạng theo độ liên quan." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9388" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n815" value="Cần tính nguyên tử trên nhiều bản ghi, hoặc cần phép nối nhiều bảng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9388" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n816" value="Cần tổng hợp đa chiều với thời gian phản hồi thấp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9436" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n817" value="Cần đọc thấy dữ liệu ngay lập tức sau khi ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9436" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n818" value="Tỷ lệ đọc áp đảo ghi và chấp nhận độ trễ hiển thị khoảng một giây." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9484" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n819" value="Cần số liệu chính xác tuyệt đối phục vụ đối soát tài chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9484" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n820" value="Có nhân sự vận hành được cụm — điều kiện thường bị bỏ qua nhất." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9532" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n821" value="Chỉ nhằm thay thế bộ nhớ đệm — công cụ chuyên dụng phù hợp và rẻ hơn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7690" y="9532" width="1326" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n822" value="&lt;b&gt;Vấn đề tồn đọng trong mã nguồn hiện tại.&lt;/b&gt;&lt;br&gt;① Thao tác lập chỉ mục đang nằm &lt;b&gt;bên trong&lt;/b&gt; giao dịch của cơ sở dữ liệu — độ trễ hoặc lỗi của chỉ mục kéo dài thời gian giữ khoá và có thể làm huỷ cả giao dịch nghiệp vụ. Cần tách ra ngoài phạm vi giao dịch.&lt;br&gt;② Lỗi khi lập chỉ mục đang bị bỏ qua âm thầm, khiến sai lệch dữ liệu diễn ra mà không có dấu hiệu. Tối thiểu cần ghi nhật ký, đếm chỉ số lỗi và bổ sung tiến trình đối soát định kỳ.&lt;br&gt;③ Điều kiện lọc theo thời gian đang cố định trong mã thay vì nhận tham số từ bên gọi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="9588" width="2652" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n823" value="PHỤ LỤC G · MẠNG CHUYÊN SÂU — ĐỊA CHỈ, PHÂN MẠNG, BIÊN DỊCH ĐỊA CHỈ VÀ KHẢ NĂNG KẾT NỐI THỰC TẾ  (chi tiết hoá bước 3–10 và 17–20)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="10140" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n824" value="G1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n825" value="&lt;b&gt;Phân lớp địa chỉ IPv4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Classful Addressing — nền tảng lịch sử&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n826" value="&lt;b&gt;Bối cảnh&lt;/b&gt;&lt;br&gt;Thời kỳ đầu chưa có khái niệm chia mạng con tuỳ ý. Không gian 4,3 tỷ địa chỉ được chia thành &lt;b&gt;năm lớp cố định&lt;/b&gt;, phân biệt bằng vài bit đầu tiên của octet thứ nhất.&lt;br&gt;&lt;br&gt;Hiểu cách phân lớp giúp nhận ra ngay một địa chỉ thuộc mạng quy mô nào, và vì sao các ranh giới 126, 128, 192 lại xuất hiện." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="10390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n827" value="&lt;b&gt;Cơ chế bit dẫn đầu&lt;/b&gt;&lt;br&gt;Bộ định tuyến thời kỳ đó rất yếu, cần nhận diện lớp tức thì. Giải pháp: khoá cứng các bit đầu làm cờ hiệu.&lt;br&gt;&lt;br&gt;&lt;code&gt;0…&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Lớp A → 0–127&lt;/code&gt;&lt;br&gt;&lt;code&gt;10…&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Lớp B → 128–191&lt;/code&gt;&lt;br&gt;&lt;code&gt;110…&amp;nbsp;&amp;nbsp;→ Lớp C → 192–223&lt;/code&gt;&lt;br&gt;&lt;code&gt;1110…&amp;nbsp;→ Lớp D → 224–239&lt;/code&gt;&lt;br&gt;&lt;code&gt;1111…&amp;nbsp;→ Lớp E → 240–255&lt;/code&gt;&lt;br&gt;&lt;br&gt;Chính quy tắc khoá bit này sinh ra các ranh giới thập phân, không phải quy ước tuỳ ý." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="10702" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n828" value="&lt;b&gt;Hai dải bị tách riêng&lt;/b&gt;&lt;br&gt;&lt;code&gt;127.x.x.x&lt;/code&gt; — địa chỉ vòng lặp nội bộ, dùng để tiến trình tự gọi chính máy đang chạy. Không bao giờ rời khỏi máy, nên bị loại khỏi lớp A dù nằm trong khoảng bit.&lt;br&gt;&lt;br&gt;&lt;code&gt;255.255.255.255&lt;/code&gt; — địa chỉ quảng bá giới hạn, gửi tới toàn bộ thiết bị trong cùng mạng cục bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="11026" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n829" value="&lt;b&gt;Nhầm lẫn phổ biến: lớp địa chỉ ≠ địa chỉ riêng&lt;/b&gt;&lt;br&gt;Lớp A trải từ 1 đến 126, nhưng chỉ &lt;b&gt;một dải duy nhất&lt;/b&gt; trong đó là &lt;code&gt;10.0.0.0/8&lt;/code&gt; được dành làm địa chỉ riêng.&lt;br&gt;&lt;br&gt;Toàn bộ phần còn lại của lớp A là địa chỉ công cộng có chủ sở hữu. Tương tự, lớp B chỉ tách &lt;code&gt;172.16.0.0/12&lt;/code&gt; và lớp C chỉ tách &lt;code&gt;192.168.0.0/16&lt;/code&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="11324" width="480" height="274" as="geometry" />
        </mxCell>
        <mxCell id="n830" value="G2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n831" value="&lt;b&gt;Mặt nạ mạng và ký hiệu CIDR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tách phần mạng khỏi phần máy trạm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n832" value="&lt;b&gt;Nhiệm vụ duy nhất của mặt nạ mạng&lt;/b&gt;&lt;br&gt;Chia địa chỉ 32 bit thành hai phần: &lt;b&gt;phần mạng&lt;/b&gt; và &lt;b&gt;phần máy trạm&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Ký hiệu &lt;code&gt;/24&lt;/code&gt; nghĩa là 24 bit đầu thuộc phần mạng. Dạng thập phân tương đương là &lt;code&gt;255.255.255.0&lt;/code&gt;: giá trị 255 nghĩa là khoá lại làm phần mạng, giá trị 0 nghĩa là để tự do làm phần máy trạm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="10390" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n833" value="&lt;b&gt;Vì sao phép AND cho ra địa chỉ mạng&lt;/b&gt;&lt;br&gt;Phép AND nhị phân quy định &lt;code&gt;1 AND 1 = 1&lt;/code&gt;, mọi trường hợp còn lại bằng 0.&lt;br&gt;&lt;br&gt;Giá trị 255 là &lt;code&gt;11111111&lt;/code&gt; — AND với bất kỳ số nào cũng giữ nguyên số đó.&lt;br&gt;Giá trị 0 là &lt;code&gt;00000000&lt;/code&gt; — AND với số 5 là &lt;code&gt;00000101&lt;/code&gt; cho ra 0.&lt;br&gt;&lt;br&gt;Kết quả: phần bị khoá được giữ lại, phần tự do bị triệt tiêu về 0. Đó chính là địa chỉ mạng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="10694" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n834" value="&lt;b&gt;Đánh đổi giữa hai phần&lt;/b&gt;&lt;br&gt;Tổng luôn là 32 bit. Lấy nhiều bit cho phần mạng thì còn ít bit cho máy trạm.&lt;br&gt;&lt;br&gt;Số địa chỉ dùng được là &lt;code&gt;2ⁿ − 2&lt;/code&gt; với n là số bit phần máy trạm. Trừ hai vì địa chỉ đầu dải dành cho tên mạng và địa chỉ cuối dải dành cho lệnh quảng bá.&lt;br&gt;&lt;br&gt;&lt;code&gt;/24&lt;/code&gt; ⇒ 2⁸ − 2 = &lt;b&gt;254&lt;/b&gt; địa chỉ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="11018" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n835" value="&lt;b&gt;Ví dụ quy hoạch thực tế&lt;/b&gt;&lt;br&gt;Hệ thống cần cấp địa chỉ cho 1.000 thiết bị. Dải &lt;code&gt;/24&lt;/code&gt; chỉ có 254 địa chỉ — không đủ.&lt;br&gt;&lt;br&gt;Mượn thêm hai bit từ phần mạng sang phần máy trạm được dải &lt;code&gt;/22&lt;/code&gt;: 2¹⁰ − 2 = &lt;b&gt;1.022&lt;/b&gt; địa chỉ, đáp ứng được yêu cầu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="11330" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n836" value="G3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n837" value="&lt;b&gt;Vì sao không dùng một dải cực lớn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ba lý do bắt buộc phải chia nhỏ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n838" value="&lt;b&gt;① Bão quảng bá&lt;/b&gt;&lt;br&gt;Giao thức phân giải địa chỉ ở lớp 2 hoạt động bằng cách phát tin tới &lt;b&gt;toàn bộ&lt;/b&gt; thiết bị trong cùng mạng.&lt;br&gt;&lt;br&gt;Đặt hàng triệu thiết bị vào chung một mạng thì chỉ cần một phần nhỏ trong số đó cùng phát yêu cầu phân giải là toàn bộ băng thông và năng lực xử lý của thiết bị chuyển mạch bị chiếm dụng để xử lý tin quảng bá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="10390" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n839" value="&lt;b&gt;② Không có ranh giới kiểm soát&lt;/b&gt;&lt;br&gt;Trong cùng một mạng, các máy nói chuyện trực tiếp qua thiết bị chuyển mạch, &lt;b&gt;không đi qua thiết bị định tuyến&lt;/b&gt; nên không có điểm nào để đặt luật kiểm soát.&lt;br&gt;&lt;br&gt;Đặt máy chủ dữ liệu, máy trạm nghiệp vụ và mạng khách chung một dải thì một máy bị chiếm quyền có thể quét và lan sang máy chủ ngay lập tức." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="10714" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n840" value="&lt;b&gt;③ Giới hạn phần cứng&lt;/b&gt;&lt;br&gt;Thiết bị chuyển mạch lưu bảng địa chỉ phần cứng trong bộ nhớ tốc độ cao dung lượng hữu hạn.&lt;br&gt;&lt;br&gt;Vượt quá dung lượng, thiết bị không còn tra cứu được và chuyển sang chế độ phát ra mọi cổng — mất toàn bộ lợi ích của việc chuyển mạch." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="11038" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n841" value="&lt;b&gt;Kết luận quy hoạch&lt;/b&gt;&lt;br&gt;Chia nhỏ thành nhiều mạng con là biện pháp &lt;b&gt;bắt buộc&lt;/b&gt;, không phải tuỳ chọn tối ưu.&lt;br&gt;&lt;br&gt;Muốn đi từ mạng con này sang mạng con khác phải qua thiết bị định tuyến — và đó chính là nơi đặt được luật kiểm soát truy cập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="11342" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n842" value="G4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n843" value="&lt;b&gt;Ba bảng tra cứu khác nhau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MAC · ARP · Routing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n844" value="&lt;b&gt;Bảng địa chỉ phần cứng&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nằm ở:&lt;/b&gt; thiết bị chuyển mạch (lớp 2).&lt;br&gt;&lt;b&gt;Ánh xạ:&lt;/b&gt; cổng vật lý ↔ địa chỉ phần cứng.&lt;br&gt;&lt;b&gt;Cách xây dựng:&lt;/b&gt; học thụ động — khung đi vào cổng nào thì địa chỉ nguồn của khung đó được gắn với cổng ấy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Không chứa địa chỉ IP.&lt;/b&gt; Thiết bị chuyển mạch hoàn toàn không đọc được lớp 3." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="10390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n845" value="&lt;b&gt;Bảng phân giải địa chỉ&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nằm ở:&lt;/b&gt; máy trạm và thiết bị định tuyến.&lt;br&gt;&lt;b&gt;Ánh xạ:&lt;/b&gt; địa chỉ IP ↔ địa chỉ phần cứng.&lt;br&gt;&lt;b&gt;Cách xây dựng:&lt;/b&gt; phát yêu cầu quảng bá khi chưa có mục cần tìm; mục có thời hạn và bị xoá sau đó.&lt;br&gt;&lt;br&gt;Đây là cầu nối duy nhất giữa lớp 3 và lớp 2 trong cùng một mạng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="10702" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n846" value="&lt;b&gt;Bảng định tuyến&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nằm ở:&lt;/b&gt; thiết bị định tuyến và cả máy trạm.&lt;br&gt;&lt;b&gt;Ánh xạ:&lt;/b&gt; dải địa chỉ đích → chặng kế tiếp.&lt;br&gt;&lt;b&gt;Nguyên tắc so khớp:&lt;/b&gt; tiền tố dài nhất khớp trước — luật cụ thể hơn luôn được ưu tiên hơn luật tổng quát.&lt;br&gt;&lt;br&gt;Đây là bảng quyết định gói tin đi đâu ở phạm vi liên mạng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="11014" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n847" value="&lt;b&gt;Điểm hay nhầm&lt;/b&gt;&lt;br&gt;Ba bảng này thường bị gộp làm một khi chẩn đoán sự cố.&lt;br&gt;&lt;br&gt;Máy không tới được đích trong cùng mạng ⇒ nghi bảng phân giải địa chỉ. Không tới được mạng khác ⇒ nghi bảng định tuyến. Lưu lượng đi sai cổng vật lý ⇒ nghi bảng địa chỉ phần cứng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="11326" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n848" value="G5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n849" value="&lt;b&gt;Ranh giới quảng bá và định tuyến&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Khi nào qua Switch, khi nào qua Router&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n850" value="&lt;b&gt;Quy trình quyết định tại máy nguồn&lt;/b&gt;&lt;br&gt;Với mỗi gói tin, hệ điều hành thực hiện phép AND &lt;b&gt;hai lần&lt;/b&gt;:&lt;br&gt;&lt;br&gt;① Địa chỉ &lt;b&gt;đích&lt;/b&gt; AND mặt nạ mạng.&lt;br&gt;② Địa chỉ &lt;b&gt;của chính giao diện&lt;/b&gt; AND mặt nạ mạng.&lt;br&gt;&lt;br&gt;Hai kết quả bằng nhau ⇒ đích nằm trong cùng mạng. Khác nhau ⇒ đích nằm ngoài." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="10390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n851" value="&lt;b&gt;Trường hợp cùng mạng&lt;/b&gt;&lt;br&gt;Ví dụ nguồn &lt;code&gt;192.168.1.5/24&lt;/code&gt;, đích &lt;code&gt;192.168.1.10&lt;/code&gt;.&lt;br&gt;&lt;code&gt;192.168.1.10 AND 255.255.255.0 = 192.168.1.0&lt;/code&gt;&lt;br&gt;&lt;code&gt;192.168.1.5&amp;nbsp; AND 255.255.255.0 = 192.168.1.0&lt;/code&gt;&lt;br&gt;Trùng nhau ⇒ tra bảng phân giải địa chỉ lấy địa chỉ phần cứng của đích và gửi thẳng qua thiết bị chuyển mạch. &lt;b&gt;Không có thiết bị lớp 3 nào tham gia.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="10702" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n852" value="&lt;b&gt;Trường hợp khác mạng&lt;/b&gt;&lt;br&gt;Cùng nguồn, đích &lt;code&gt;8.8.8.8&lt;/code&gt;.&lt;br&gt;&lt;code&gt;8.8.8.8 AND 255.255.255.0 = 8.8.8.0&lt;/code&gt;&lt;br&gt;Khác với &lt;code&gt;192.168.1.0&lt;/code&gt; ⇒ đích nằm ngoài.&lt;br&gt;&lt;br&gt;Máy trạm lấy địa chỉ phần cứng của &lt;b&gt;cổng mặc định&lt;/b&gt; chứ không phải của đích, đóng khung và gửi đi. Địa chỉ IP đích trong gói tin vẫn giữ nguyên là &lt;code&gt;8.8.8.8&lt;/code&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="11014" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n853" value="&lt;b&gt;Hệ quả cần nhớ&lt;/b&gt;&lt;br&gt;Địa chỉ phần cứng đích trong khung tin và địa chỉ IP đích trong gói tin &lt;b&gt;thường không trỏ về cùng một thiết bị&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Đây là điểm khiến người mới đọc gói tin bắt được thường hiểu sai đường đi thực tế." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="11326" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n854" value="G6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n855" value="&lt;b&gt;Bốn hình thái biên dịch địa chỉ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SNAT · DNAT · PAT · ánh xạ một–một&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n856" value="&lt;b&gt;Biên dịch địa chỉ nguồn&lt;/b&gt;&lt;br&gt;Thay đổi địa chỉ &lt;b&gt;nguồn&lt;/b&gt; của gói tin đi ra. Dùng khi nhiều thiết bị dùng địa chỉ riêng cần ra mạng công cộng.&lt;br&gt;&lt;br&gt;Đây là hình thái ở bước 8 tại thiết bị biên của mạng cục bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="10390" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n857" value="&lt;b&gt;Biên dịch địa chỉ đích&lt;/b&gt;&lt;br&gt;Thay đổi địa chỉ &lt;b&gt;đích&lt;/b&gt; của gói tin đi vào. Dùng khi cần chuyển tiếp lưu lượng từ ngoài vào một máy nội bộ cụ thể.&lt;br&gt;&lt;br&gt;Đây là hình thái ở bước 17 tại cổng kết nối của mạng riêng ảo." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="10694" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n858" value="&lt;b&gt;Biên dịch kèm cổng&lt;/b&gt;&lt;br&gt;Thay đổi &lt;b&gt;đồng thời&lt;/b&gt; địa chỉ và số cổng, cho phép &lt;b&gt;nhiều&lt;/b&gt; thiết bị dùng chung &lt;b&gt;một&lt;/b&gt; địa chỉ công cộng.&lt;br&gt;&lt;br&gt;Số cổng đóng vai trò khoá phân biệt phiên. Đây là hình thái của thiết bị định tuyến gia đình và của cổng biên dịch địa chỉ trên hạ tầng đám mây.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đặc điểm quan trọng:&lt;/b&gt; có trạng thái — phải duy trì bảng phiên để trả hàng đúng nơi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="10998" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n859" value="&lt;b&gt;Ánh xạ một–một&lt;/b&gt;&lt;br&gt;Mỗi địa chỉ công cộng gắn cứng với &lt;b&gt;đúng một&lt;/b&gt; địa chỉ riêng, không đụng tới số cổng.&lt;br&gt;&lt;br&gt;Đây là hình thái của cổng kết nối Internet trên hạ tầng đám mây — và là chìa khoá để hiểu bước G8." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="11322" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n860" value="G7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n861" value="&lt;b&gt;Hai loại cổng ra khác nhau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Internet Gateway ≠ NAT Gateway&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n862" value="&lt;b&gt;Cổng kết nối Internet&lt;/b&gt;&lt;br&gt;Thực hiện &lt;b&gt;ánh xạ một–một&lt;/b&gt; giữa địa chỉ công cộng và địa chỉ riêng của cùng một giao diện mạng.&lt;br&gt;&lt;br&gt;• Hoạt động &lt;b&gt;hai chiều&lt;/b&gt;: cho phép cả kết nối đi ra và kết nối khởi tạo từ ngoài vào.&lt;br&gt;• &lt;b&gt;Không&lt;/b&gt; giữ trạng thái phiên, vì ánh xạ là cố định.&lt;br&gt;• Bản thân nó không tính cước và không có giới hạn băng thông riêng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="10390" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n863" value="&lt;b&gt;Cổng biên dịch địa chỉ&lt;/b&gt;&lt;br&gt;Thực hiện &lt;b&gt;biên dịch kèm cổng&lt;/b&gt;: nhiều máy dùng chung một địa chỉ công cộng của chính cổng này.&lt;br&gt;&lt;br&gt;• Hoạt động &lt;b&gt;một chiều&lt;/b&gt;: chỉ cho phép kết nối khởi tạo từ trong ra.&lt;br&gt;• &lt;b&gt;Có&lt;/b&gt; giữ bảng phiên.&lt;br&gt;• Là tài nguyên riêng, tính cước theo thời gian tồn tại và lưu lượng đi qua." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="10714" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n864" value="&lt;b&gt;Điểm khác biệt quyết định&lt;/b&gt;&lt;br&gt;Cổng kết nối Internet &lt;b&gt;không thể&lt;/b&gt; phục vụ một máy không có địa chỉ công cộng, vì không có gì để ánh xạ.&lt;br&gt;&lt;br&gt;Cổng biên dịch địa chỉ thì ngược lại: nó dùng địa chỉ công cộng &lt;b&gt;của chính nó&lt;/b&gt;, nên máy phía sau chỉ cần địa chỉ riêng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="11038" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n865" value="&lt;b&gt;Hệ quả về vị trí đặt&lt;/b&gt;&lt;br&gt;Cổng biên dịch địa chỉ bắt buộc phải đặt trong mạng con công khai và phải có địa chỉ công cộng gắn vào nó.&lt;br&gt;&lt;br&gt;Đặt nhầm vào mạng con riêng tư là lỗi cấu hình phổ biến: khi đó chính cổng này cũng không có đường ra." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="11342" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n866" value="G8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n867" value="&lt;b&gt;Máy trong mạng công khai không có địa chỉ công cộng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vì sao vẫn thấy mạng nhưng không ra được Internet&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n868" value="&lt;b&gt;Vì sao vẫn thấy mạng&lt;/b&gt;&lt;br&gt;Bảng định tuyến của mọi mạng con &lt;b&gt;luôn&lt;/b&gt; chứa luật mặc định không xoá được:&lt;br&gt;&lt;br&gt;&lt;code&gt;10.0.0.0/16 → local&lt;/code&gt;&lt;br&gt;&lt;br&gt;Luật này hoàn toàn &lt;b&gt;không liên quan&lt;/b&gt; tới địa chỉ công cộng. Nhờ nó, máy vẫn:&lt;br&gt;• Gọi được mọi máy khác trong cùng mạng riêng ảo, kể cả ở vùng sẵn sàng khác.&lt;br&gt;• Được các máy khác gọi tới.&lt;br&gt;• Phân giải tên miền qua bộ phân giải nội bộ.&lt;br&gt;• Truy cập dịch vụ siêu dữ liệu ở địa chỉ liên kết cục bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="10390" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n869" value="&lt;b&gt;Vì sao không ra được Internet&lt;/b&gt;&lt;br&gt;Luật &lt;code&gt;0.0.0.0/0 → cổng kết nối Internet&lt;/code&gt; vẫn tồn tại, gói tin vẫn được chuyển tới cổng đó. Nhưng cổng này chỉ làm &lt;b&gt;ánh xạ một–một&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Máy không có địa chỉ công cộng ⇒ &lt;b&gt;không tồn tại mục ánh xạ nào&lt;/b&gt; ⇒ cổng không thể ghi đè địa chỉ nguồn ⇒ gói tin bị huỷ tại đây.&lt;br&gt;&lt;br&gt;Kể cả nếu gói tin đi được, phía nhận cũng không có đường trả về một địa chỉ riêng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="10714" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n870" value="&lt;b&gt;Vì sao dễ chẩn đoán nhầm&lt;/b&gt;&lt;br&gt;Mọi phép thử trong phạm vi nội bộ đều thành công: gọi được máy khác, phân giải được tên miền, thấy giao diện mạng có địa chỉ hợp lệ.&lt;br&gt;&lt;br&gt;Chỉ khi thử tải gói phần mềm hoặc gọi dịch vụ bên ngoài mới phát hiện lỗi — và triệu chứng là &lt;b&gt;hết thời gian chờ&lt;/b&gt; chứ không phải báo lỗi rõ ràng, vì gói tin bị huỷ âm thầm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="11038" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n871" value="&lt;b&gt;Trạng thái xấu nhất trong các tổ hợp&lt;/b&gt;&lt;br&gt;Máy này còn kém hơn máy đặt trong mạng con riêng tư đúng chuẩn: mạng riêng tư ít nhất còn định tuyến ra cổng biên dịch địa chỉ nên vẫn tải được bản vá.&lt;br&gt;&lt;br&gt;Ở đây thì không có đường nào cả." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="11350" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n872" value="G9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n873" value="&lt;b&gt;Các đường ra không cần địa chỉ công cộng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Điểm cuối mạng riêng ảo&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n874" value="&lt;b&gt;Điểm cuối dạng cổng&lt;/b&gt;&lt;br&gt;Bổ sung một luật vào bảng định tuyến trỏ dải địa chỉ của dịch vụ đích qua đường nội bộ, &lt;b&gt;không&lt;/b&gt; đi qua cổng kết nối Internet.&lt;br&gt;&lt;br&gt;Vì luật này cụ thể hơn &lt;code&gt;0.0.0.0/0&lt;/code&gt; nên được ưu tiên theo nguyên tắc tiền tố dài nhất. Máy không có địa chỉ công cộng vẫn dùng được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="10390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n875" value="&lt;b&gt;Điểm cuối dạng giao diện&lt;/b&gt;&lt;br&gt;Tạo một giao diện mạng mang &lt;b&gt;địa chỉ riêng&lt;/b&gt; ngay trong mạng con, đại diện cho dịch vụ bên ngoài.&lt;br&gt;&lt;br&gt;Lưu lượng tới dịch vụ đó trở thành lưu lượng nội bộ thuần tuý. Đây là cách cho phép quản trị máy chủ từ xa mà không cần mở bất kỳ cổng nào ra Internet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="10702" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n876" value="&lt;b&gt;Hai địa chỉ luôn sẵn dùng&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Bộ phân giải tên miền nội bộ&lt;/b&gt; — nằm ở địa chỉ thứ hai trong dải của mạng riêng ảo. Luôn truy cập được bằng địa chỉ riêng.&lt;br&gt;• &lt;b&gt;Dịch vụ siêu dữ liệu&lt;/b&gt; — nằm ở dải địa chỉ liên kết cục bộ, cung cấp thông tin về chính máy đang chạy và thông tin xác thực tạm thời." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="11014" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n877" value="&lt;b&gt;Ý nghĩa với thiết kế&lt;/b&gt;&lt;br&gt;Kết hợp mạng con riêng tư với các điểm cuối cho phép xây dựng hạ tầng &lt;b&gt;không có bất kỳ đường ra Internet nào&lt;/b&gt; mà vẫn vận hành và quản trị được đầy đủ.&lt;br&gt;&lt;br&gt;Đây là mô hình chuẩn cho hệ thống xử lý dữ liệu nhạy cảm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="11318" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n878" value="G10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="10266" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n879" value="&lt;b&gt;Địa chỉ thế hệ mới&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IPv6 và cổng chỉ cho chiều ra&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="10220" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n880" value="&lt;b&gt;Khác biệt căn bản&lt;/b&gt;&lt;br&gt;Không gian địa chỉ đủ lớn để mọi thiết bị đều có địa chỉ định tuyến toàn cầu.&lt;br&gt;&lt;br&gt;Hệ quả: &lt;b&gt;không còn nhu cầu biên dịch địa chỉ&lt;/b&gt; để tiết kiệm địa chỉ. Toàn bộ cơ chế ở bước 8 và bước 17 trở nên không cần thiết." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="10390" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n881" value="&lt;b&gt;Nhưng mất luôn lớp bảo vệ ngẫu nhiên&lt;/b&gt;&lt;br&gt;Trong mô hình cũ, việc không có địa chỉ công cộng &lt;b&gt;tự nó&lt;/b&gt; đã ngăn kết nối từ ngoài vào — một lớp bảo vệ có được mà không cần cấu hình.&lt;br&gt;&lt;br&gt;Với địa chỉ thế hệ mới, mọi máy đều có thể tiếp cận từ Internet. Việc kiểm soát &lt;b&gt;hoàn toàn&lt;/b&gt; phụ thuộc vào luật tường lửa. Cấu hình thiếu sót lập tức phơi bày dịch vụ ra ngoài." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="10702" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n882" value="&lt;b&gt;Cổng chỉ cho chiều ra&lt;/b&gt;&lt;br&gt;Để giữ lại tính chất một chiều, hạ tầng đám mây cung cấp một loại cổng riêng: cho phép khởi tạo kết nối từ trong ra nhưng chặn kết nối khởi tạo từ ngoài vào.&lt;br&gt;&lt;br&gt;Đây là thành phần tương đương với cổng biên dịch địa chỉ, nhưng không thực hiện biên dịch — chỉ lọc theo chiều." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="11026" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n883" value="&lt;b&gt;Trạng thái áp dụng&lt;/b&gt;&lt;br&gt;Hệ thống hiện chỉ dùng địa chỉ thế hệ cũ. Ghi lại nội dung này để khi mở rộng có sẵn cơ sở đối chiếu, đặc biệt ở điểm dễ sai nhất: giả định rằng không có địa chỉ công cộng thì an toàn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="11330" width="480" height="268" as="geometry" />
        </mxCell>
