        <mxCell id="n531" value="Tầng nghiệp vụ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5364" width="220" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n532" value="Cơ sở dữ liệu&lt;br&gt;quan hệ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6664" y="5346" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n533" value="Elasticsearch" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6924" y="5346" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n534" value="Truy vấn đọc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7174" y="5364" width="220" height="54" as="geometry" />
        </mxCell>
        <mxCell id="e535" value="ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=11;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n531" target="n532">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e536" value="đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=1;fontSize=11;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n532" target="n533">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e537" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=11;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n533" target="n534">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n538" value="&lt;b&gt;Nguồn sự thật&lt;/b&gt;&lt;br&gt;Bảo đảm tính nguyên tử và ràng buộc toàn vẹn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6664" y="5450" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n539" value="&lt;b&gt;Mô hình đọc&lt;/b&gt;&lt;br&gt;Tái tạo lại được từ nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6924" y="5450" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n540" value="&lt;b&gt;Tiêu chí kiểm tra kiến trúc.&lt;/b&gt; Mất toàn bộ cụm chỉ mục phải là sự cố khắc phục được bằng lập chỉ mục lại từ cơ sở dữ liệu, không mất bản ghi nghiệp vụ nào. Nếu điều kiện này không thoả mãn, dữ liệu nghiệp vụ đang nằm sai vị trí.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ngoại lệ duy nhất&lt;/b&gt; là hệ thống nhật ký và chỉ số vận hành thuần tuý, nơi chỉ mục chính là kho lưu trữ và việc mất dữ liệu cũ được chấp nhận.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao không dùng cơ chế toàn văn của cơ sở dữ liệu quan hệ.&lt;/b&gt; Ở quy mô nhỏ thì nên dùng vì không phát sinh chi phí vận hành. Hạn chế xuất hiện khi dữ liệu lớn: không mở rộng theo chiều ngang, thuật toán xếp hạng đơn giản hơn, và quan trọng nhất là chia sẻ tài nguyên với đường ghi — một truy vấn tìm kiếm nặng sẽ tranh chấp tài nguyên với giao dịch nghiệp vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="7434" y="5346" width="1582" height="176" as="geometry" />
        </mxCell>
        <mxCell id="n541" value="Chiến lược đồng bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5546" width="340" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n542" value="Cơ chế" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6704" y="5546" width="1140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n543" value="Đánh giá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7844" y="5546" width="1172" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n544" value="Ghi song song" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5578" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n545" value="Ghi lần lượt vào cơ sở dữ liệu rồi vào chỉ mục, trong hai thao tác độc lập." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="5578" width="1140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n546" value="&lt;b&gt;Đang áp dụng.&lt;/b&gt; Đơn giản nhưng không nguyên tử: thao tác thứ hai thất bại thì dữ liệu lệch vĩnh viễn và không có cơ chế phát hiện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7844" y="5578" width="1172" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n547" value="Transactional Outbox" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5640" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n548" value="Ghi dữ liệu và bản ghi sự kiện trong &lt;b&gt;cùng một giao dịch&lt;/b&gt;; tiến trình nền đọc bảng sự kiện và đẩy sang chỉ mục." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="5640" width="1140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n549" value="Không mất sự kiện, cho phép thử lại. Hạ tầng cần thiết đã có sẵn trong kho mã. &lt;b&gt;Là hướng chuẩn hoá được khuyến nghị.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7844" y="5640" width="1172" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n550" value="Change Data Capture" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5702" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n551" value="Đọc trực tiếp nhật ký thay đổi của cơ sở dữ liệu và chuyển thành luồng sự kiện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="5702" width="1140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n552" value="Tầng nghiệp vụ không cần biết tới sự tồn tại của chỉ mục, bắt được cả thay đổi thực hiện ngoài ứng dụng. Chi phí vận hành cao." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7844" y="5702" width="1172" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n553" value="Lập chỉ mục lại định kỳ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5764" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n554" value="Tiến trình theo lịch quét toàn bộ dữ liệu và ghi lại vào chỉ mục." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6704" y="5764" width="1140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n555" value="Đơn giản và tự khắc phục mọi sai lệch, nhưng độ trễ lớn. Phù hợp làm lớp đối soát bổ sung cho phương án chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7844" y="5764" width="1172" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n556" value="BẢNG CỔNG DỊCH VỤ TOÀN HỆ THỐNG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a5b6a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5836" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n557" value="22" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6364" y="5868" width="110" height="30" as="geometry" />
