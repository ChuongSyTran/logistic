        <mxCell id="n271" value="Tài nguyên tại đây có đồng thời địa chỉ riêng và địa chỉ công cộng, nhận được kết nối khởi tạo từ Internet nếu lớp kiểm soát cho phép." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
