        <mxCell id="n435" value="&lt;code&gt;internal/di&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7594" y="3962" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n436" value="Điểm lắp ráp toàn bộ đối tượng: mở nhóm kết nối, tiêm phụ thuộc, gắn thư viện đo lường. Nên đọc đầu tiên khi tiếp cận mã nguồn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7894" y="3962" width="1122" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n437" value="&lt;code&gt;internal/entity&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7594" y="4006" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n438" value="Thực thể nghiệp vụ thuần tuý, không gắn nhãn phục vụ tuần tự hoá hay ánh xạ dữ liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7894" y="4006" width="1122" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n439" value="&lt;code&gt;internal/conf&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="7594" y="4050" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n440" value="Đọc cấu hình từ biến môi trường. Không có giá trị nào được gán cứng trong mã." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
