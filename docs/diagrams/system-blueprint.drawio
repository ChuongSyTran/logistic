          <mxGeometry x="114" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n333" value="&lt;b&gt;Nhân hệ điều hành tháo lớp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Giải mã đóng gói ngược&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n334" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Quá trình đóng gói ở bước 3–5 được thực hiện ngược lại:&lt;br&gt;&lt;br&gt;① Card mạng nhận tín hiệu, dựng lại khung. Địa chỉ MAC đích khớp ⇒ tháo lớp 2.&lt;br&gt;② Đọc gói tin lớp 3. Địa chỉ đích khớp &lt;code&gt;10.0.1.20&lt;/code&gt; ⇒ tháo lớp 3.&lt;br&gt;③ Đọc đoạn lớp 4, thấy cổng đích 443 ⇒ chuyển tải trọng cho tiến trình đang lắng nghe cổng đó." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="3830" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n335" value="&lt;b&gt;Cơ chế phân phối theo cổng&lt;/b&gt;&lt;br&gt;Nhân hệ điều hành duy trì bảng ánh xạ giữa cổng và tiến trình. Không có tiến trình nào lắng nghe cổng đích thì gói tin bị từ chối ngay — biểu hiện là lỗi kết nối bị khước từ.&lt;br&gt;&lt;br&gt;Đây là điểm khác biệt so với việc bị tường lửa chặn: khi đó không có phản hồi nào và bên gọi chỉ thấy hết thời gian chờ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="4142" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n336" value="&lt;b&gt;Ranh giới lắng nghe cần khai báo có chủ đích&lt;/b&gt;&lt;br&gt;&lt;code&gt;listen 127.0.0.1&lt;/code&gt; — chỉ nhận kết nối từ chính máy đó.&lt;br&gt;&lt;code&gt;listen 0.0.0.0&lt;/code&gt; — nhận kết nối từ toàn bộ mạng nội bộ.&lt;br&gt;&lt;br&gt;Cấu hình sai ở đây khiến dịch vụ hoặc không truy cập được, hoặc lộ ra phạm vi rộng hơn dự kiến." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="4422" width="480" height="276" as="geometry" />
        </mxCell>
        <mxCell id="n337" value="&lt;b&gt;Bối cảnh ảo hoá&lt;/b&gt;&lt;br&gt;Giao diện mạng này là giao diện ảo do lớp ảo hoá cấp phát, không phải card mạng vật lý. Chi tiết cơ chế cách ly xem phụ lục C." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="4710" width="480" height="216" as="geometry" />
        </mxCell>
        <mxCell id="n338" value="22" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n339" value="&lt;b&gt;Máy chủ web giải mã TLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nginx cổng 443&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n340" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Máy chủ web hoàn tất bắt tay TLS của &lt;b&gt;phiên thứ hai&lt;/b&gt; — phiên giữa mạng biên và hạ tầng gốc — bằng chứng thư riêng được cấu hình sẵn.&lt;br&gt;&lt;br&gt;Sau đó tải trọng được giải mã trở lại thành yêu cầu HTTP dạng văn bản có cấu trúc." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="3830" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n341" value="&lt;b&gt;Chuyển hướng bắt buộc sang kênh mã hoá&lt;/b&gt;&lt;br&gt;Cổng 80 được cấu hình trả về mã chuyển hướng vĩnh viễn sang cổng 443.&lt;br&gt;&lt;br&gt;Nhờ đó không tồn tại đường truy cập không mã hoá, kể cả khi bên gọi chủ động dùng giao thức cũ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="4128" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n342" value="&lt;b&gt;Sự cố thường gặp ở môi trường phát triển&lt;/b&gt;&lt;br&gt;Chứng thư tự ký khiến trình duyệt chặn yêu cầu và hiển thị thông báo lỗi mạng chung chung, rất dễ bị hiểu nhầm thành lỗi chính sách chia sẻ tài nguyên giữa các nguồn gốc.&lt;br&gt;&lt;br&gt;Hai vấn đề này hoàn toàn độc lập: một thuộc tầng mạng, một thuộc chính sách của trình duyệt." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="4408" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n343" value="&lt;b&gt;Cấu hình liên quan&lt;/b&gt;&lt;br&gt;Phiên bản giao thức được giới hạn ở TLS 1.2 và 1.3; các bộ thuật toán yếu bị loại bỏ khỏi danh sách thoả thuận." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="4698" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n344" value="23" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n345" value="&lt;b&gt;Chuyển tiếp tới tầng ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reverse proxy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n346" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Máy chủ web bổ sung các tiêu đề mang thông tin nguồn rồi chuyển tiếp yêu cầu tới cổng nội bộ 8080:&lt;br&gt;&lt;br&gt;&lt;code&gt;X-Real-IP&lt;/code&gt; — địa chỉ thật của bên gọi&lt;br&gt;&lt;code&gt;X-Forwarded-For&lt;/code&gt; — chuỗi các điểm trung gian đã đi qua&lt;br&gt;&lt;code&gt;X-Forwarded-Proto&lt;/code&gt; — giao thức gốc của yêu cầu" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="3830" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n347" value="&lt;b&gt;Vì sao cần các tiêu đề này&lt;/b&gt;&lt;br&gt;Sau hai lần chuyển tiếp, địa chỉ nguồn ở tầng mạng đã bị thay thế hai lần. Tầng ứng dụng nhìn thấy địa chỉ của điểm trung gian gần nhất chứ không phải của người dùng.&lt;br&gt;&lt;br&gt;Thiếu các tiêu đề này thì mọi chức năng phụ thuộc địa chỉ nguồn — ghi nhật ký, giới hạn tần suất, phân tích — đều mất tác dụng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="4138" width="480" height="276" as="geometry" />
        </mxCell>
        <mxCell id="n348" value="&lt;b&gt;Ràng buộc bảo mật&lt;/b&gt;&lt;br&gt;Các tiêu đề này do bên gọi gửi lên nên &lt;b&gt;có thể bị giả mạo&lt;/b&gt;. Chỉ được tin cậy khi yêu cầu đến từ điểm trung gian đã xác thực.&lt;br&gt;&lt;br&gt;Tầng ứng dụng cần lấy giá trị theo vị trí xác định trong chuỗi thay vì lấy phần tử đầu tiên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="4426" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n349" value="&lt;b&gt;Tối ưu bổ sung&lt;/b&gt;&lt;br&gt;Nén nội dung phản hồi dạng dữ liệu có cấu trúc được bật tại đây, giảm đáng kể lượng byte truyền ngược về cho bên gọi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="4696" width="480" height="222" as="geometry" />
        </mxCell>
        <mxCell id="n350" value="24" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n351" value="&lt;b&gt;Mạng nội bộ giữa các container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bridge network&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n352" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Toàn bộ dịch vụ chạy dưới dạng container trên một mạng cầu nối nội bộ dùng chung.&lt;br&gt;&lt;br&gt;Các container giải tên nhau bằng &lt;b&gt;tên dịch vụ&lt;/b&gt; thay vì địa chỉ IP, vì địa chỉ được cấp lại mỗi lần khởi động và không cố định." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="3830" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n353" value="&lt;b&gt;Hệ quả với cấu hình kết nối&lt;/b&gt;&lt;br&gt;Trong tệp cấu hình, máy chủ cơ sở dữ liệu được khai báo bằng tên dịch vụ.&lt;br&gt;&lt;br&gt;Dùng &lt;code&gt;127.0.0.1&lt;/code&gt; ở đây là sai: trong không gian mạng của một container, địa chỉ đó trỏ về chính container ấy chứ không phải máy chủ vật lý hay container khác." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="4128" width="480" height="276" as="geometry" />
        </mxCell>
        <mxCell id="n354" value="&lt;b&gt;Ranh giới cách ly&lt;/b&gt;&lt;br&gt;Chỉ những cổng được ánh xạ tường minh ra máy chủ mới truy cập được từ bên ngoài. Các cổng còn lại chỉ tồn tại trong phạm vi mạng nội bộ.&lt;br&gt;&lt;br&gt;Đây là lớp giới hạn bổ sung nằm dưới lớp kiểm soát ở bước 20." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="4416" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n355" value="&lt;b&gt;Dữ liệu bền vững&lt;/b&gt;&lt;br&gt;Trạng thái của cơ sở dữ liệu và hệ thống truyền thông điệp nằm trên ổ đĩa được gắn vào, tồn tại độc lập với vòng đời của container." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="4696" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n356" value="25" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n357" value="&lt;b&gt;Cổng vào tầng ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gateway-service :8080&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n358" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Đây là điểm vào duy nhất của tầng ứng dụng. Mọi yêu cầu từ bên ngoài đều đi qua đây trước khi tới bất kỳ dịch vụ nghiệp vụ nào.&lt;br&gt;&lt;br&gt;Bốn nhiệm vụ được thực hiện tuần tự: định tuyến theo đường dẫn, xác thực, khởi tạo ngữ cảnh theo vết, chuyển đổi giao thức." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="3830" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n359" value="&lt;b&gt;Vì sao tập trung vào một điểm&lt;/b&gt;&lt;br&gt;Xác thực, giới hạn tần suất và ghi nhận vết được cài đặt một lần thay vì lặp lại trong từng dịch vụ.&lt;br&gt;&lt;br&gt;Các dịch vụ nghiệp vụ nhờ đó chỉ tập trung vào phạm vi nghiệp vụ được giao và không cần biết tới cơ chế xác thực của hệ thống." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="4128" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n360" value="&lt;b&gt;Đánh đổi&lt;/b&gt;&lt;br&gt;Thành phần này trở thành điểm hỏng đơn lẻ: nó ngừng hoạt động thì toàn bộ tầng ứng dụng không tiếp cận được.&lt;br&gt;&lt;br&gt;Do đó nó phải phi trạng thái để có thể chạy nhiều bản sao, và mọi trạng thái phiên phải nằm ở tầng lưu trữ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="4426" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n361" value="&lt;b&gt;Thư mục liên quan&lt;/b&gt;&lt;br&gt;&lt;code&gt;gateway_service/internal/delivery&lt;/code&gt; — định nghĩa tuyến&lt;br&gt;&lt;code&gt;gateway_service/internal/di&lt;/code&gt; — lắp ráp phụ thuộc và cấu hình kết nối tới các dịch vụ nội bộ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="4706" width="480" height="232" as="geometry" />
        </mxCell>
        <mxCell id="n362" value="26" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n363" value="&lt;b&gt;Xác thực thẻ truy cập&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JWT — chữ ký HMAC-SHA256&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n364" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Thẻ gồm ba phần ngăn cách bởi dấu chấm: phần tiêu đề, phần nội dung và phần chữ ký.&lt;br&gt;&lt;br&gt;Máy chủ ghép phần tiêu đề với phần nội dung, tính lại chữ ký bằng khoá bí mật, rồi so sánh với chữ ký đi kèm.&lt;br&gt;&lt;br&gt;Khớp ⇒ chấp nhận. Sai lệch ⇒ từ chối với mã lỗi xác thực." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="3830" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n365" value="&lt;b&gt;Vì sao không giả mạo được&lt;/b&gt;&lt;br&gt;Phần nội dung chỉ được mã hoá theo định dạng truyền tải nên &lt;b&gt;ai cũng đọc được&lt;/b&gt; — đây là điểm thường bị hiểu sai.&lt;br&gt;&lt;br&gt;Tính an toàn nằm ở chữ ký: sửa một ký tự bất kỳ trong nội dung sẽ làm chữ ký tính lại khác hoàn toàn, và bên sửa không có khoá bí mật để tạo chữ ký mới hợp lệ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="4142" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n366" value="&lt;b&gt;Ràng buộc khi sử dụng&lt;/b&gt;&lt;br&gt;Không đặt dữ liệu nhạy cảm trong phần nội dung của thẻ.&lt;br&gt;Khoá bí mật nằm trong tệp biến môi trường, được sinh tại thời điểm triển khai và không bao giờ đưa vào kho mã nguồn.&lt;br&gt;Thẻ cần có thời hạn hiệu lực ngắn kèm cơ chế làm mới." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="4446" width="480" height="262" as="geometry" />
        </mxCell>
        <mxCell id="n367" value="&lt;b&gt;Phân biệt hai khái niệm&lt;/b&gt;&lt;br&gt;Bước này xác định &lt;b&gt;bên gọi là ai&lt;/b&gt;. Việc xác định &lt;b&gt;bên gọi được làm gì&lt;/b&gt; dựa trên vai trò và phạm vi ghi trong thẻ, do tầng nghiệp vụ đảm nhiệm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="4720" width="480" height="216" as="geometry" />
        </mxCell>
        <mxCell id="n368" value="27" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n369" value="&lt;b&gt;Khởi tạo ngữ cảnh theo vết&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OpenTelemetry — TraceID&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n370" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Một định danh vết duy nhất được sinh cho yêu cầu này và gắn vào ngữ cảnh thực thi.&lt;br&gt;&lt;br&gt;Mỗi công đoạn về sau tạo một khoảng đo riêng, ghi lại thời điểm bắt đầu, thời điểm kết thúc và trạng thái lỗi, đồng thời trỏ về khoảng đo cha." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="3830" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n371" value="&lt;b&gt;Điều kiện để vết không đứt đoạn&lt;/b&gt;&lt;br&gt;Định danh phải được truyền qua &lt;b&gt;mọi ranh giới tiến trình&lt;/b&gt;:&lt;br&gt;• Vào metadata của lời gọi giữa các dịch vụ.&lt;br&gt;• Vào tiêu đề thông điệp khi phát sang hệ thống truyền thông điệp.&lt;br&gt;&lt;br&gt;Thiếu một mắt xích, toàn bộ phần phía sau trở nên không quan sát được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="4132" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n372" value="&lt;b&gt;Hạng mục còn tồn đọng&lt;/b&gt;&lt;br&gt;Việc truyền ngữ cảnh qua tiêu đề thông điệp &lt;b&gt;chưa được cài đặt&lt;/b&gt;. Hiện vết dừng lại ở ranh giới giữa tầng ứng dụng và hệ thống truyền thông điệp ở bước 35.&lt;br&gt;&lt;br&gt;Đây là khoảng trống quan sát lớn nhất của hệ thống hiện tại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="4440" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n373" value="&lt;b&gt;Thư viện dùng chung&lt;/b&gt;&lt;br&gt;&lt;code&gt;pkg/tracer&lt;/code&gt; — khởi tạo bộ xuất dữ liệu, gắn nhãn tên dịch vụ và đăng ký cơ chế truyền ngữ cảnh toàn cục." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="4720" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n374" value="28" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n375" value="&lt;b&gt;Chuyển đổi giao thức&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTP/JSON → gRPC/Protobuf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n376" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Yêu cầu dạng văn bản có cấu trúc được ánh xạ sang thông điệp nhị phân theo lược đồ đã định nghĩa, rồi gửi đi bằng lời gọi thủ tục từ xa trên nền HTTP/2.&lt;br&gt;&lt;br&gt;Mã thực hiện việc chuyển đổi được sinh tự động từ tệp định nghĩa lược đồ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="3830" width="480" height="284" as="geometry" />
        </mxCell>
        <mxCell id="n377" value="&lt;b&gt;Cơ sở lựa chọn&lt;/b&gt;&lt;br&gt;• Mã hoá nhị phân — số byte nhỏ hơn nhiều lần so với dạng văn bản.&lt;br&gt;• Lược đồ ràng buộc chặt — sai kiểu dữ liệu bị phát hiện khi biên dịch thay vì khi vận hành.&lt;br&gt;• Một tệp định nghĩa sinh mã cho mọi ngôn ngữ, loại bỏ nguy cơ lệch hợp đồng giữa các thành phần.&lt;br&gt;• HTTP/2 ghép nhiều lời gọi trên một kết nối và nén phần tiêu đề." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="4126" width="480" height="296" as="geometry" />
        </mxCell>
        <mxCell id="n378" value="&lt;b&gt;Quy tắc thay đổi lược đồ&lt;/b&gt;&lt;br&gt;Số hiệu trường là định danh thật khi mã hoá nhị phân, không phải tên trường.&lt;br&gt;&lt;br&gt;Không đổi số hiệu đã phát hành, không tái sử dụng số hiệu đã xoá, trường mới luôn để ở dạng tuỳ chọn. Bên gọi phiên bản cũ gặp trường lạ sẽ bỏ qua thay vì báo lỗi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="4434" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n379" value="&lt;b&gt;Thư mục liên quan&lt;/b&gt;&lt;br&gt;&lt;code&gt;api/logistic/*.proto&lt;/code&gt; — định nghĩa gốc&lt;br&gt;&lt;code&gt;api/&lt;/code&gt; — mã sinh tự động và tài liệu giao diện" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="4714" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n380" value="29" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n381" value="&lt;b&gt;Tầng tiếp nhận của dịch vụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Controller&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n382" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Dịch vụ nghiệp vụ nhận lời gọi và thực hiện đúng ba việc:&lt;br&gt;&lt;br&gt;① Giải mã thông điệp nhị phân thành cấu trúc dữ liệu trong ngôn ngữ.&lt;br&gt;② Kiểm tra tính hợp lệ của đầu vào.&lt;br&gt;③ Gọi xuống tầng nghiệp vụ và chuyển đổi kết quả trả về." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="3830" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n383" value="&lt;b&gt;Ranh giới trách nhiệm&lt;/b&gt;&lt;br&gt;Tầng này &lt;b&gt;không chứa quy tắc nghiệp vụ&lt;/b&gt;. Nó chỉ là lớp thích ứng giữa giao thức bên ngoài và mô hình bên trong.&lt;br&gt;&lt;br&gt;Nhờ đó, thay đổi giao thức — chẳng hạn bổ sung một giao diện khác — không tác động tới phần lõi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="4128" width="480" height="288" as="geometry" />
        </mxCell>
        <mxCell id="n384" value="&lt;b&gt;Kiểm tra đầu vào thuộc về đâu&lt;/b&gt;&lt;br&gt;Kiểm tra &lt;b&gt;hình thức&lt;/b&gt; — trường bắt buộc, định dạng, khoảng giá trị — thuộc tầng này.&lt;br&gt;&lt;br&gt;Kiểm tra &lt;b&gt;nghiệp vụ&lt;/b&gt; — số dư có đủ không, phương tiện có đang rảnh không — thuộc tầng dưới, vì nó cần truy cập trạng thái hệ thống." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="4428" width="480" height="274" as="geometry" />
        </mxCell>
        <mxCell id="n385" value="&lt;b&gt;Thư mục liên quan&lt;/b&gt;&lt;br&gt;&lt;code&gt;internal/controller&lt;/code&gt; — điểm tiếp nhận&lt;br&gt;&lt;code&gt;internal/dto&lt;/code&gt; — cấu trúc trao đổi với bên ngoài&lt;br&gt;&lt;code&gt;internal/mapper&lt;/code&gt; — chuyển đổi giữa các dạng biểu diễn" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="4714" width="480" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n386" value="30" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="3706" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n387" value="&lt;b&gt;Tầng quy tắc nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Biz — Use Case&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="3660" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n388" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Toàn bộ quy tắc nghiệp vụ nằm ở đây: điều kiện hợp lệ, trình tự các bước, tính toán giá trị, quyết định trạng thái.&lt;br&gt;&lt;br&gt;Tầng này chỉ tương tác với tầng dưới qua &lt;b&gt;giao diện trừu tượng&lt;/b&gt; do chính nó khai báo, không phụ thuộc vào công nghệ lưu trữ cụ thể." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="3830" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n389" value="&lt;b&gt;Quy tắc đảo ngược phụ thuộc&lt;/b&gt;&lt;br&gt;Giao diện được &lt;b&gt;khai báo tại tầng nghiệp vụ&lt;/b&gt; và được &lt;b&gt;hiện thực hoá tại tầng truy cập dữ liệu&lt;/b&gt;. Chiều phụ thuộc vì thế hướng vào trong, ngược với chiều gọi hàm.&lt;br&gt;&lt;br&gt;Hệ quả: kiểm thử tầng nghiệp vụ không cần cơ sở dữ liệu, và thay đổi hệ quản trị lưu trữ không lan sang phần lõi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="4142" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n390" value="&lt;b&gt;Dấu hiệu vi phạm kiến trúc&lt;/b&gt;&lt;br&gt;Xuất hiện câu lệnh truy vấn, tên bảng hoặc lời gọi thư viện truy cập dữ liệu bên trong thư mục của tầng này.&lt;br&gt;&lt;br&gt;Khi đó phần lõi đã bị ràng buộc vào công nghệ lưu trữ và mất khả năng kiểm thử độc lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="4454" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n391" value="&lt;b&gt;Kết thúc chặng III&lt;/b&gt;&lt;br&gt;Yêu cầu đã được xác thực, kiểm tra và xử lý theo quy tắc nghiệp vụ. Từ đây bắt đầu chặng IV: truy cập dữ liệu và phát sự kiện." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="4734" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e392" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n333" target="n339">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e393" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n339" target="n345">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e394" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n345" target="n351">
