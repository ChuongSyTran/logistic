        </mxCell>
        <mxCell id="n940" value="&lt;b&gt;Đọc bảng này.&lt;/b&gt; Vị trí nào của mặt nạ mang bit 1 thì bit tương ứng của địa chỉ được &lt;b&gt;giữ nguyên&lt;/b&gt;; vị trí nào mang bit 0 thì bit tương ứng bị &lt;b&gt;triệt tiêu về 0&lt;/b&gt;.&lt;br&gt;Phần giữ lại chính là địa chỉ mạng, phần bị triệt tiêu chính là phần định danh máy trạm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ứng dụng.&lt;/b&gt; Máy nguồn thực hiện phép này hai lần — một lần cho địa chỉ đích, một lần cho địa chỉ của chính nó — rồi so sánh hai kết quả để quyết định gửi thẳng qua thiết bị chuyển mạch hay chuyển cho cổng mặc định. Cùng phép toán được bảng định tuyến của mạng riêng ảo dùng lại ở bước 18." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="7694" y="10606" width="1322" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n941" value="MA TRẬN KHẢ NĂNG KẾT NỐI CỦA MỘT MÁY ẢO THEO CẤU HÌNH — TRẢ LỜI CHO BƯỚC G8" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
