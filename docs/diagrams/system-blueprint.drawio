        <mxCell id="n529" value="PHỤ LỤC D · MÔ HÌNH PHÂN TÁCH ĐỌC – GHI, CHIẾN LƯỢC ĐỒNG BỘ VÀ BẢNG CỔNG DỊCH VỤ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=10;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
