        </mxCell>
        <mxCell id="n415" value="Bộ xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6694" y="3736" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n416" value="Phân chia thời gian" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6914" y="3736" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n417" value="Lớp ảo hoá cấp phát chu kỳ xử lý theo lát rất ngắn. Trạng thái máy ảo được lưu lại khi hết lượt, khiến hệ điều hành bên trong nhận thức như đang sở hữu bộ xử lý liên tục." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7214" y="3736" width="1802" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n418" value="Bộ nhớ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6694" y="3794" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n419" value="Ánh xạ qua đơn vị quản lý bộ nhớ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6914" y="3794" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n420" value="Mỗi máy ảo được ánh xạ vào một vùng địa chỉ vật lý riêng. Phần cứng kiểm tra từng lệnh truy cập; vượt ra ngoài vùng cấp phát sẽ kích hoạt ngắt và tiến trình bị dừng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7214" y="3794" width="1802" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n421" value="Mạng và lưu trữ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="6694" y="3852" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n422" value="Bộ điều khiển chuyên dụng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="6914" y="3852" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n423" value="Chức năng mạng và truy cập ổ đĩa được đẩy xuống phần cứng riêng, tách khỏi bộ xử lý chính. Đây cũng là nền tảng cho mạng định nghĩa bằng phần mềm ở phụ lục B." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7214" y="3852" width="1802" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n424" value="PHÂN TẦNG ỨNG DỤNG VÀ CHIỀU PHỤ THUỘC" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#10739e;fontStyle=1;" vertex="1" parent="1">
