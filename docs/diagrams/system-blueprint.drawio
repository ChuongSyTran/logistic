        <mxCell id="n276" value="Bộ nhớ đệm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
