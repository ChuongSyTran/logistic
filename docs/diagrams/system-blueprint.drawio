        </mxCell>
        <mxCell id="n277" value="Chỉ có địa chỉ riêng. Khởi tạo được kết nối ra ngoài qua cổng biên dịch địa chỉ, nhưng không tồn tại tuyến để Internet khởi tạo kết nối vào." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6594" y="2420" width="1110" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n278" value="Availability Zone ap-southeast-1b" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=10;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
