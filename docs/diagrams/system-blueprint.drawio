        </mxCell>
        <mxCell id="n974" value="Không" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7584" y="11024" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n975" value="Không" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="7884" y="11024" width="320" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n976" value="Hoàn toàn cách ly. Vẫn dùng được điểm cuối mạng riêng ảo vì luật của chúng cụ thể hơn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="8204" y="11024" width="812" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n977" value="&lt;b&gt;Kết luận cho bước G8.&lt;/b&gt; Cụm từ &quot;vẫn thấy mạng&quot; cần được tách làm hai nghĩa khác nhau.&lt;br&gt;&lt;b&gt;① Nội bộ mạng riêng ảo&lt;/b&gt; — luôn hoạt động, không phụ thuộc địa chỉ công cộng, vì luật định tuyến &lt;code&gt;local&lt;/code&gt; là mặc định và không xoá được. Máy vẫn gọi được cơ sở dữ liệu, vẫn phân giải được tên miền, vẫn nhận được kết nối từ máy khác trong cùng mạng.&lt;br&gt;&lt;b&gt;② Ra Internet&lt;/b&gt; — không hoạt động. Việc nằm trong mạng con công khai &lt;b&gt;chỉ nói lên bảng định tuyến trỏ ra cổng kết nối Internet&lt;/b&gt;, không tự động cấp địa chỉ công cộng cho máy. Mà cổng đó lại chỉ biết làm ánh xạ một–một, nên thiếu địa chỉ công cộng là thiếu điều kiện cần.&lt;br&gt;&lt;b&gt;Ghi nhớ:&lt;/b&gt; mạng con công khai hay riêng tư là thuộc tính của &lt;b&gt;bảng định tuyến&lt;/b&gt;; khả năng ra Internet là thuộc tính của &lt;b&gt;tổ hợp bảng định tuyến và địa chỉ của máy&lt;/b&gt;. Hai điều này độc lập với nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6364" y="11104" width="2652" height="116" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
