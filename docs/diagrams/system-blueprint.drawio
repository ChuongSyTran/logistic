        </mxCell>
        <mxCell id="n663" value="THAM CHIẾU E · QUẢN TRỊ CỤM THEO THUẬT TOÁN RAFT, TÁI CÂN BẰNG NHÓM VÀ CHÍNH SÁCH LƯU TRỮ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=10;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="6340" y="6940" width="2700" height="1490" as="geometry" />
        </mxCell>
        <mxCell id="n664" value="MÁY TRẠNG THÁI CỦA MỘT NÚT ĐIỀU PHỐI" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5c8a3c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6364" y="6970" width="1000" height="26" as="geometry" />
        </mxCell>
