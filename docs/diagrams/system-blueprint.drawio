<mxfile host="app.diagrams.net" agent="Claude" version="26.2.14" type="device">
  <diagram name="Blueprint hệ thống Logistic" id="diag978">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="9200" pageHeight="11840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="BP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=40;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="130" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="BLUEPRINT HỆ THỐNG BACKEND LOGISTIC — HÀNH TRÌNH ĐẦY ĐỦ CỦA MỘT YÊU CẦU" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#12314f;" vertex="1" parent="1">
          <mxGeometry x="210" y="24" width="4200" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Bốn chặng chính đánh số 1–40, tiếp theo là ba băng phụ lục chuyên sâu E, F và G. Hàng trên mỗi băng là luồng xử lý; cột bên dưới mỗi bước là chú giải kỹ thuật; khối bên phải là tham chiếu." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#4a5b6a;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="214" y="88" width="4400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Quy ước màu — nhóm A" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=12;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="4700" y="24" width="1000" height="164" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4714" y="60" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Mạng, giao thức truyền tải, thiết bị định tuyến" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="4752" y="60" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4714" y="90" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Mã hoá, kiểm soát truy cập, biên dịch địa chỉ" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="4752" y="90" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4714" y="120" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Hạ tầng điện toán đám mây" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="4752" y="120" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4714" y="150" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Dịch vụ ứng dụng" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="4752" y="150" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Quy ước màu — nhóm B" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f7;opacity=12;strokeColor=#b3b3b3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="5760" y="24" width="1000" height="164" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5774" y="60" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Lưu trữ bền vững và bộ nhớ đệm" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="5812" y="60" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5774" y="90" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="Truyền thông điệp và luồng sự kiện" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="5812" y="90" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5774" y="120" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Tìm kiếm, giám sát, đo lường" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="5812" y="120" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontColor=#000000;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5774" y="150" width="28" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="Tự động hoá triển khai" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="5812" y="150" width="934" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;CÁCH SỬ DỤNG BẢN VẼ&lt;/b&gt;&lt;br&gt;Thu nhỏ để nắm toàn cảnh: bốn băng ngang tương ứng bốn chặng, luồng chạy từ trái sang phải rồi vòng xuống băng kế tiếp theo đường nối ở lề dưới.&lt;br&gt;Phóng to để đọc chi tiết: mỗi bước có một cột chú giải riêng bên dưới, trình bày việc đang diễn ra, cơ sở kỹ thuật, ràng buộc và rủi ro vận hành.&lt;br&gt;&lt;b&gt;Số thứ tự chạy liên tục từ 1 đến 40&lt;/b&gt; xuyên suốt bốn băng đầu và được dẫn chiếu qua lại giữa các chú giải.&lt;br&gt;&lt;b&gt;Ba băng cuối là phụ lục chuyên sâu&lt;/b&gt; — E chi tiết hoá bước 35–37, F chi tiết hoá bước 38, G chi tiết hoá bước 3–10 và 17–20 — đánh số riêng E1–E10, F1–F10, G1–G10, không thuộc luồng chính." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="6840" y="24" width="2200" height="244" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="CHẶNG I · TỪ TIẾN TRÌNH ỨNG DỤNG TRÊN THIẾT BỊ NGƯỜI DÙNG RA TỚI XƯƠNG SỐNG INTERNET" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="9000" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Ứng dụng tạo dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 7 — Application&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Tiến trình ứng dụng dựng khối dữ liệu nghiệp vụ, thường ở dạng JSON hoặc Protobuf, kèm phương thức và đường dẫn tài nguyên.&lt;br&gt;&lt;br&gt;Ở thời điểm này dữ liệu còn &lt;b&gt;nguyên văn&lt;/b&gt; — bất kỳ tiến trình nào đọc được bộ nhớ đều thấy nội dung." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="550" width="480" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;Giao thức lớp 7 xuất hiện trong hệ thống&lt;/b&gt;&lt;br&gt;• &lt;code&gt;HTTP/HTTPS&lt;/code&gt; — thiết bị người dùng tới cổng vào&lt;br&gt;• &lt;code&gt;gRPC&lt;/code&gt; trên HTTP/2 — giữa các dịch vụ nội bộ&lt;br&gt;• &lt;code&gt;MQTT&lt;/code&gt; — thiết bị định vị trên phương tiện&lt;br&gt;• &lt;code&gt;DNS&lt;/code&gt; — phân giải tên miền&lt;br&gt;• &lt;code&gt;SSH&lt;/code&gt; — quản trị máy chủ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="776" width="480" height="246" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;Ranh giới trách nhiệm&lt;/b&gt;&lt;br&gt;Lớp này không biết gì về địa chỉ IP, cổng hay đường đi. Nó chỉ tạo ra nội dung cần chuyển giao.&lt;br&gt;&lt;br&gt;Toàn bộ khối dữ liệu này về sau được gọi là &lt;b&gt;tải trọng (payload)&lt;/b&gt; và sẽ được các lớp dưới bọc thêm nhiều lớp tiêu đề." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="1034" width="480" height="286" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;Ý nghĩa với thiết kế hệ thống&lt;/b&gt;&lt;br&gt;Kích thước tải trọng quyết định trực tiếp số gói tin phải truyền. Đây là lý do giao tiếp nội bộ dùng Protobuf mã hoá nhị phân thay vì JSON dạng văn bản: cùng một nội dung nghiệp vụ nhưng số byte nhỏ hơn nhiều lần." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="1332" width="480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;TLS mã hoá tải trọng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 6 và 5 — Presentation, Session&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;Điều kiện tiên quyết&lt;/b&gt;&lt;br&gt;Việc mã hoá chỉ thực hiện được sau khi hai bên đã hoàn tất bắt tay và cùng sở hữu &lt;b&gt;khoá phiên&lt;/b&gt;. Bắt tay TLS là quy trình ở lớp 7 nhưng bắt buộc phải có kênh TCP (lớp 4) trước.&lt;br&gt;&lt;br&gt;Trình tự: mở kênh TCP → thoả thuận thuật toán → trao chứng thư → trao khoá → mới bắt đầu mã hoá dữ liệu thật." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="550" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;Mô hình mã hoá lai&lt;/b&gt;&lt;br&gt;&lt;b&gt;Bất đối xứng&lt;/b&gt; (RSA, ECC) — an toàn khi phân phối khoá qua môi trường công cộng, nhưng chi phí tính toán lớn.&lt;br&gt;&lt;b&gt;Đối xứng&lt;/b&gt; (AES) — thông lượng rất cao nhờ hỗ trợ ở cấp lệnh phần cứng, nhưng chưa có cách truyền khoá an toàn.&lt;br&gt;&lt;br&gt;TLS dùng mô hình thứ nhất &lt;b&gt;chỉ để truyền khoá&lt;/b&gt; của mô hình thứ hai, rồi chuyển hẳn sang mô hình thứ hai." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="862" width="480" height="332" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;Chống phát lại&lt;/b&gt;&lt;br&gt;Khoá phiên được sinh từ ba thành phần: chuỗi ngẫu nhiên phía client, chuỗi ngẫu nhiên phía máy chủ và bí mật tiền chủ.&lt;br&gt;Hai chuỗi ngẫu nhiên khiến khoá khác nhau ở mỗi phiên, vô hiệu hoá việc ghi lại gói tin và phát lại sau đó." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="1206" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;Điều TLS không che giấu&lt;/b&gt;&lt;br&gt;Địa chỉ IP đích, số cổng và tên miền trong phần mở rộng SNI vẫn quan sát được trên đường truyền. Chỉ tải trọng được mã hoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="1438" width="480" height="174" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1354" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;Đóng gói TCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 4 — Transport&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Tải trọng được chia thành các đoạn và bọc thêm &lt;b&gt;TCP Header&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;code&gt;Cổng nguồn : 51234&lt;/code&gt; — hệ điều hành cấp ngẫu nhiên trong dải cổng tạm&lt;br&gt;&lt;code&gt;Cổng đích&amp;nbsp; : 443&lt;/code&gt; — cố định theo dịch vụ&lt;br&gt;&lt;code&gt;Số thứ tự, số xác nhận&lt;/code&gt; — bảo đảm đúng trình tự và phát hiện mất gói" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="550" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;Vai trò của số cổng&lt;/b&gt;&lt;br&gt;Địa chỉ IP đưa gói tin tới đúng máy. Trên máy đó có hàng chục tiến trình đang chạy — số cổng xác định tiến trình nào nhận.&lt;br&gt;&lt;br&gt;Một địa chỉ có &lt;b&gt;65.535&lt;/b&gt; cổng, cho phép một máy phục vụ đồng thời rất nhiều kết nối độc lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="820" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;Bắt tay ba bước&lt;/b&gt;&lt;br&gt;&lt;code&gt;SYN&lt;/code&gt; → đề nghị mở kết nối&lt;br&gt;&lt;code&gt;SYN-ACK&lt;/code&gt; → chấp nhận và yêu cầu xác nhận&lt;br&gt;&lt;code&gt;ACK&lt;/code&gt; → kênh sẵn sàng&lt;br&gt;&lt;br&gt;Sau ba bước này kênh đã thông nhưng &lt;b&gt;chưa có byte dữ liệu ứng dụng nào&lt;/b&gt; được gửi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1100" width="480" height="252" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;Liên hệ với tường lửa&lt;/b&gt;&lt;br&gt;Tường lửa lớp 3/4 — Security Group và Network ACL ở chặng II — đọc đúng phần tiêu đề này để quyết định cho qua hay chặn.&lt;br&gt;Chúng &lt;b&gt;không mở tải trọng&lt;/b&gt;, nên nội dung độc hại nằm trong tải trọng vẫn đi lọt nếu gói tin dùng đúng cổng hợp lệ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1364" width="480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1974" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;Đóng gói IP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 3 — Network&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Đoạn TCP được bọc thêm &lt;b&gt;IP Header&lt;/b&gt; tạo thành gói tin (packet).&lt;br&gt;&lt;br&gt;&lt;code&gt;Địa chỉ nguồn : 192.168.1.5&lt;/code&gt;&lt;br&gt;&lt;code&gt;Địa chỉ đích&amp;nbsp; : 13.212.0.5&lt;/code&gt;&lt;br&gt;&lt;code&gt;TTL&lt;/code&gt; — số chặng tối đa còn được đi qua&lt;br&gt;&lt;code&gt;Protocol&lt;/code&gt; — cho biết lớp trên là TCP hay UDP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="550" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;Quyết định định tuyến tại nguồn&lt;/b&gt;&lt;br&gt;Trước khi gửi, hệ điều hành thực hiện phép &lt;b&gt;AND nhị phân&lt;/b&gt; giữa địa chỉ đích và mặt nạ mạng của giao diện:&lt;br&gt;&lt;br&gt;&lt;code&gt;13.212.0.5&amp;nbsp;&amp;nbsp;&amp;nbsp; AND 255.255.255.0&lt;/code&gt;&lt;br&gt;&lt;code&gt;192.168.1.5&amp;nbsp; AND 255.255.255.0&lt;/code&gt;&lt;br&gt;&lt;br&gt;Hai kết quả khác nhau ⇒ đích &lt;b&gt;nằm ngoài mạng cục bộ&lt;/b&gt; ⇒ gói tin phải chuyển cho cổng mặc định thay vì gửi thẳng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="792" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;Vai trò của TTL&lt;/b&gt;&lt;br&gt;Mỗi thiết bị định tuyến giảm giá trị này đi một đơn vị. Về không thì gói tin bị huỷ và một thông báo lỗi được gửi ngược lại.&lt;br&gt;&lt;br&gt;Cơ chế này ngăn gói tin quay vòng vô hạn khi bảng định tuyến ở đâu đó bị cấu hình sai, và cũng là nguyên lý hoạt động của công cụ dò đường." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="1104" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;Đặc điểm quan trọng nhất&lt;/b&gt;&lt;br&gt;Lớp 3 được &lt;b&gt;giữ nguyên vẹn&lt;/b&gt; từ nguồn tới đích trên suốt hành trình, ngoại trừ khi đi qua thiết bị biên dịch địa chỉ ở bước 8 và bước 17." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="1384" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2594" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;Tra ARP và đóng khung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 2 — Data Link&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Vì đích nằm ngoài mạng cục bộ, khung tin không hướng tới máy đích mà hướng tới &lt;b&gt;cổng mặc định&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Máy trạm cần địa chỉ phần cứng của cổng mặc định, và tra trong &lt;b&gt;bảng ARP&lt;/b&gt; — bảng ánh xạ giữa địa chỉ IP và địa chỉ MAC." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="550" width="480" height="264" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;Khi bảng ARP chưa có mục cần tìm&lt;/b&gt;&lt;br&gt;① Phát khung quảng bá tới địa chỉ &lt;code&gt;FF:FF:FF:FF:FF:FF&lt;/code&gt; với nội dung hỏi ai đang giữ địa chỉ IP đó.&lt;br&gt;② Bộ chuyển mạch đẩy khung ra &lt;b&gt;mọi cổng&lt;/b&gt;.&lt;br&gt;③ Thiết bị đúng địa chỉ trả lời kèm địa chỉ MAC tương ứng.&lt;br&gt;④ Máy trạm ghi vào bảng ARP; các khung sau đi thẳng.&lt;br&gt;&lt;br&gt;Chi phí này chỉ phát sinh ở lần đầu và khi mục trong bảng hết hạn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="826" width="480" height="318" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;Cấu trúc khung Ethernet&lt;/b&gt;&lt;br&gt;&lt;code&gt;MAC đích&lt;/code&gt; — của cổng mặc định, không phải của máy chủ đích&lt;br&gt;&lt;code&gt;MAC nguồn&lt;/code&gt; — gán cố định trên chip card mạng&lt;br&gt;&lt;code&gt;Tải trọng&lt;/code&gt; — toàn bộ gói tin lớp 3&lt;br&gt;&lt;code&gt;FCS&lt;/code&gt; — chuỗi kiểm tra lỗi ở cuối khung" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="1156" width="480" height="246" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="&lt;b&gt;Điểm khác biệt cốt lõi so với lớp 3&lt;/b&gt;&lt;br&gt;Khung lớp 2 chỉ có ý nghĩa &lt;b&gt;trong phạm vi một chặng&lt;/b&gt;. Nó bị tháo bỏ và dựng lại hoàn toàn tại mỗi thiết bị định tuyến trên đường đi — địa chỉ MAC ở chặng đầu không tồn tại ở chặng cuối." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2640" y="1414" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3214" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b&gt;Card mạng điều chế tín hiệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lớp 1 — Physical&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3260" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Card mạng chuyển chuỗi bit thành đại lượng vật lý truyền được trên môi trường:&lt;br&gt;&lt;br&gt;• &lt;b&gt;Cáp đồng&lt;/b&gt; — biến thiên mức điện áp&lt;br&gt;• &lt;b&gt;Cáp quang&lt;/b&gt; — xung sáng của nguồn laser&lt;br&gt;• &lt;b&gt;Sóng vô tuyến&lt;/b&gt; — biến thiên tần số hoặc biên độ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="550" width="480" height="252" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;Vì sao đường trục dùng cáp quang&lt;/b&gt;&lt;br&gt;Tín hiệu điện trên cáp đồng suy hao nhanh do điện trở, chỉ đi được vài chục kilômét.&lt;br&gt;&lt;br&gt;Ánh sáng truyền trong sợi thuỷ tinh siêu tinh khiết đi xa hơn rất nhiều, nhưng vẫn suy hao sau khoảng 50–100 km nên cần các bộ khuếch đại đặt dọc tuyến." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="814" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;b&gt;Cáp quang biển&lt;/b&gt;&lt;br&gt;Dữ liệu truyền bằng ánh sáng, còn dòng điện một chiều điện áp cao chạy song song trong lõi đồng của vỏ cáp chỉ để cấp nguồn cho các bộ khuếch đại nằm dưới đáy biển." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="1094" width="480" height="246" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;b&gt;Giới hạn vật lý không thể vượt qua&lt;/b&gt;&lt;br&gt;Độ trễ tối thiểu giữa hai điểm bị chặn dưới bởi tốc độ ánh sáng trong sợi quang. Đây là lý do vị trí đặt vùng dữ liệu ảnh hưởng trực tiếp tới trải nghiệm và không thể bù bằng phần cứng mạnh hơn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3260" y="1352" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3834" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;Bộ chuyển mạch nội bộ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Thiết bị lớp 2 trong mạng cục bộ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3880" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Bộ chuyển mạch đọc &lt;b&gt;địa chỉ MAC đích&lt;/b&gt; trong khung tin, tra &lt;b&gt;bảng MAC&lt;/b&gt; để biết thiết bị đó nối vào cổng vật lý nào, rồi đẩy khung ra đúng cổng đó.&lt;br&gt;&lt;br&gt;Bảng MAC ánh xạ [cổng vật lý ↔ địa chỉ MAC] và &lt;b&gt;hoàn toàn không chứa địa chỉ IP&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="550" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="&lt;b&gt;Cách bảng MAC được xây dựng&lt;/b&gt;&lt;br&gt;Thiết bị học thụ động: mỗi khung đi vào cổng nào thì địa chỉ MAC nguồn của khung đó được gắn với cổng ấy.&lt;br&gt;&lt;br&gt;Chưa biết đích ở đâu thì đẩy ra mọi cổng; câu trả lời quay về sẽ bổ sung mục còn thiếu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="830" width="480" height="246" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;Giới hạn ở quy mô lớn&lt;/b&gt;&lt;br&gt;Bảng MAC nằm trong bộ nhớ tốc độ cao dung lượng hữu hạn. Khi số thiết bị sinh và huỷ liên tục ở quy mô điện toán đám mây, bảng tràn và thiết bị rơi vào trạng thái phát tán liên tục.&lt;br&gt;&lt;br&gt;Đây là một trong các lý do mạng ảo trên nền tảng đám mây phải được dựng lại bằng phần mềm — trình bày ở chặng II." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="1088" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;Phạm vi trách nhiệm&lt;/b&gt;&lt;br&gt;Bộ chuyển mạch không đọc được địa chỉ IP và không tham gia vào quyết định định tuyến. Nó chỉ chuyển khung giữa các cổng trong cùng một miền quảng bá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3880" y="1368" width="480" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4454" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;b&gt;Bộ định tuyến biên — NAT Outbound&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Biên dịch địa chỉ và cổng nguồn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="4500" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="&lt;b&gt;Việc diễn ra — tráo nhãn chiều đi&lt;/b&gt;&lt;br&gt;① Tháo khung lớp 2 vừa nhận.&lt;br&gt;② Đọc gói tin lớp 3 và đoạn lớp 4.&lt;br&gt;③ &lt;b&gt;Ghi đè&lt;/b&gt; địa chỉ nguồn riêng bằng địa chỉ công cộng của chính thiết bị.&lt;br&gt;④ &lt;b&gt;Ghi đè&lt;/b&gt; cổng nguồn bằng một cổng còn trống của thiết bị.&lt;br&gt;⑤ Lưu ánh xạ vào &lt;b&gt;bảng phiên NAT&lt;/b&gt;.&lt;br&gt;⑥ Dựng khung lớp 2 mới hướng ra tuyến của nhà cung cấp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="550" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="&lt;b&gt;Bảng phiên NAT sau bước này&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:10px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Bên ngoài&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Bên trong&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;14.22.33.44:33333&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;192.168.1.5:51000&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;14.22.33.44:33334&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;192.168.1.9:49800&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;14.22.33.44:33335&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;192.168.1.5:51001&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Cổng bên ngoài là khoá phân biệt. Nhờ nó, nhiều thiết bị dùng chung một địa chỉ công cộng mà lưu lượng trả về vẫn tới đúng nơi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="862" width="480" height="292" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="&lt;b&gt;Vì sao gọi là PAT&lt;/b&gt;&lt;br&gt;Thiết bị không chỉ biên dịch địa chỉ mà biên dịch &lt;b&gt;cả cổng&lt;/b&gt;. Nếu chỉ đổi địa chỉ thì hai máy nội bộ cùng dùng cổng nguồn 51000 sẽ không phân biệt được khi lưu lượng quay về.&lt;br&gt;&lt;br&gt;Chính vì vậy cơ chế đầy đủ được gọi là biên dịch địa chỉ và cổng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="1166" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;Hệ quả kiến trúc&lt;/b&gt;&lt;br&gt;Kết nối chỉ thiết lập được theo chiều từ trong ra. Thiết bị bên ngoài không thể chủ động mở kết nối vào máy nội bộ vì chưa có mục nào trong bảng phiên để tra cứu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="4500" y="1446" width="480" height="212" as="geometry" />
        </mxCell>
        <mxCell id="n72" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5074" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n73" value="&lt;b&gt;Mạng nhà cung cấp dịch vụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hệ thống tự trị — AS, điểm hiện diện&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5120" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n74" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Gói tin đi vào mạng của nhà cung cấp và được chuyển tiếp qua chuỗi thiết bị định tuyến tới điểm hiện diện gần nhất, rồi ra đường trục.&lt;br&gt;&lt;br&gt;Tại mỗi chặng, quy trình lặp lại: tháo lớp 2, đọc lớp 3, tra bảng định tuyến, dựng lớp 2 mới." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="550" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n75" value="&lt;b&gt;Hệ thống tự trị&lt;/b&gt;&lt;br&gt;Internet là tập hợp hàng vạn mạng độc lập, mỗi mạng do một tổ chức vận hành và mang một mã định danh riêng.&lt;br&gt;&lt;br&gt;Nhà cung cấp trong nước là một hệ thống tự trị. Nhà cung cấp dịch vụ đám mây là một hệ thống tự trị khác. Chúng phải thoả thuận với nhau để lưu lượng đi qua được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="830" width="480" height="278" as="geometry" />
        </mxCell>
        <mxCell id="n76" value="&lt;b&gt;Hai loại tài nguyên khác nhau&lt;/b&gt;&lt;br&gt;&lt;b&gt;Địa chỉ IP và mã định danh&lt;/b&gt; — tài nguyên logic, do tổ chức quản lý toàn cầu cấp phát.&lt;br&gt;&lt;b&gt;Băng thông đường truyền&lt;/b&gt; — tài nguyên vật lý, thuộc về đơn vị sở hữu tuyến cáp.&lt;br&gt;&lt;br&gt;Có địa chỉ nhưng không có tuyến truyền dẫn thì dữ liệu vẫn không đi được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="1120" width="480" height="258" as="geometry" />
        </mxCell>
        <mxCell id="n77" value="&lt;b&gt;Điểm cần nắm khi vận hành&lt;/b&gt;&lt;br&gt;Toàn bộ chặng này nằm ngoài phạm vi kiểm soát của hệ thống. Độ trễ và tỷ lệ mất gói ở đây chỉ có thể đo lường và thích ứng, không thể điều chỉnh trực tiếp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5120" y="1390" width="480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n78" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5694" y="426" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n79" value="&lt;b&gt;Định tuyến liên mạng — BGP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Chọn tuyến giữa các hệ thống tự trị&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="5740" y="380" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n80" value="&lt;b&gt;Việc diễn ra&lt;/b&gt;&lt;br&gt;Các thiết bị định tuyến biên trao đổi thông tin khả đạt bằng giao thức BGP: mỗi bên loan báo những dải địa chỉ có thể tới được thông qua tuyến của bên đó.&lt;br&gt;&lt;br&gt;Từ các loan báo này, mỗi mạng dựng nên bản đồ đường đi tới mọi dải địa chỉ trên Internet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="550" width="480" height="268" as="geometry" />
        </mxCell>
        <mxCell id="n81" value="&lt;b&gt;Tiêu chí chọn tuyến&lt;/b&gt;&lt;br&gt;Không phải băng thông, cũng không phải độ trễ, mà là độ dài chuỗi hệ thống tự trị và &lt;b&gt;chính sách thương mại&lt;/b&gt;:&lt;br&gt;&lt;br&gt;• &lt;b&gt;Peering&lt;/b&gt; — hai mạng nối trực tiếp tại điểm trung chuyển, không phát sinh cước. Được ưu tiên.&lt;br&gt;• &lt;b&gt;Transit&lt;/b&gt; — thuê nhà cung cấp cấp một vận chuyển, tính cước theo dung lượng. Chỉ dùng khi tuyến peering không khả dụng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="830" width="480" height="312" as="geometry" />
        </mxCell>
        <mxCell id="n82" value="&lt;b&gt;Rủi ro đã xảy ra trong thực tế&lt;/b&gt;&lt;br&gt;Cấu hình BGP sai có thể làm toàn bộ dải địa chỉ của một tổ chức biến mất khỏi bảng định tuyến toàn cầu.&lt;br&gt;&lt;br&gt;Khi đó dịch vụ vẫn chạy bình thường bên trong nhưng không ai trên Internet tìm được đường tới — biểu hiện giống hệt sự cố hạ tầng toàn diện." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="1154" width="480" height="252" as="geometry" />
        </mxCell>
        <mxCell id="n83" value="&lt;b&gt;Kết thúc chặng I&lt;/b&gt;&lt;br&gt;Gói tin đã tới được hệ thống tự trị của nhà cung cấp dịch vụ biên. Từ đây bắt đầu chặng II: xử lý tại biên và đi vào hạ tầng đám mây." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="5740" y="1418" width="480" height="216" as="geometry" />
        </mxCell>
