        </mxCell>
        <mxCell id="n287" value="&lt;b&gt;Khuyến nghị sử dụng.&lt;/b&gt; Không xung đột với thiết bị mạng gia đình hoặc mạng ảo mặc định." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
