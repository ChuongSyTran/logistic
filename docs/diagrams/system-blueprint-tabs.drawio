        </mxCell>
        <mxCell id="e1000" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1966" y="266" as="sourcePoint" />
            <mxPoint x="2032" y="266" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1001" value="&lt;b&gt;Vì sao dùng MQTT cho thiết bị đầu cuối.&lt;/b&gt; Giao thức có phần tiêu đề rất nhỏ, phù hợp đường truyền di động và thiết bị hạn chế năng lượng. NATS tích hợp sẵn bộ xử lý MQTT nên không cần dựng thêm thành phần trung gian: thông điệp từ thiết bị được chuyển thẳng thành luồng nội bộ để tầng ứng dụng tiêu thụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="340" width="1160" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1002" value="&lt;b&gt;Vai trò của cầu nối hai chiều.&lt;/b&gt; Dữ liệu được đưa vào NATS để đạt độ trễ thấp nhất, đồng thời được sao chép sang Kafka để có khả năng lưu trữ dài hạn và phát lại. Thành phần này được cấu hình khai báo, không yêu cầu viết mã đồng bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1266" y="340" width="1150" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1003" value="&lt;b&gt;Phân định phạm vi sử dụng giữa hai nền tảng&lt;/b&gt;&lt;br&gt;• &lt;b&gt;NATS&lt;/b&gt; — tín hiệu tức thời, tần suất cao, giá trị suy giảm nhanh theo thời gian: toạ độ phương tiện, trạng thái sẵn sàng của tài xế, cập nhật giao diện thời gian thực.&lt;br&gt;• &lt;b&gt;Kafka&lt;/b&gt; — sự kiện nghiệp vụ cần đối soát, phát lại và lưu vết: giao dịch ví, sự kiện ghép chuyến, luồng đồng bộ sang mô hình đọc.&lt;br&gt;&lt;b&gt;Tiêu chí quyết định:&lt;/b&gt; nếu mất một thông điệp gây sai lệch số liệu nghiệp vụ thì dùng Kafka; nếu chỉ làm chậm cập nhật hiển thị thì dùng NATS." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="448" width="2340" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n1004" value="B · CƠ CHẾ XÁC THỰC KHÔNG PHỤ THUỘC CƠ SỞ DỮ LIỆU" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
