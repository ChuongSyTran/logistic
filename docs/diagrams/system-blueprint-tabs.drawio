        <mxCell id="e684" value="đệm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b8860b;strokeWidth=2;dashed=1;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n670" target="n681">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n685" value="&lt;b&gt;Quy tắc phụ thuộc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giao diện trừu tượng được &lt;b&gt;khai báo tại tầng nghiệp vụ&lt;/b&gt; và được &lt;b&gt;hiện thực hoá tại tầng truy cập dữ liệu&lt;/b&gt;. Chiều phụ thuộc vì thế hướng vào trong, ngược với chiều gọi hàm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ba hệ quả trực tiếp&lt;/b&gt;&lt;br&gt;• Kiểm thử tầng nghiệp vụ không cần cơ sở dữ liệu — chỉ cần một cài đặt giả thoả mãn giao diện.&lt;br&gt;• Thay đổi hệ quản trị cơ sở dữ liệu chỉ tác động tới tầng truy cập dữ liệu.&lt;br&gt;• Vị trí của lỗi được xác định theo tầng: sai quy tắc tính toán thuộc tầng nghiệp vụ, truy vấn chậm thuộc tầng truy cập dữ liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1036" y="282" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n686" value="&lt;b&gt;Dấu hiệu vi phạm kiến trúc&lt;/b&gt;&lt;br&gt;Xuất hiện câu lệnh SQL, tên bảng hoặc lời gọi thư viện truy cập dữ liệu bên trong thư mục &lt;code&gt;biz/&lt;/code&gt;. Khi đó tầng nghiệp vụ đã bị ràng buộc vào công nghệ lưu trữ và mất khả năng kiểm thử độc lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1036" y="598" width="480" height="124" as="geometry" />
        </mxCell>
        <mxCell id="n687" value="&lt;b&gt;Các thành phần bổ trợ:&lt;/b&gt; &lt;code&gt;internal/di&lt;/code&gt; lắp ráp toàn bộ đối tượng và là điểm khởi đầu để đọc mã nguồn · &lt;code&gt;internal/entity&lt;/code&gt; mô tả thực thể nghiệp vụ thuần tuý · &lt;code&gt;internal/dto&lt;/code&gt; mô tả cấu trúc trao đổi với bên ngoài · &lt;code&gt;internal/mapper&lt;/code&gt; chuyển đổi giữa hai dạng · &lt;code&gt;internal/conf&lt;/code&gt; đọc cấu hình từ biến môi trường." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="852" width="1440" height="44" as="geometry" />
        </mxCell>
