        <mxCell id="n362" value="Kafka · NATS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1066" width="170" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n363" value="Chỉ có địa chỉ riêng. Không tồn tại tuyến khả đạt từ Internet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2048" y="1066" width="400" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n364" value="&lt;b&gt;Bảng định tuyến&lt;/b&gt;&lt;br&gt;&lt;code&gt;10.0.0.0/16 → local&lt;/code&gt;&lt;br&gt;&lt;code&gt;0.0.0.0/0 → nat-id&lt;/code&gt; — trỏ tới NAT Gateway thay vì Internet Gateway.&lt;br&gt;Kết quả: tài nguyên khởi tạo được kết nối ra ngoài, nhưng kết nối từ Internet vào không có tuyến trả về." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1454" y="1142" width="994" height="142" as="geometry" />
        </mxCell>
        <mxCell id="n365" value="&lt;b&gt;Ranh giới cần nhớ:&lt;/b&gt; VPC trải qua nhiều Availability Zone, nhưng mỗi Subnet nằm trọn trong đúng một Zone. Khả năng chịu lỗi chỉ đạt được khi tài nguyên được đặt tại tối thiểu hai Zone và có bộ cân bằng tải phía trước." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="286" y="1300" width="2230" height="34" as="geometry" />
        </mxCell>
