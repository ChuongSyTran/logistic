          <mxGeometry x="1340" y="1462" width="34" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n392" value="Bastion Host&lt;br&gt;Public Subnet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1464" width="190" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n393" value="Kafka · Cơ sở dữ liệu&lt;br&gt;Private Subnet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
