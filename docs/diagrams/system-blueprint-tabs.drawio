        </mxCell>
        <mxCell id="n447" value="&lt;b&gt;Vai trò của hai chuỗi ngẫu nhiên.&lt;/b&gt; Chúng khiến khoá phiên khác nhau ở mỗi lần bắt tay, vô hiệu hoá việc ghi lại và phát lại gói tin đã bắt được ở phiên trước." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
