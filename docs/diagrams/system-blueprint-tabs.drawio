        </mxCell>
        <mxCell id="e476" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n470" target="n471">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n477" value="&lt;b&gt;Chuỗi tin cậy.&lt;/b&gt; Hệ điều hành không lưu danh sách tên miền mà chỉ lưu khoảng một trăm tới hai trăm khoá công khai của các tổ chức chứng thực gốc trong kho Trust Store.&lt;br&gt;&lt;br&gt;Khi nhận chứng thư của một tên miền chưa từng biết, client kiểm tra chữ ký trên chứng thư bằng khoá gốc có sẵn. Chữ ký hợp lệ đồng nghĩa với việc một tổ chức đã được tin cậy đứng ra bảo chứng cho khoá công khai đó.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả:&lt;/b&gt; chỉ cần cập nhật hệ điều hành khi có tổ chức chứng thực mới được công nhận hoặc bị thu hồi công nhận, không phải khi có tên miền mới. Thay đổi dù chỉ một ký tự trong chứng thư cũng làm chữ ký mất hiệu lực và kết nối bị từ chối." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="838" width="1008" height="174" as="geometry" />
        </mxCell>
        <mxCell id="n478" value="D · MÔ HÌNH PHÒNG THỦ NHIỀU LỚP" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="n479" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="76" y="1140" width="140" height="84" as="geometry" />
        </mxCell>
