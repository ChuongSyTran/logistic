          <mxGeometry x="1866" y="648" width="110" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n715" value="Gửi thông báo. Đóng vai trò consumer của Kafka và NATS. Đang phát triển." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1976" y="648" width="548" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n716" value="&lt;b&gt;Nguyên tắc phân tách dữ liệu.&lt;/b&gt; Mỗi dịch vụ sở hữu cơ sở dữ liệu riêng và không truy cập trực tiếp vào dữ liệu của dịch vụ khác; mọi trao đổi diễn ra qua giao diện gRPC hoặc thông điệp bất đồng bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1616" y="848" width="908" height="44" as="geometry" />
        </mxCell>
