        <mxCell id="n871" value="Partition 1 — Leader" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="282" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n872" value="Partition 0 — Bản sao" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="332" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n873" value="Broker 103" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="226" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n874" value="Partition 2 — Leader" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="282" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n875" value="Partition 1 — Bản sao" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="332" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n876" value="Mỗi Broker chỉ giữ phần dữ liệu được phân công. Một chủ đề có ít phân vùng hơn số Broker sẽ không xuất hiện trên toàn bộ các nút — đây là trạng thái bình thường." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="388" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n877" value="Khái niệm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="866" y="186" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n878" value="Định nghĩa và mục đích" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1056" y="186" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n879" value="Partition" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="866" y="216" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n880" value="&lt;b&gt;Chia nhỏ dữ liệu để xử lý song song.&lt;/b&gt; Một chủ đề 100 GB chia thành hai phân vùng thì mỗi phân vùng giữ 50 GB &lt;b&gt;dữ liệu khác nhau&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1056" y="216" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n881" value="Replication Factor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="866" y="304" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n882" value="&lt;b&gt;Sao chép nguyên vẹn để chống mất mát.&lt;/b&gt; Hệ số bằng 2 nghĩa là toàn bộ dữ liệu của phân vùng 0 có thêm một bản sao đặt trên Broker khác. Bản sao của phân vùng 0 vẫn là phân vùng 0." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1056" y="304" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n883" value="Offset" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="866" y="392" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n884" value="Số thứ tự tăng dần trong phạm vi &lt;b&gt;một phân vùng&lt;/b&gt;. Offset 3 ở phân vùng 0 và offset 3 ở phân vùng 1 là hai bản ghi khác nhau." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1056" y="392" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n885" value="&lt;b&gt;Bốn tính chất chi phối mọi thiết kế trên Kafka&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Bất biến.&lt;/b&gt; Dữ liệu đã ghi không thể sửa hoặc xoá từng bản ghi như trong cơ sở dữ liệu quan hệ.&lt;br&gt;② &lt;b&gt;Thứ tự cục bộ.&lt;/b&gt; Trình tự chỉ được bảo đảm trong phạm vi một phân vùng, không tồn tại trình tự toàn cục trên chủ đề.&lt;br&gt;③ &lt;b&gt;Không truy vấn được.&lt;/b&gt; Không có cơ chế lọc theo điều kiện; cách duy nhất lấy dữ liệu là đọc tuần tự bằng consumer. Đây là điểm khiến Kafka không thể thay thế cơ sở dữ liệu.&lt;br&gt;④ &lt;b&gt;Thông lượng cao nhờ ghi tuần tự.&lt;/b&gt; Dữ liệu chỉ được nối thêm vào cuối tệp, và được truyền thẳng từ bộ đệm đĩa ra giao diện mạng mà không sao chép qua vùng nhớ ứng dụng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="496" width="1548" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n886" value="B · LUỒNG GHI CỦA PRODUCER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1620" height="520" as="geometry" />
        </mxCell>
        <mxCell id="n887" value="Thông điệp" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="800" width="180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n888" value="Có khoá&lt;br&gt;phân vùng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
