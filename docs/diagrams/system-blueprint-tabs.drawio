        <mxCell id="e898" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n891" target="n892">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n899" value="Thông điệp cùng khoá luôn tới cùng một phân vùng — điều kiện duy nhất để bảo toàn trình tự cho một thực thể nghiệp vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="576" y="926" width="540" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n900" value="acks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="916" width="110" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n901" value="Điều kiện xác nhận và rủi ro" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1240" y="916" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n902" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="944" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n903" value="Không chờ phản hồi. Thông lượng cao nhất, nguy cơ mất dữ liệu lớn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="944" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n904" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="996" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n905" value="Chờ Leader ghi xong. Mất dữ liệu nếu Leader dừng trước khi bản sao kịp đồng bộ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="996" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n906" value="all" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1048" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n907" value="Chờ toàn bộ bản sao đồng bộ xác nhận. Chậm nhất, không mất dữ liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1048" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n908" value="&lt;b&gt;Chống ghi trùng lặp&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khi Broker đã nhận thông điệp nhưng phản hồi xác nhận bị mất trên đường về, producer sẽ gửi lại và sinh ra bản ghi trùng.&lt;br&gt;&lt;br&gt;Bật &lt;code&gt;enable.idempotence&lt;/code&gt; khiến mỗi thông điệp mang một định danh producer và số thứ tự. Broker phát hiện số thứ tự đã xử lý sẽ loại bỏ bản trùng.&lt;br&gt;&lt;br&gt;&lt;b&gt;Phạm vi hiệu lực:&lt;/b&gt; cơ chế này chỉ bảo đảm không trùng &lt;b&gt;khi ghi vào Kafka&lt;/b&gt;. Việc consumer xử lý lặp là bài toán riêng, trình bày ở mục C." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1000" width="480" height="202" as="geometry" />
        </mxCell>
        <mxCell id="n909" value="C · LUỒNG ĐỌC, GHI NHẬN TIẾN ĐỘ VÀ TÁI CÂN BẰNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
