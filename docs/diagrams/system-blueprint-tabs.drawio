        <mxCell id="n726" value="Lý do" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="376" y="1094" width="1140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n727" value="Không đổi số hiệu trường đã phát hành" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1124" width="300" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n728" value="Số hiệu là định danh thật khi mã hoá nhị phân; tên trường không tham gia vào quá trình này." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1124" width="1140" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n729" value="Không tái sử dụng số hiệu đã xoá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1178" width="300" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n730" value="Client phiên bản cũ sẽ diễn giải sai dữ liệu. Đánh dấu &lt;code&gt;reserved&lt;/code&gt; thay vì dùng lại." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1178" width="1140" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n731" value="Trường mới phải là tuỳ chọn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1232" width="300" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n732" value="Cho phép triển khai máy chủ trước và cập nhật client sau mà không gây gián đoạn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1232" width="1140" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n733" value="&lt;b&gt;Cơ chế tương thích ngược.&lt;/b&gt; Client gặp trường chưa biết sẽ bỏ qua thay vì báo lỗi. Nhờ đó lược đồ có thể mở rộng dần mà không cần đồng bộ thời điểm triển khai giữa các thành phần — điều kiện bắt buộc trong hệ thống nhiều dịch vụ độc lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1316" width="1440" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n734" value="D · TỔ CHỨC KHO MÃ NGUỒN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#56517e;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#56517e;" vertex="1" parent="1">
