        </mxCell>
        <mxCell id="n798" value="&lt;b&gt;Khoảng thời gian giữa bước 2 và bước 5&lt;/b&gt; là cửa sổ không nhất quán. Độ dài dao động từ vài mili-giây tới vài giây tuỳ tải và độ trễ mạng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1616" y="636" width="908" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n799" value="C · TRÌNH TỰ KHỞI TẠO CỤM NHÂN BẢN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1500" height="520" as="geometry" />
        </mxCell>
        <mxCell id="n800" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="796" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n801" value="Mạng nội bộ dùng chung" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="124" y="766" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n802" value="Hai nút giải tên nhau qua tên dịch vụ thay vì địa chỉ IP cố định." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="444" y="766" width="1064" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n803" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="906" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n804" value="Cấu hình máy chủ chính" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="124" y="876" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n805" value="&lt;code&gt;wal_level = replica&lt;/code&gt; bật định dạng nhật ký phù hợp để truyền đi. &lt;code&gt;max_wal_senders&lt;/code&gt; giới hạn số bản sao kết nối đồng thời." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="444" y="876" width="1064" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n806" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1016" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n807" value="Cấp quyền nhân bản" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="124" y="986" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n808" value="Tạo tài khoản chuyên dụng có quyền replication và bổ sung luật cho phép kết nối trong &lt;code&gt;pg_hba.conf&lt;/code&gt; với cơ chế xác thực SCRAM-SHA-256." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="444" y="986" width="1064" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n809" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1126" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n810" value="Khởi tạo bản sao" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="124" y="1096" width="300" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n811" value="Nếu thư mục dữ liệu trống, thực thi &lt;code&gt;pg_basebackup&lt;/code&gt; để sao chép toàn bộ trạng thái ban đầu, sau đó bàn giao tiến trình chính lại cho bộ máy lưu trữ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="444" y="1096" width="1064" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n812" value="D · TUỲ CHỌN NÂNG CAO CHO MÔI TRƯỜNG TẢI CAO" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1580" y="710" width="980" height="520" as="geometry" />
        </mxCell>
        <mxCell id="n813" value="Cơ chế" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="762" width="240" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n814" value="Vấn đề giải quyết và chi phí đi kèm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1856" y="762" width="668" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n815" value="Nhân bản đồng bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="794" width="240" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n816" value="Mặc định máy chủ chính xác nhận ngay sau khi ghi cục bộ, chưa cần bản sao phản hồi — nếu sự cố xảy ra đúng thời điểm đó thì dữ liệu bị mất. Bật &lt;code&gt;synchronous_standby_names&lt;/code&gt; buộc chờ xác nhận từ bản sao, đổi lại thông lượng ghi giảm." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1856" y="794" width="668" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n817" value="Khe nhân bản" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="932" width="240" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n818" value="Khi bản sao mất kết nối dài, máy chủ chính có thể đã xoá nhật ký cũ khiến bản sao không đồng bộ tiếp được. Khe nhân bản giữ lại nhật ký chưa được xác nhận. &lt;b&gt;Rủi ro:&lt;/b&gt; khe không được thu hồi sau khi bản sao ngừng hoạt động vĩnh viễn sẽ làm đầy đĩa máy chủ chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1856" y="932" width="668" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n819" value="Lớp gom kết nối" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1070" width="240" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n820" value="Khi có nhiều bản sao, ứng dụng khó tự chọn đích đọc. Lớp proxy đảm nhiệm phân tải, chuyển đổi dự phòng tự động và gom kết nối để tránh vượt giới hạn kết nối đồng thời của hệ quản trị." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1856" y="1070" width="668" height="138" as="geometry" />
        </mxCell>
        <mxCell id="n821" value="E · QUY TRÌNH ĐỌC QUA BỘ NHỚ ĐỆM" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
