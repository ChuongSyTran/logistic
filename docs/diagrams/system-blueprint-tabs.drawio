        </mxCell>
        <mxCell id="n738" value="Định nghĩa giao diện, mã sinh tự động và tài liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1866" y="1036" width="658" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n739" value="&lt;code&gt;pkg/tracer&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
