        </mxCell>
        <mxCell id="n740" value="Khởi tạo OpenTelemetry dùng chung (tab 10)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1866" y="1080" width="658" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n741" value="&lt;code&gt;pkg/ent&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1124" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n742" value="Cấu hình và tiện ích cho lớp ORM." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1866" y="1124" width="658" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n743" value="&lt;code&gt;pkg/i18n&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1168" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n744" value="Đa ngôn ngữ cho thông báo trả về." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1866" y="1168" width="658" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n745" value="&lt;code&gt;pkg/concurrencyUtils&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1212" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n746" value="Nhóm tiến trình xử lý nền, dùng cho mô hình Outbox (tab 09)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1866" y="1212" width="658" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n747" value="&lt;b&gt;Đánh đổi của mô hình kho mã hợp nhất&lt;/b&gt;&lt;br&gt;&lt;b&gt;Thuận lợi:&lt;/b&gt; một lần thay đổi có thể cập nhật đồng thời định nghĩa giao diện và mọi bên sử dụng, loại bỏ nguy cơ lệch phiên bản. Thư viện dùng chung có hiệu lực ngay mà không cần phát hành phiên bản riêng.&lt;br&gt;&lt;b&gt;Chi phí:&lt;/b&gt; mỗi mô-đun vẫn giữ tệp phụ thuộc riêng và cần được rà soát độc lập; không gian làm việc chung có thể che khuất thiếu sót, nên bước kiểm tra ở tab 04·C là bắt buộc." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1256" width="908" height="136" as="geometry" />
        </mxCell>
        <mxCell id="n748" value="E · CÁC QUYẾT ĐỊNH THIẾT KẾ VÀ CƠ SỞ LỰA CHỌN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1450" width="2520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="n749" value="Quyết định" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1500" width="300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n750" value="Cơ sở lựa chọn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="376" y="1500" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n751" value="Chi phí phải chấp nhận" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1500" width="1444" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n752" value="gRPC cho giao tiếp nội bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1532" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n753" value="Mã hoá nhị phân, lược đồ ràng buộc chặt, ghép luồng trên một kết nối TCP." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1532" width="700" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n754" value="Khó quan sát bằng công cụ thông thường; cần công cụ chuyên dụng khi chẩn đoán." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1532" width="1444" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n755" value="Cơ sở dữ liệu riêng theo dịch vụ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1610" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n756" value="Giới hạn phạm vi ảnh hưởng khi sự cố, cho phép chọn công nghệ lưu trữ theo đặc thù nghiệp vụ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1610" width="700" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n757" value="Không thực hiện được phép nối bảng giữa các miền dữ liệu; phải tổng hợp ở tầng ứng dụng hoặc qua mô hình đọc riêng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1610" width="1444" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n758" value="Đảo ngược phụ thuộc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1688" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n759" value="Tầng nghiệp vụ kiểm thử được độc lập; thay đổi công nghệ lưu trữ không lan sang nghiệp vụ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1688" width="700" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n760" value="Tăng số lượng tệp và mức trừu tượng; chi phí này chỉ hoàn vốn khi hệ thống đủ lớn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1688" width="1444" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
