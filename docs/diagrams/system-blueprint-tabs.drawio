        </mxCell>
        <mxCell id="n248" value="Phân giải địa chỉ MAC bằng ARP (mục B), sau đó truyền thẳng trong mạng cục bộ. Không có thiết bị lớp 3 tham gia." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="626" y="984" width="574" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n249" value="&lt;b&gt;Lựa chọn đường đi giữa các mạng — giao thức BGP&lt;/b&gt;&lt;br&gt;Internet là tập hợp hàng vạn hệ thống tự trị (Autonomous System) độc lập, mỗi đơn vị mang một mã định danh ASN riêng. Các bộ định tuyến biên trao đổi thông tin khả đạt bằng BGP.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tiêu chí chọn tuyến không phải là băng thông hay độ trễ&lt;/b&gt;, mà là độ dài chuỗi AS và trên hết là chính sách thương mại:&lt;br&gt;• &lt;b&gt;Peering&lt;/b&gt; — hai hệ thống kết nối trực tiếp tại điểm trung chuyển, không phát sinh cước. Được ưu tiên.&lt;br&gt;• &lt;b&gt;Transit&lt;/b&gt; — thuê nhà cung cấp cấp một vận chuyển lưu lượng, tính cước theo dung lượng. Chỉ dùng khi tuyến peering không khả dụng.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rủi ro vận hành.&lt;/b&gt; Cấu hình BGP sai có thể khiến toàn bộ dải địa chỉ của một tổ chức biến mất khỏi bảng định tuyến toàn cầu, dẫn tới gián đoạn dịch vụ trên phạm vi thế giới." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1150" width="1124" height="254" as="geometry" />
        </mxCell>
        <mxCell id="n250" value="D · QUY TRÌNH BIÊN DỊCH ĐỊA CHỈ NAT / PAT" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
