          <mxGeometry x="2106" y="364" width="438" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n464" value="&lt;b&gt;Cách TLS kết hợp hai mô hình.&lt;/b&gt; Mã hoá bất đối xứng chỉ được dùng trong vài mili-giây đầu, với mục đích duy nhất là truyền an toàn khoá đối xứng (bước 8 ở mục A). Ngay khi cả hai phía cùng sở hữu khoá phiên, toàn bộ dữ liệu còn lại được mã hoá bằng thuật toán đối xứng.&lt;br&gt;&lt;b&gt;Kết quả:&lt;/b&gt; đạt được tính an toàn của mô hình thứ nhất và thông lượng của mô hình thứ hai." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="448" width="1008" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n465" value="C · QUY TRÌNH CẤP PHÁT VÀ XÁC THỰC CHỨNG THƯ SỐ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1500" y="600" width="1080" height="430" as="geometry" />
        </mxCell>
