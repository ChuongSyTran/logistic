        </mxCell>
        <mxCell id="n470" value="CA ký bằng khoá bí mật gốc ⇒ Chứng thư X.509" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="758" width="490" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n471" value="Máy chủ cài đặt chứng thư, sử dụng ở bước 6 mục A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2056" y="758" width="490" height="56" as="geometry" />
