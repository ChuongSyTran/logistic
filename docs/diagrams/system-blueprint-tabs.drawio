        <mxCell id="n67" value="Giới hạn tần suất" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="180" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="Địa chỉ máy chủ gốc&lt;br&gt;không lộ ra Internet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="688" y="372" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="&lt;b&gt;Vai trò của lớp biên&lt;/b&gt;&lt;br&gt;Uỷ quyền phân giải tên miền cho Cloudflare cho phép toàn bộ lưu lượng đi qua mạng biên trước khi tới hạ tầng gốc. Tại đây phiên TLS được kết thúc để giải mã và kiểm tra nội dung lớp 7, sau đó thiết lập phiên mã hoá mới hướng về máy chủ gốc.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả vận hành:&lt;/b&gt; lớp proxy chỉ xử lý HTTP và HTTPS. Các giao thức khác — trong đó có SSH cổng 22 — phải kết nối trực tiếp tới địa chỉ công cộng của máy chủ, không qua tên miền." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="336" width="1188" height="140" as="geometry" />
        </mxCell>
