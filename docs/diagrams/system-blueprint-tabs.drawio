        <mxCell id="e487" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n482" target="n483">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n488" value="Yêu cầu hợp lệ&lt;br&gt;được phục vụ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1206" y="1150" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n489" value="Đọc toàn bộ tải trọng HTTP: thân JSON, tham số URL, tiêu đề, cookie. Chặn mã tiêm SQL và kịch bản chéo trang, giới hạn tần suất, phát hiện tác tử tự động." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="256" y="1234" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n490" value="Chỉ đọc phần tiêu đề gói tin: địa chỉ nguồn, địa chỉ đích, cổng. Không kiểm tra tải trọng. Chỉ mở cổng 80 và 443." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="516" y="1234" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n491" value="Không có tuyến khả đạt từ Internet. Chỉ chấp nhận kết nối tới cổng cơ sở dữ liệu từ đúng địa chỉ riêng của tầng ứng dụng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="776" y="1234" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n492" value="&lt;b&gt;Nguyên tắc thiết kế.&lt;/b&gt; Mỗi lớp kiểm tra một khía cạnh khác nhau và không lớp nào đủ để thay thế lớp còn lại. Lưu lượng mang mã tiêm SQL vẫn hợp lệ với tường lửa lớp 4 vì nó đi đúng cổng 443; ngược lại, WAF không thể ngăn truy cập trực tiếp vào cổng cơ sở dữ liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1046" y="1234" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n493" value="&lt;b&gt;Nguyên tắc quyền tối thiểu.&lt;/b&gt; Mọi kết nối vào từ Internet bị chặn theo mặc định; chỉ các cổng thực sự cần thiết được mở, và mở cho phạm vi nguồn hẹp nhất có thể. Cổng của cơ sở dữ liệu và bộ nhớ đệm không bao giờ được mở ra Internet. Giao thức ICMP được vô hiệu hoá để hạn chế khả năng dò quét hạ tầng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1382" width="1350" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n494" value="E · CẤP QUYỀN TRUY CẬP TẠM THỜI TRONG TỰ ĐỘNG HOÁ TRIỂN KHAI" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#56517e;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#56517e;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1060" width="1080" height="420" as="geometry" />
        </mxCell>
        <mxCell id="n495" value="&lt;b&gt;Vấn đề.&lt;/b&gt; Quy tắc an toàn yêu cầu cổng 22 chỉ mở cho dải địa chỉ quản trị cố định. Tuy nhiên tác tử chạy tiến trình triển khai được cấp địa chỉ công cộng ngẫu nhiên ở mỗi lần thực thi, nên bị tường lửa từ chối." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1112" width="1008" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n496" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1214" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n497" value="Xác định địa chỉ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1578" y="1206" width="230" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n498" value="Tiến trình truy vấn địa chỉ công cộng hiện hành của chính nó." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1818" y="1206" width="726" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n499" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1276" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n500" value="Cấp quyền" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
