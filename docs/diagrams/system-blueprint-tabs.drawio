        <mxCell id="n1224" value="&lt;b&gt;Cách đọc biểu đồ&lt;/b&gt;&lt;br&gt;Ba span con giống hệt nhau lặp lại ở cùng một mức cho thấy truy vấn được gọi trong vòng lặp thay vì gộp thành một lần — dạng lỗi hiệu năng chỉ phát hiện được qua biểu đồ vết, không thấy trong nhật ký hay chỉ số tổng hợp." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2060" y="304" width="416" height="152" as="geometry" />
        </mxCell>
        <mxCell id="n1225" value="&lt;b&gt;Điều kiện để vết không bị đứt đoạn.&lt;/b&gt; Định danh vết phải được đưa vào &lt;b&gt;metadata của lời gọi gRPC&lt;/b&gt; khi sang dịch vụ khác, và vào &lt;b&gt;tiêu đề thông điệp&lt;/b&gt; khi phát sang hàng đợi. Thiếu một mắt xích, phần còn lại của hệ thống trở nên không quan sát được — đây là hạng mục quan trọng nhất còn tồn đọng trong lộ trình ở mục C." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="556" width="2400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1226" value="B · THƯ VIỆN DÙNG CHUNG VÀ ĐIỂM GẮN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
