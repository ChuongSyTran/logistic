        <mxCell id="n1234" value="Cho phép ngữ cảnh vết đi kèm lời gọi mạng — thành phần quyết định tính liên tục của vết." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
