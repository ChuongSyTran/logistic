        <mxCell id="n89" value="EC2 — Ubuntu 24.04 LTS · ổ đĩa gp3 30 GB · địa chỉ công cộng tĩnh (Elastic IP)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=12;strokeColor=#d79b00;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
