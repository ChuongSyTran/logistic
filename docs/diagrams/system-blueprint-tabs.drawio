        </mxCell>
        <mxCell id="n604" value="Đảo ngược đồ thị phụ thuộc và thu hồi toàn bộ tài nguyên theo thứ tự an toàn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="316" y="1260" width="928" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n605" value="&lt;b&gt;Nguyên tắc.&lt;/b&gt; Tài nguyên tồn tại trên hạ tầng nhưng không được mô tả trong mã nguồn là nợ kỹ thuật: không tái lập được, không kiểm soát được thay đổi và không thu hồi tự động được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1310" width="1168" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n606" value="C · QUY TRÌNH DỰNG ẢNH CONTAINER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#56517e;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#56517e;" vertex="1" parent="1">
          <mxGeometry x="1340" y="866" width="1240" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n607" value="Giai đoạn 1 — Builder&lt;br&gt;&lt;code&gt;golang:alpine&lt;/code&gt;&lt;br&gt;&lt;i&gt;biên dịch thành tệp nhị phân tĩnh&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
