        <mxCell id="n1201" value="OBSERVABILITY — THEO VẾT MỘT YÊU CẦU QUA NHIỀU TIẾN TRÌNH" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=27;fontStyle=1;fontColor=#12314f;" vertex="1" parent="1">
          <mxGeometry x="152" y="16" width="2040" height="51" as="geometry" />
        </mxCell>
        <mxCell id="n1202" value="Trong hệ thống nhiều dịch vụ độc lập, một yêu cầu đi qua nhiều tiến trình khác nhau. Nhật ký cục bộ của từng tiến trình không đủ để xác định nguyên nhân sự cố." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a5b6a;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="154" y="68" width="2040" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1203" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
