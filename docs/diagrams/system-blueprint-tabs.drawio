        </mxCell>
        <mxCell id="n501" value="&lt;code&gt;authorize-security-group-ingress&lt;/code&gt; mở cổng 22 cho riêng địa chỉ đó." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1818" y="1268" width="726" height="46" as="geometry" />
        </mxCell>
