        <mxCell id="n1028" value="Account" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1666" y="740" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n1029" value="Một tổ chức hoặc đơn vị nghiệp vụ. Ranh giới cách ly." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
