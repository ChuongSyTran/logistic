          <mxGeometry x="1246" y="1300" width="176" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n922" value="Hệ quả" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1422" y="1300" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n923" value="Trước khi xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1056" y="1328" width="190" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n924" value="At-most-once" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=9;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1246" y="1328" width="176" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n925" value="Mất thông điệp nếu tiến trình dừng giữa chừng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=9;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1422" y="1328" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n926" value="Sau khi xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1056" y="1390" width="190" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n927" value="At-least-once" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=9;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1246" y="1390" width="176" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n928" value="Có thể xử lý lặp. &lt;b&gt;Bắt buộc xử lý bất biến.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=9;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1422" y="1390" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n929" value="Ổn định" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1466" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n930" value="Đang tái cân bằng" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="356" y="1466" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n931" value="Ổn định — thế hệ mới" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="656" y="1466" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e932" value="nút rời hoặc gia nhập" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="276" y="1491" as="sourcePoint" />
            <mxPoint x="356" y="1491" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e933" value="phân công lại" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="576" y="1491" as="sourcePoint" />
            <mxPoint x="656" y="1491" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n934" value="&lt;b&gt;Hai chiến lược tái cân bằng.&lt;/b&gt; Chiến lược cũ buộc toàn bộ consumer dừng và trả lại mọi phân vùng trước khi nhận phân công mới. Chiến lược tăng dần chỉ thu hồi tập phân vùng thực sự cần dịch chuyển; các consumer không liên quan tiếp tục xử lý bình thường." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="896" y="1450" width="728" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n935" value="&lt;b&gt;Ngăn chặn tiến trình lạc thế hệ&lt;/b&gt;&lt;br&gt;Khi một consumer xử lý vượt quá ngưỡng &lt;code&gt;max.poll.interval.ms&lt;/code&gt;, bộ điều phối coi như nó đã dừng và giao phân vùng cho consumer khác. Nếu tiến trình cũ sau đó hoàn tất và gửi lệnh ghi nhận tiến độ, dữ liệu sẽ bị xử lý hai lần.&lt;br&gt;Mỗi lần tái cân bằng, bộ điều phối tăng số hiệu thế hệ của nhóm. Lệnh ghi nhận mang số hiệu cũ bị từ chối.&lt;br&gt;&lt;br&gt;&lt;b&gt;Mô thức chung.&lt;/b&gt; Cơ chế này trùng với nguyên lý Epoch của KRaft ở mục D và với &lt;code&gt;_seq_no&lt;/code&gt; của Elasticsearch (tab 09): hệ phân tán ngăn tình trạng phân liệt bằng một số thứ tự thế hệ chỉ tăng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1546" width="1548" height="116" as="geometry" />
        </mxCell>
        <mxCell id="n936" value="&lt;b&gt;Ràng buộc về khả năng mở rộng.&lt;/b&gt; Trong cùng một nhóm, mỗi phân vùng chỉ được đọc bởi tối đa một consumer. Số phân vùng vì thế là trần mở rộng theo chiều ngang: thêm consumer vượt quá số phân vùng không làm tăng thông lượng.&lt;br&gt;&lt;b&gt;Lưu ý khi quy hoạch.&lt;/b&gt; Tăng số phân vùng về sau sẽ thay đổi kết quả phép băm khoá, làm mất trình tự đã thiết lập với dữ liệu cũ. Số phân vùng cần được chọn với tầm nhìn dài hạn ngay từ đầu.&lt;br&gt;&lt;b&gt;Nhiều nhóm trên một chủ đề&lt;/b&gt; là mô hình được hỗ trợ sẵn: mỗi nhóm giữ con trỏ tiến độ độc lập và không ảnh hưởng lẫn nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1676" width="1548" height="122" as="geometry" />
        </mxCell>
        <mxCell id="n937" value="D · BẦU CHỌN NÚT ĐIỀU PHỐI THEO THUẬT TOÁN RAFT" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1700" y="130" width="980" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n938" value="Follower" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="200" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n939" value="Candidate" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2036" y="200" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n940" value="Leader" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2336" y="200" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e941" value="hết thời gian chờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n938" target="n939">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e942" value="đạt quá bán phiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n939" target="n940">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e943" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2446" y="268" as="sourcePoint" />
            <mxPoint x="2446" y="306" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e944" value="phát hiện thế hệ cao hơn" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2446" y="306" as="sourcePoint" />
            <mxPoint x="1846" y="306" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e945" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1846" y="306" as="sourcePoint" />
            <mxPoint x="1846" y="268" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n946" value="Bước" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="336" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n947" value="Diễn biến trong cụm ba nút" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1826" y="336" width="818" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n948" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="366" width="90" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n949" value="Nút thứ nhất giữ vai trò điều phối ở thế hệ 1, ghi thay đổi cấu hình vào chủ đề nội bộ. Hai nút còn lại sao chép trạng thái và gửi tín hiệu duy trì kết nối." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1826" y="366" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n950" value="2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="442" width="90" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n951" value="Nút điều phối ngừng hoạt động. Hai nút còn lại không nhận được tín hiệu, bộ đếm thời gian chờ bắt đầu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1826" y="442" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n952" value="3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="518" width="90" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n953" value="Nút hết thời gian chờ trước chuyển sang trạng thái ứng cử, tăng số thế hệ lên 2 và gửi yêu cầu bỏ phiếu kèm bằng chứng về mức độ đầy đủ của bản ghi cấu hình." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1826" y="518" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n954" value="4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="594" width="90" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n955" value="Nút còn lại đối chiếu và chấp thuận. Cộng phiếu tự bầu, ứng cử viên đạt hai trên ba phiếu và trở thành nút điều phối của thế hệ 2." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1826" y="594" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n956" value="5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="670" width="90" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n957" value="Nút cũ hoạt động trở lại với nhận thức thuộc thế hệ 1. Mệnh lệnh của nó bị từ chối; nhận được phản hồi mang thế hệ cao hơn, nó tự hạ cấp và đồng bộ lại trạng thái." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1826" y="670" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n958" value="&lt;b&gt;Vai trò của số thế hệ (Epoch).&lt;/b&gt; Mọi mệnh lệnh mang số thế hệ cũ đều bị từ chối. Nhờ đó cụm không thể tồn tại đồng thời hai nút cùng tự nhận là điều phối, kể cả khi mạng bị chia cắt tạm thời." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1736" y="746" width="908" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n959" value="E · NHÂN BẢN VÀ TẬP BẢN SAO ĐỒNG BỘ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1700" y="850" width="980" height="440" as="geometry" />
        </mxCell>
        <mxCell id="n960" value="Hệ số nhân bản N  ⇒  chịu được mất tối đa (N − 1) Broker mà không mất dữ liệu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="900" width="908" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n961" value="Vai trò" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="960" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n962" value="Quy tắc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1946" y="960" width="698" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n963" value="Leader" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="990" width="210" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n964" value="Tại mỗi thời điểm, mỗi phân vùng chỉ có một Broker giữ vai trò này. Producer chỉ ghi vào đây." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="990" width="698" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n965" value="Follower" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1058" width="210" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n966" value="Sao chép dữ liệu từ Leader. Mặc định consumer cũng chỉ đọc từ Leader, nhưng có thể cấu hình đọc từ bản sao gần nhất để giảm chi phí truyền dữ liệu giữa các vùng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1058" width="698" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n967" value="Tập ISR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1126" width="210" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n968" value="Danh sách bản sao đang bắt kịp Leader trong ngưỡng thời gian cho phép. Bản sao chậm bị loại khỏi danh sách." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1126" width="698" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n969" value="Chuyển đổi dự phòng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1194" width="210" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n970" value="Khi Leader dừng, chỉ bản sao đang nằm trong tập ISR được đề cử thay thế — đây là điều kiện bảo đảm không mất dữ liệu đã xác nhận." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1194" width="698" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n971" value="F · CHÍNH SÁCH LƯU TRỮ VÀ CẤU HÌNH ÁP DỤNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1310" width="980" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n972" value="Chính sách" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1362" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n973" value="Cơ chế" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1362" width="698" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n974" value="Theo thời gian" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1392" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n975" value="Giữ dữ liệu trong khoảng thời gian định trước, mặc định 168 giờ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1392" width="698" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n976" value="Theo dung lượng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1454" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n977" value="Giữ tối đa một lượng dữ liệu cho mỗi phân vùng, vượt ngưỡng thì xoá tệp cũ nhất." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1454" width="698" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n978" value="Nén theo khoá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1516" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n979" value="Chỉ giữ bản ghi mới nhất của mỗi khoá. Phù hợp để lưu trạng thái hiện hành thay vì toàn bộ lịch sử biến đổi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1946" y="1516" width="698" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n980" value="&lt;b&gt;Cấu hình áp dụng cho matching-service&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Chủ đề &lt;code&gt;matching.events&lt;/code&gt;, ba phân vùng — tương ứng trần mở rộng ba tiến trình xử lý.&lt;br&gt;• Khoá phân vùng là định danh chuyến đi, bảo đảm mọi sự kiện của cùng một chuyến giữ đúng trình tự.&lt;br&gt;• Producer đặt &lt;code&gt;acks=all&lt;/code&gt; và bật cơ chế chống ghi trùng.&lt;br&gt;• Consumer ghi nhận tiến độ thủ công sau khi hoàn tất xử lý — tương ứng ngữ nghĩa at-least-once, do đó logic gửi thông báo phải bảo đảm không phát sinh tác động lặp.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cấu hình cụm:&lt;/b&gt; ba nút điều phối và ba nút dữ liệu được tách riêng để mặt phẳng điều khiển không tranh chấp tài nguyên với mặt phẳng dữ liệu. Danh sách thành viên hội đồng bầu chọn phải khai báo đầy đủ ngay từ thời điểm khởi động." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1736" y="1584" width="908" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
