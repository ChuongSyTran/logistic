        <mxCell id="n344" value="&lt;b&gt;Bảng định tuyến&lt;/b&gt;&lt;br&gt;&lt;code&gt;10.0.0.0/16 → local&lt;/code&gt; — luật mặc định, không thể xoá.&lt;br&gt;&lt;code&gt;0.0.0.0/0 → igw-id&lt;/code&gt; — &lt;b&gt;luật này xác định Subnet thuộc loại Public.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
