          <mxGeometry x="76" y="730" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1113" value="Bộ đệm trong bộ nhớ&lt;br&gt;&lt;i&gt;chưa tìm kiếm được&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="316" y="722" width="240" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1114" value="Translog&lt;br&gt;&lt;i&gt;ghi xuống đĩa ngay&lt;/i&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="616" y="716" width="240" height="78" as="geometry" />
        </mxCell>
        <mxCell id="e1115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1112" target="n1113">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1112" target="n1114">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1117" value="Refresh — chu kỳ mặc định 1 giây ⇒ sinh phân đoạn mới, dữ liệu tìm kiếm được" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="316" y="826" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1118" value="Flush — đồng bộ phân đoạn xuống đĩa, xoá translog" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="316" y="894" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1119" value="Merge — hợp nhất phân đoạn nhỏ, loại bỏ bản ghi đã đánh dấu xoá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="316" y="962" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1113" target="n1117">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1117" target="n1118">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1118" target="n1119">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1123" value="&lt;b&gt;Vai trò của translog.&lt;/b&gt; Nếu chỉ dựa vào chu kỳ refresh thì sự cố mất điện sẽ làm mất dữ liệu của khoảng thời gian chưa kịp ghi đĩa. Translog được ghi xuống đĩa ngay từ đầu và được phát lại khi khởi động lại.&lt;br&gt;&lt;br&gt;Cơ chế này tương đương WAL của PostgreSQL và binlog của MySQL ở tab 06 — cùng một nguyên lý được áp dụng lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="896" y="826" width="350" height="186" as="geometry" />
        </mxCell>
        <mxCell id="n1124" value="&lt;b&gt;Tính bất biến của phân đoạn.&lt;/b&gt; Phân đoạn đã ghi ra đĩa không bao giờ được sửa. Đổi lại: đọc không cần khoá, bộ nhớ đệm luôn hợp lệ, và dữ liệu được nén tối ưu vì biết trước toàn bộ nội dung.&lt;br&gt;&lt;b&gt;Chi phí phải trả:&lt;/b&gt; thao tác xoá chỉ đánh dấu bản ghi là đã loại bỏ; thao tác sửa được thực hiện bằng cách đánh dấu bản cũ và ghi bản mới. Dung lượng chỉ thực sự được thu hồi khi tiến trình hợp nhất chạy — đó là lý do chỉ mục bị cập nhật thường xuyên có dung lượng lớn hơn nhiều so với dữ liệu thực tế." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1030" width="1170" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n1125" value="Tuỳ chọn refresh" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1152" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1126" value="Hành vi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="1152" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1127" value="Trường hợp áp dụng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="776" y="1152" width="470" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1128" value="mặc định" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1182" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1129" value="Trả về ngay, dữ liệu tìm kiếm được sau khoảng một giây." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="296" y="1182" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1130" value="Chuẩn cho môi trường vận hành." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="776" y="1182" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1131" value="&lt;code&gt;wait_for&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1222" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1132" value="Chờ tới chu kỳ refresh kế tiếp mới trả về." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="296" y="1222" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1133" value="Giao diện cần hiển thị kết quả ngay sau khi ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="776" y="1222" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1134" value="&lt;code&gt;true&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1262" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1135" value="Ép sinh phân đoạn ngay lập tức." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="296" y="1262" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1136" value="Chỉ dùng trong kiểm thử. Sinh ra rất nhiều phân đoạn nhỏ, gây tải nặng cho tiến trình hợp nhất." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="776" y="1262" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1137" value="D · TRUY VẤN PHÂN TÁN HAI PHA" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="670" width="1340" height="620" as="geometry" />
        </mxCell>
        <mxCell id="n1138" value="Nút điều phối" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="736" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1139" value="Phân mảnh 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1706" y="716" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n1140" value="Phân mảnh 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1706" y="790" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n1141" value="Phân mảnh 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1706" y="864" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e1142" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=1;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1138" target="n1139">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1143" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=1;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1138" target="n1140">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1144" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=1;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1138" target="n1141">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1145" value="&lt;b&gt;Pha 1 — Query.&lt;/b&gt; Nút điều phối gửi truy vấn tới toàn bộ phân mảnh liên quan. Mỗi phân mảnh tự tìm kiếm, tự chấm điểm và chỉ trả về danh sách định danh kèm điểm số, chưa gửi nội dung.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pha 2 — Fetch.&lt;/b&gt; Nút điều phối hợp nhất, sắp xếp, chọn tập kết quả cuối cùng rồi hỏi lại đúng những phân mảnh chứa các bản ghi đó để lấy nội dung đầy đủ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="716" width="644" height="202" as="geometry" />
        </mxCell>
        <mxCell id="n1146" value="shard = hash(_routing) % số phân mảnh chính        (mặc định _routing là định danh bản ghi)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="936" width="1274" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1147" value="&lt;b&gt;Hệ quả trực tiếp: không thể thay đổi số phân mảnh chính sau khi tạo chỉ mục.&lt;/b&gt; Thay đổi mẫu số làm phép chia lấy dư cho kết quả khác, khiến hệ thống tìm sai vị trí của toàn bộ dữ liệu cũ. Việc thay đổi phải thực hiện qua lập chỉ mục lại sang chỉ mục mới." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1356" y="984" width="1274" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1148" value="Đặc tính" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1058" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1149" value="Trạng thái hỗ trợ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1656" y="1058" width="974" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1150" value="Giao dịch nhiều bản ghi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1088" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1151" value="Không hỗ trợ. Tính nguyên tử chỉ áp dụng ở phạm vi một bản ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1656" y="1088" width="974" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1152" value="Nhất quán giữa bản chính và bản sao" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1134" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1153" value="Nhất quán cuối cùng — bản sao có độ trễ so với bản chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1656" y="1134" width="974" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1154" value="Chống ghi đè đồng thời" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1180" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1155" value="Khoá lạc quan qua &lt;code&gt;_seq_no&lt;/code&gt; và &lt;code&gt;_primary_term&lt;/code&gt;. Xung đột trả về mã 409 để bên gọi tự thử lại." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1656" y="1180" width="974" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1156" value="Phân trang sâu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1226" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1157" value="Chi phí tăng theo độ sâu vì mỗi phân mảnh phải trả về toàn bộ tập kết quả tính đến trang đó. Có ngưỡng chặn cứng; giải pháp là phân trang theo con trỏ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1656" y="1226" width="974" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1158" value="E · VỊ TRÍ TRONG KIẾN TRÚC VÀ BÀI TOÁN ĐỒNG BỘ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="1240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="n1159" value="Ứng dụng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1420" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n1160" value="Cơ sở dữ liệu&lt;br&gt;quan hệ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="316" y="1398" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n1161" value="Elasticsearch" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="596" y="1398" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n1162" value="Truy vấn đọc" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="816" y="1420" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="e1163" value="ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1159" target="n1160">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1164" value="đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=1;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1160" target="n1161">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1165" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1161" target="n1162">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1166" value="&lt;b&gt;Nguồn sự thật&lt;/b&gt;&lt;br&gt;Bảo đảm tính nguyên tử và ràng buộc toàn vẹn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="316" y="1518" width="160" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n1167" value="&lt;b&gt;Mô hình đọc&lt;/b&gt;&lt;br&gt;Có thể mất và tái tạo lại từ nguồn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="596" y="1518" width="160" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n1168" value="&lt;b&gt;Tiêu chí kiểm tra kiến trúc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mất toàn bộ cụm chỉ mục phải là sự cố khắc phục được bằng lập chỉ mục lại từ cơ sở dữ liệu, không gây mất mát bản ghi nghiệp vụ nào.&lt;br&gt;&lt;br&gt;Nếu điều kiện này không thoả mãn, dữ liệu nghiệp vụ đang nằm sai vị trí." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1036" y="1398" width="210" height="188" as="geometry" />
        </mxCell>
        <mxCell id="n1169" value="Chiến lược đồng bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1606" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1170" value="Đánh giá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="336" y="1606" width="910" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1171" value="Ghi song song" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1636" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1172" value="Ghi lần lượt vào hai nơi. Đơn giản nhưng không nguyên tử: khi thao tác thứ hai thất bại, dữ liệu lệch vĩnh viễn và không có cơ chế phát hiện. &lt;b&gt;Đây là cách đang áp dụng.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="336" y="1636" width="910" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1173" value="Transactional Outbox" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1694" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1174" value="Ghi dữ liệu và bản ghi sự kiện trong cùng một giao dịch; tiến trình nền đọc bảng sự kiện và đẩy sang chỉ mục. Không mất sự kiện, cho phép thử lại. &lt;b&gt;Hạ tầng cần thiết đã có sẵn trong kho mã.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="336" y="1694" width="910" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1175" value="Change Data Capture" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1752" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1176" value="Đọc trực tiếp nhật ký thay đổi của cơ sở dữ liệu. Tầng nghiệp vụ không cần biết tới sự tồn tại của chỉ mục, nhưng chi phí vận hành cao." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="336" y="1752" width="910" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1177" value="Lập chỉ mục lại định kỳ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1810" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1178" value="Tiến trình chạy theo lịch quét toàn bộ dữ liệu. Đơn giản và tự khắc phục sai lệch, nhưng độ trễ lớn. Phù hợp làm lớp đối soát bổ sung." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="336" y="1810" width="910" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1179" value="F · TIÊU CHÍ ÁP DỤNG VÀ VẤN ĐỀ TỒN ĐỌNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1330" width="1340" height="560" as="geometry" />
        </mxCell>
        <mxCell id="n1180" value="Nên áp dụng khi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1382" width="630" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1181" value="Không nên áp dụng khi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1382" width="644" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1182" value="Dữ liệu vượt một triệu bản ghi và tiếp tục tăng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1414" width="630" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1183" value="Dưới năm trăm nghìn bản ghi — cơ chế toàn văn của cơ sở dữ liệu quan hệ đủ đáp ứng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1414" width="644" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1184" value="Cần tìm kiếm văn bản tự do và xếp hạng theo độ liên quan." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1460" width="630" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1185" value="Cần tính nguyên tử hoặc phép nối nhiều bảng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1460" width="644" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1186" value="Cần tổng hợp đa chiều với thời gian phản hồi thấp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1506" width="630" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1187" value="Cần đọc thấy dữ liệu ngay lập tức sau khi ghi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1506" width="644" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1188" value="Tỷ lệ đọc áp đảo ghi và chấp nhận độ trễ khoảng một giây." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1552" width="630" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1189" value="Cần số liệu chính xác tuyệt đối phục vụ đối soát tài chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1552" width="644" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1190" value="Có nhân sự vận hành được cụm — điều kiện thường bị bỏ qua." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1598" width="630" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1191" value="Chỉ nhằm thay thế bộ nhớ đệm — công cụ chuyên dụng phù hợp hơn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1986" y="1598" width="644" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1192" value="Vấn đề tồn đọng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1644" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1193" value="Tác động và hướng xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1696" y="1644" width="934" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1194" value="Lập chỉ mục bên trong giao dịch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1674" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1195" value="Độ trễ hoặc lỗi của chỉ mục kéo dài thời gian giữ khoá và có thể làm huỷ giao dịch nghiệp vụ. Cần tách thao tác này ra ngoài phạm vi giao dịch." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1696" y="1674" width="934" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1196" value="Điều kiện lọc thời gian cố định" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1740" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1197" value="Tham số không nhận được từ bên gọi, hạn chế khả năng sử dụng của giao diện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1696" y="1740" width="934" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1198" value="Bỏ qua lỗi khi lập chỉ mục" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="1806" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n1199" value="Sai lệch dữ liệu diễn ra âm thầm. Tối thiểu cần ghi nhật ký, đếm chỉ số lỗi và bổ sung tiến trình đối soát." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1696" y="1806" width="934" height="66" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
