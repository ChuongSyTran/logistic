        <mxCell id="n671" value="Hiện thực hoá giao diện. Nơi duy nhất chứa câu truy vấn và cấu hình nhóm kết nối." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
