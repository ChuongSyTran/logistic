        <mxCell id="n1305" value="&lt;b&gt;Đồng bộ mô hình đọc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Consumer cập nhật chỉ mục tìm kiếm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 09&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1070" y="986" width="300" height="76" as="geometry" />
