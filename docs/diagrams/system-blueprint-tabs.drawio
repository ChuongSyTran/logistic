        <mxCell id="n1249" value="Còn lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
