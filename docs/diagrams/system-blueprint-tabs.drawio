        </mxCell>
        <mxCell id="n386" value="Cho phép và chặn (deny). Mặc định cho phép toàn bộ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
