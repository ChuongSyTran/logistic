          <mxGeometry x="1536" y="1338" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n503" value="Thực thi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1578" y="1330" width="230" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n504" value="Truyền tệp cấu hình, sinh biến môi trường, khởi chạy dịch vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1818" y="1330" width="726" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n505" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1400" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n506" value="Thu hồi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
