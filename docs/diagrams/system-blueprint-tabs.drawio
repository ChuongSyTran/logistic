        </mxCell>
        <mxCell id="n602" value="Gọi API để cấp phát tài nguyên thật, ghi kết quả vào tệp trạng thái." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
