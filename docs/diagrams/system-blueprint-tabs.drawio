        <mxCell id="n1237" value="&lt;code&gt;grpc.NewServer(&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;grpc.StatsHandler(otelgrpc.NewServerHandler()),&lt;/code&gt;&lt;br&gt;&lt;code&gt;)&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
