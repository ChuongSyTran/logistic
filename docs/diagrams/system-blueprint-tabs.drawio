        </mxCell>
        <mxCell id="n1034" value="Seed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1666" y="836" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n1035" value="Khoá bí mật. Không truyền qua mạng trong mọi trường hợp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1886" y="836" width="538" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n1036" value="&lt;b&gt;Cách ly đa tổ chức.&lt;/b&gt; Các tài khoản dùng chung tài nguyên máy chủ nhưng cách ly tuyệt đối ở tầng truyền thông điệp: một tài khoản không thể quan sát luồng dữ liệu của tài khoản khác trên cùng cụm.&lt;br&gt;Tiền tố cho phép nhận biết vai trò của một khoá ngay từ chuỗi định danh, giảm rủi ro nhầm lẫn khi vận hành cụm lớn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="884" width="888" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n1037" value="&lt;b&gt;Liên hệ với tab 03.&lt;/b&gt; Nguyên lý giống hệt cơ chế xác thực bằng khoá SSH: bên gửi ký bằng khoá bí mật, bên nhận xác minh bằng khoá công khai. Điểm khác biệt là thẻ JWT mang theo phạm vi quyền, nên máy chủ vừa xác thực danh tính vừa xác định quyền hạn trong cùng một thao tác." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1002" width="888" height="114" as="geometry" />
        </mxCell>
        <mxCell id="n1038" value="D · CÔNG CỤ VẬN HÀNH VÀ GIÁM SÁT" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="1420" height="440" as="geometry" />
        </mxCell>
        <mxCell id="n1039" value="Công cụ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1202" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1040" value="Mục đích sử dụng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="376" y="1202" width="1050" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1041" value="&lt;code&gt;nats&lt;/code&gt; (natscli)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1232" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1042" value="Kiểm thử gửi và nhận thông điệp, quản lý luồng lưu trữ JetStream." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1232" width="1050" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1043" value="&lt;code&gt;nats-top&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1284" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1044" value="Theo dõi mức sử dụng bộ nhớ, số kết nối và tốc độ thông điệp theo thời gian thực trên giao diện dòng lệnh." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1284" width="1050" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1045" value="&lt;code&gt;nats-box&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1336" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1046" value="Ảnh container chứa sẵn bộ công cụ, dùng để chẩn đoán trong môi trường điều phối container." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1336" width="1050" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1047" value="&lt;code&gt;prometheus-nats-exporter&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1388" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1048" value="Xuất chỉ số vận hành theo định dạng chuẩn để tổng hợp và trực quan hoá." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1388" width="1050" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1049" value="&lt;b&gt;Cấu hình đang áp dụng.&lt;/b&gt; Máy chủ chạy với tuỳ chọn bật JetStream, chỉ định thư mục lưu trữ và mở cổng giám sát HTTP. Cổng 4222 phục vụ kết nối ứng dụng, cổng 8222 phục vụ truy vấn chỉ số vận hành. Thư mục lưu trữ được gắn vào ổ đĩa bền vững để dữ liệu không mất khi tiến trình khởi động lại.&lt;br&gt;&lt;b&gt;Đặc điểm triển khai.&lt;/b&gt; Toàn bộ tính năng — phân cụm, lưu trữ bền vững, WebSocket, MQTT — nằm trong một tệp nhị phân duy nhất và được kích hoạt bằng cấu hình, không cần thành phần phụ trợ bên ngoài." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1440" width="1350" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n1050" value="E · HƯỚNG MỞ RỘNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1150" width="960" height="440" as="geometry" />
        </mxCell>
        <mxCell id="n1051" value="Hạng mục" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1202" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1052" value="Nội dung" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1836" y="1202" width="588" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1053" value="Triển khai theo mô hình khai báo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1232" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1054" value="Định nghĩa luồng lưu trữ và tiến trình tiêu thụ bằng tệp cấu hình thay vì lệnh thủ công, để trạng thái mong muốn nằm trong kho mã nguồn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1836" y="1232" width="588" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1055" value="Cấp phát bằng mã" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1316" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1056" value="Quản lý tài khoản và luồng dữ liệu qua nhà cung cấp Terraform, thống nhất với cách quản lý hạ tầng ở tab 04." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1836" y="1316" width="588" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1057" value="Tích hợp xử lý luồng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1400" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1058" value="Kết nối tới nền tảng xử lý luồng để phục vụ nhu cầu phân tích thời gian thực ở quy mô lớn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1836" y="1400" width="588" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n1059" value="&lt;b&gt;Nguyên tắc chung.&lt;/b&gt; Terraform cho hạ tầng, tệp cấu hình khai báo cho tài nguyên trung gian truyền thông điệp — cùng một triết lý: trạng thái mong muốn được mô tả bằng mã, hệ thống tự hội tụ về trạng thái đó." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1536" y="1490" width="888" height="68" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
