        <mxCell id="n469" value="CA xác minh&lt;br&gt;quyền sở hữu tên miền" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
