        </mxCell>
        <mxCell id="n389" value="Chặn nhanh một dải địa chỉ ở phạm vi toàn Subnet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
