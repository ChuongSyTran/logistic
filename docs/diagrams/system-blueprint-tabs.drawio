        <mxCell id="n1264" value="Tổng hợp toàn bộ tài liệu theo trình tự thực thi. Mỗi làn tương ứng một phạm vi hạ tầng; số hiệu trên mỗi bước dẫn chiếu tới tab trình bày chi tiết." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a5b6a;fontStyle=0;" vertex="1" parent="1">
