        <mxCell id="n712" value="Ví điện tử và giao dịch. Dịch vụ duy nhất sử dụng Elasticsearch. Đang phát triển." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
