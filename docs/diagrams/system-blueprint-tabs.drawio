        </mxCell>
        <mxCell id="n1061" value="ELASTICSEARCH — MÔ HÌNH ĐỌC TRONG KIẾN TRÚC PHÂN TÁCH TRÁCH NHIỆM" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=27;fontStyle=1;fontColor=#12314f;" vertex="1" parent="1">
          <mxGeometry x="152" y="16" width="2200" height="51" as="geometry" />
        </mxCell>
        <mxCell id="n1062" value="Chỉ mục ngược và tính bất biến của phân đoạn giải thích toàn bộ đặc tính vận hành: độ trễ hiển thị, hiện tượng phình dung lượng, và ràng buộc về số phân mảnh." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a5b6a;fontStyle=0;" vertex="1" parent="1">
