        <mxCell id="n265" value="&lt;b&gt;Bảng phiên NAT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;14.22.33.44:33333&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;↕&lt;br&gt;&lt;code&gt;192.168.1.5:51000&lt;/code&gt;&lt;br&gt;&lt;br&gt;Cổng nguồn là khoá phân biệt các phiên dùng chung một địa chỉ công cộng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2290" y="1010" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n266" value="&lt;b&gt;Bản chất kỹ thuật.&lt;/b&gt; Thiết bị biên dịch đồng thời cả địa chỉ và &lt;b&gt;cổng&lt;/b&gt; — do đó cơ chế còn được gọi là PAT. Cổng đóng vai trò định danh phiên, cho phép nhiều máy trong mạng nội bộ dùng chung một địa chỉ công cộng duy nhất.&lt;br&gt;&lt;b&gt;Áp dụng trên đám mây.&lt;/b&gt; NAT Gateway cho phép tài nguyên tại Private Subnet khởi tạo kết nối ra ngoài để cập nhật gói phần mềm hoặc gọi dịch vụ bên thứ ba, trong khi vẫn chặn hoàn toàn kết nối khởi tạo từ chiều ngược lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1300" width="1270" height="108" as="geometry" />
        </mxCell>
