        <mxCell id="n390" value="E · TRUY CẬP QUẢN TRỊ QUA BASTION HOST VÀ ĐƯỜNG HẦM SSH" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
