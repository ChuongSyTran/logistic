        <mxCell id="e580" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=1;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n559" target="n561">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n581" value="&lt;b&gt;Vì sao máy chủ đích không tự lấy mã nguồn.&lt;/b&gt; Nếu máy chủ tự thực hiện thao tác đồng bộ mã, nó phải lưu thông tin xác thực của kho mã nguồn. Trong mô hình hiện tại, tiến trình CI đóng gói và đẩy tệp sang qua kênh mã hoá, nên máy chủ đích không nắm giữ bất kỳ thông tin xác thực nào của kho mã." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="758" width="1240" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n582" value="&lt;b&gt;Vì sao ảnh được biên dịch tại CI thay vì tại máy chủ.&lt;/b&gt; Máy chủ chỉ tải ảnh đã dựng sẵn từ registry, không chạy trình biên dịch. Điều này giữ tài nguyên máy chủ cho tiến trình phục vụ, đồng thời cho phép ghim chính xác phiên bản triển khai theo mã commit và quay lui nhanh khi cần." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="758" width="1240" height="88" as="geometry" />
        </mxCell>
