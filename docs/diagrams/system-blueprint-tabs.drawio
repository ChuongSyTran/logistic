        </mxCell>
        <mxCell id="n1250" value="Áp dụng cho wallet-service và notification-service khi hoàn thiện." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1446" y="888" width="1018" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1251" value="Còn lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1336" y="940" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1252" value="&lt;b&gt;Lan truyền ngữ cảnh vào tiêu đề thông điệp Kafka và NATS&lt;/b&gt; — mắt xích quan trọng nhất còn thiếu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1446" y="940" width="1018" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1253" value="Còn lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1336" y="992" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1254" value="Cân nhắc gắn vào lớp ORM nếu cần theo vết tới từng câu truy vấn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1446" y="992" width="1018" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1255" value="Còn lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1336" y="1044" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1256" value="Bổ sung thành phần thu thập và giao diện trực quan vào cấu hình môi trường." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1446" y="1044" width="1018" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n1257" value="D · YÊU CẦU VẬN HÀNH" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="2460" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n1258" value="&lt;b&gt;Đẩy dữ liệu trước khi tiến trình kết thúc&lt;/b&gt;&lt;br&gt;Span được gom thành lô trước khi truyền đi để giảm tải mạng. Nếu tiến trình dừng đột ngột, lô cuối cùng chưa kịp gửi sẽ mất — và đó thường chính là các span mô tả sự cố dẫn tới việc dừng.&lt;br&gt;&lt;b&gt;Yêu cầu:&lt;/b&gt; gọi hàm đóng bộ theo vết với thời gian chờ xác định trong quy trình dừng dịch vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1222" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1259" value="&lt;b&gt;Lấy mẫu ở môi trường vận hành&lt;/b&gt;&lt;br&gt;Ghi vết toàn bộ lưu lượng tạo ra khối lượng dữ liệu lớn và làm tăng chi phí xử lý.&lt;br&gt;&lt;b&gt;Chiến lược áp dụng:&lt;/b&gt; lấy mẫu một tỷ lệ nhỏ lưu lượng thông thường, đồng thời giữ lại toàn bộ các yêu cầu có lỗi hoặc thời gian phản hồi vượt ngưỡng. Ở môi trường phát triển giữ tỷ lệ đầy đủ để thuận tiện chẩn đoán." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="876" y="1222" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1260" value="&lt;b&gt;Trình tự phân tích khi có sự cố&lt;/b&gt;&lt;br&gt;① So sánh tổng thời gian của vết với ngưỡng thông thường.&lt;br&gt;② Xác định span chiếm phần lớn thời gian.&lt;br&gt;③ Kiểm tra dấu hiệu span con lặp lại — biểu hiện của truy vấn trong vòng lặp.&lt;br&gt;④ Vết đứt đoạn cho thấy điểm chưa được gắn thư viện hoặc ngữ cảnh không được truyền qua." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1676" y="1222" width="800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1261" value="&lt;b&gt;Khuyến nghị bổ sung.&lt;/b&gt; Đưa định danh vết vào tiêu đề phản hồi trả về cho bên gọi. Khi tiếp nhận báo cáo sự cố, định danh này cho phép truy xuất chính xác yêu cầu tương ứng thay vì tìm kiếm theo thời điểm và điều kiện gần đúng.&lt;br&gt;&lt;b&gt;Ba trụ cột bổ trợ lẫn nhau:&lt;/b&gt; vết trả lời yêu cầu đi qua đâu và chậm ở đâu; chỉ số trả lời hệ thống có bất thường không; nhật ký trả lời chi tiết điều gì đã xảy ra. Nhật ký cần mang định danh vết để nối được với hai trụ cột còn lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1370" width="2400" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
