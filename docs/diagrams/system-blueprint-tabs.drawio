        <mxCell id="n849" value="Tham số" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1302" width="230" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n850" value="Hệ quả khi cấu hình sai" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1302" width="678" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n851" value="Kích thước nhóm kết nối" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1334" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n852" value="Quá nhỏ khiến yêu cầu xếp hàng chờ; quá lớn vượt giới hạn kết nối đồng thời của hệ quản trị và toàn bộ kết nối bị từ chối." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1334" width="678" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n853" value="Thời gian chờ kết nối" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1416" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n854" value="Không khai báo sẽ khiến tiến trình chờ vô hạn khi máy chủ không phản hồi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1416" width="678" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n855" value="Giữ kết nối (keepalive)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1498" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n856" value="Thiếu cấu hình khiến kết nối bị thiết bị mạng trung gian đóng âm thầm; lỗi chỉ bộc lộ ở truy vấn kế tiếp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1498" width="678" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n857" value="Nhật ký truy vấn chậm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1580" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n858" value="Không bật sẽ mất manh mối đầu tiên khi hiệu năng suy giảm dần theo thời gian." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1580" width="678" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n859" value="Địa chỉ máy chủ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1616" y="1662" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n860" value="Trong môi trường container phải dùng tên dịch vụ; &lt;code&gt;127.0.0.1&lt;/code&gt; trỏ về chính container đang chạy, không phải máy chủ dữ liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1662" width="678" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
