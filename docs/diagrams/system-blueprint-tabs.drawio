        <mxCell id="n537" value="CORS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1396" y="1754" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n538" value="Chính sách do trình duyệt áp đặt giữa các nguồn gốc khác nhau." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1646" y="1754" width="480" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n539" value="Khắc phục bằng tiêu đề &lt;code&gt;Access-Control-Allow-Origin&lt;/code&gt; phía máy chủ, không liên quan tới chứng thư." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2126" y="1754" width="450" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n540" value="&lt;b&gt;Ghi chú thực hành.&lt;/b&gt; Chứng thư tự ký ở môi trường phát triển thường bị trình duyệt chặn kèm thông báo lỗi mạng chung chung, dễ bị hiểu nhầm là lỗi CORS. Khi gặp hiện tượng này, cần kiểm tra trạng thái chứng thư trước khi thay đổi cấu hình CORS phía máy chủ.&lt;br&gt;&lt;b&gt;Về JWT.&lt;/b&gt; Phần tải trọng chỉ được mã hoá Base64 nên ai cũng đọc được — không đặt dữ liệu nhạy cảm tại đây. Tính chống giả mạo nằm ở chữ ký: máy chủ tính lại HMAC-SHA256 từ khoá bí mật và so sánh, mọi thay đổi nội dung đều làm chữ ký sai lệch." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1810" width="2464" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
