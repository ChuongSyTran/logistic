          <mxGeometry x="1516" y="1586" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n289" value="Trùng dải mặc định của VPC do AWS khởi tạo và của mạng container." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
