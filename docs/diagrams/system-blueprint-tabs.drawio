          <mxGeometry x="554" y="294" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n316" value="Mỗi phiên bản được ánh xạ vào một vùng địa chỉ vật lý riêng. Đơn vị quản lý bộ nhớ kiểm tra từng lệnh truy cập; vượt ra ngoài vùng cấp phát sẽ kích hoạt ngắt phần cứng và tiến trình bị dừng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="754" y="294" width="406" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n317" value="Mạng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="404" y="370" width="150" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n318" value="Bộ điều khiển Nitro" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="554" y="370" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n319" value="Chức năng mạng được đẩy xuống phần cứng chuyên dụng, tách khỏi bộ xử lý chính." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="754" y="370" width="406" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n320" value="&lt;b&gt;Kết quả.&lt;/b&gt; Mặc dù dùng chung bo mạch, bộ nhớ và bộ xử lý vật lý, mỗi phiên bản EC2 vận hành trong một môi trường cách ly hoàn toàn và không thể quan sát sự tồn tại của các phiên bản khác trên cùng máy chủ.&lt;br&gt;&lt;b&gt;Hệ quả cần lưu ý khi chọn cấu hình.&lt;/b&gt; Cách ly là tuyệt đối về mặt dữ liệu, nhưng băng thông đĩa và mạng vẫn được chia sẻ ở mức vật lý. Đây là lý do các dòng phiên bản khác nhau có mức cam kết băng thông mạng khác nhau." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="448" width="1080" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n321" value="B · GIỚI HẠN CỦA MẠNG VẬT LÝ VÀ SỰ RA ĐỜI CỦA VPC" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1240" y="130" width="1320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="n322" value="Số lượng mạng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1276" y="186" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n323" value="Nhãn VLAN theo chuẩn IEEE 802.1Q dài 12 bit, giới hạn ở 4.096 mạng độc lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1508" y="186" width="620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n324" value="Dung lượng bảng MAC" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1276" y="270" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n325" value="Bộ nhớ CAM của thiết bị chuyển mạch tràn khi máy ảo được sinh và huỷ liên tục ở quy mô lớn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1508" y="270" width="620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n326" value="Độ trễ cấu hình" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1f;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1276" y="354" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n327" value="Không thể lập trình thiết bị vật lý tự cấu hình lại cổng trong khoảng vài mili-giây." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1508" y="354" width="620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n328" value="MẠNG ĐỊNH NGHĨA&lt;br&gt;BẰNG PHẦN MỀM&lt;br&gt;(SDN)&lt;br&gt;&lt;br&gt;&lt;i&gt;nhãn định danh 24 bit&lt;/i&gt;&lt;br&gt;&lt;i&gt;16 triệu mạng độc lập&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2156" y="186" width="372" height="238" as="geometry" />
        </mxCell>
        <mxCell id="e329" value="" style="html=1;rounded=0;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2136" y="300" as="sourcePoint" />
            <mxPoint x="2152" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n330" value="&lt;b&gt;Cách giải quyết.&lt;/b&gt; Logic định tuyến được chuyển lên tầng Hypervisor, không còn phụ thuộc vào thiết bị chuyển mạch vật lý. Mạng ảo hoạt động chồng lớp (overlay) trên hạ tầng truyền dẫn thật (underlay).&lt;br&gt;&lt;b&gt;VPC là sản phẩm của kiến trúc này.&lt;/b&gt; Nhiều tổ chức có thể dùng chung một dải địa chỉ riêng mà không xung đột, và mọi nỗ lực nghe lén giữa các mạng ảo trên cùng máy chủ vật lý đều bị chặn ở mức phần cứng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1276" y="446" width="1252" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n331" value="C · TOPOLOGY VPC CHUẨN — HAI VÙNG SẴN SÀNG, TÁCH BIỆT PUBLIC VÀ PRIVATE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="2520" height="760" as="geometry" />
        </mxCell>
        <mxCell id="n332" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="686" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n333" value="Internet&lt;br&gt;Gateway" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="806" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e334" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=blockThin;endArrow=blockThin;endFill=1;strokeColor=#c98600;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n332" target="n333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n335" value="&lt;b&gt;Internet Gateway&lt;/b&gt; gắn ở ranh giới VPC, thực hiện biên dịch giữa địa chỉ công cộng và địa chỉ riêng theo cả hai chiều.&lt;br&gt;&lt;br&gt;Trước khi thiết bị định tuyến được gắn vào, VPC là môi trường cách ly hoàn toàn, không có lưu lượng ra hoặc vào." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="876" width="160" height="210" as="geometry" />
        </mxCell>
        <mxCell id="n336" value="VPC 10.0.0.0/16 — giới hạn trong một Region, trải qua nhiều Availability Zone" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=8;strokeColor=#d79b00;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
