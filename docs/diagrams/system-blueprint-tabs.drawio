        <mxCell id="n215" value="Cấu trúc gói tin sau mỗi chặng đóng gói" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
