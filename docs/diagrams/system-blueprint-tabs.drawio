        </mxCell>
        <mxCell id="n840" value="Nhiều khoá cùng hết hạn tại một thời điểm khiến tải dồn vào cơ sở dữ liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1554" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n841" value="Phân tán thời gian sống bằng một khoảng ngẫu nhiên nhỏ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="856" y="1554" width="660" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n842" value="Truy vấn khoá không tồn tại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1616" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n843" value="Yêu cầu liên tục cho khoá không có dữ liệu, bộ đệm không phát huy tác dụng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1616" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n844" value="Lưu giá trị rỗng với thời gian sống ngắn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="856" y="1616" width="660" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n845" value="Bộ đệm lệch dữ liệu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1678" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n846" value="Bản ghi được cập nhật nhưng bộ đệm không được xoá." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="1678" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n847" value="Xoá khoá tương ứng trong cùng luồng xử lý ghi; thời gian sống là ràng buộc dự phòng cuối cùng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="856" y="1678" width="660" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n848" value="F · THAM SỐ KẾT NỐI CẦN KHAI BÁO TƯỜNG MINH" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
