        <mxCell id="n1093" value="&lt;code&gt;&quot;Đóng Băng Tiền Cọc &amp;lt;b&amp;gt;2024&amp;lt;/b&amp;gt;!&quot;&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1356" y="264" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1094" value="Gỡ thẻ đánh dấu, thay thế ký tự đặc biệt." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1636" y="264" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1095" value="&lt;b&gt;Bắt buộc, chỉ một bộ tách.&lt;/b&gt; Cắt theo ranh giới từ, loại bỏ dấu câu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1916" y="264" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1096" value="Xếp chồng nhiều lớp: chuyển chữ thường, loại từ dừng, đưa về nguyên thể, mở rộng từ đồng nghĩa." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2196" y="264" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1097" value="Nguyên tắc bắt buộc: câu truy vấn phải đi qua đúng chuỗi xử lý đã dùng khi lập chỉ mục" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="376" width="1274" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1098" value="Khi lập chỉ mục, cụm &lt;code&gt;&quot;Đóng Băng&quot;&lt;/code&gt; được lưu thành hai token đã chuẩn hoá. Nếu câu truy vấn không đi qua cùng chuỗi xử lý, hệ thống tìm token nguyên bản còn chữ hoa — không tồn tại trong chỉ mục — và trả về kết quả rỗng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1356" y="424" width="1274" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n1099" value="Kiểu trường" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1356" y="494" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1100" value="Xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1576" y="494" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1101" value="Loại truy vấn đi kèm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1916" y="494" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1102" value="Sắp xếp và tổng hợp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2256" y="494" width="374" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1103" value="&lt;code&gt;text&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
