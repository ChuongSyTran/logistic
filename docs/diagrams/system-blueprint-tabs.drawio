          <mxGeometry x="2056" y="1116" width="488" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n621" value="&lt;b&gt;Điểm kiểm soát bắt buộc trong CI.&lt;/b&gt; Tệp &lt;code&gt;go.work&lt;/code&gt; gộp toàn bộ mô-đun của kho mã thành một không gian làm việc chung và ghi giá trị băm vào &lt;code&gt;go.work.sum&lt;/code&gt;. Khi dựng ảnh, tiến trình chạy với &lt;code&gt;GOWORK=off&lt;/code&gt; nên trình biên dịch chỉ đọc &lt;code&gt;go.mod&lt;/code&gt; và &lt;code&gt;go.sum&lt;/code&gt; riêng của từng mô-đun.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả:&lt;/b&gt; mã có thể biên dịch thành công tại môi trường phát triển nhưng thất bại khi dựng ảnh do thiếu giá trị băm. Vì vậy tiến trình CI thực thi trước một bước kiểm tra biên dịch độc lập với &lt;code&gt;GOWORK=off&lt;/code&gt; và &lt;code&gt;-mod=readonly&lt;/code&gt;, cho kết quả trong khoảng hai mươi giây thay vì thất bại giữa quá trình dựng ảnh." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1188" width="1168" height="166" as="geometry" />
        </mxCell>
        <mxCell id="n622" value="D · LỆNH CHẨN ĐOÁN THƯỜNG DÙNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1402" width="1240" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n623" value="Lệnh" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1452" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n624" value="Mục đích" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="476" y="1452" width="768" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n625" value="&lt;code&gt;podman ps -a&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1482" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n626" value="Liệt kê toàn bộ container, bao gồm cả tiến trình đã dừng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1482" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n627" value="&lt;code&gt;podman logs -f &amp;lt;tên&amp;gt;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1528" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n628" value="Theo dõi nhật ký theo thời gian thực." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1528" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n629" value="&lt;code&gt;podman exec -it &amp;lt;tên&amp;gt; /bin/sh&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1574" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n630" value="Truy cập vào không gian tên của container để kiểm tra tệp và biến môi trường." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1574" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n631" value="&lt;code&gt;podman-compose up -d --build&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1620" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n632" value="Dựng lại và khởi chạy toàn bộ ngăn xếp ở chế độ nền." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1620" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n633" value="&lt;code&gt;podman system prune -f&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1666" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n634" value="Giải phóng bộ nhớ đệm dựng ảnh và các ảnh không còn tham chiếu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1666" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n635" value="&lt;code&gt;podman volume ls&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1712" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n636" value="Liệt kê ổ đĩa lưu trữ — nơi chứa dữ liệu bền vững của cơ sở dữ liệu." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="1712" width="768" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n637" value="&lt;b&gt;Trình tự chẩn đoán khi dịch vụ ngừng phục vụ.&lt;/b&gt;&lt;br&gt;Bước 1 — liệt kê container để xác định tiến trình nào đã thoát. Bước 2 — đọc nhật ký của tiến trình đó. Bước 3 — truy cập vào bên trong để kiểm tra biến môi trường và khả năng kết nối nội bộ. Bước 4 — nếu là lỗi kết nối, kiểm tra Security Group và bảng định tuyến (tab 02)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1798" width="1168" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n638" value="E · CÁC SỰ CỐ ĐÃ GẶP VÀ BIỆN PHÁP KHẮC PHỤC" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1402" width="1240" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n639" value="Hiện tượng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1452" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n640" value="Nguyên nhân và cách xử lý" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1452" width="768" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n641" value="&lt;code&gt;dial tcp: i/o timeout&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1482" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n642" value="Security Group từ chối địa chỉ ngẫu nhiên của tác tử triển khai. Áp dụng cơ chế cấp quyền tạm thời (tab 03·E)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1482" width="768" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n643" value="&lt;code&gt;missing go.sum entry&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1544" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n644" value="Không gian làm việc chung che khuất thiếu sót ở mô-đun đơn lẻ. Bổ sung bước kiểm tra &lt;code&gt;GOWORK=off&lt;/code&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1544" width="768" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n645" value="Kết nối SSH tới tên miền bị treo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1606" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n646" value="Lớp proxy biên chỉ xử lý HTTP và HTTPS. Kết nối trực tiếp tới địa chỉ công cộng của máy chủ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1606" width="768" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n647" value="&lt;code&gt;-H: command not found&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1668" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n648" value="Khối văn bản gấp nếp trong YAML không gộp dòng thụt lề sâu hơn. Đưa toàn bộ lệnh về một dòng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1668" width="768" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n649" value="Registry từ chối nhận ảnh" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1730" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n650" value="Tên kho phải viết thường hoàn toàn. Khai báo tiền tố registry ở dạng chữ thường." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1730" width="768" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n651" value="Hai tiến trình triển khai chồng lấn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1376" y="1792" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n652" value="Khai báo nhóm đồng thời với &lt;code&gt;cancel-in-progress: false&lt;/code&gt; để các tiến trình xếp hàng tuần tự." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1776" y="1792" width="768" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="05 · Kiến trúc ứng dụng" id="diag1391">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n653" value="05" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=34;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="96" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n654" value="KIẾN TRÚC ỨNG DỤNG — PHÂN TẦNG VÀ ĐẢO NGƯỢC PHỤ THUỘC" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=27;fontStyle=1;fontColor=#12314f;" vertex="1" parent="1">
          <mxGeometry x="152" y="16" width="2100" height="51" as="geometry" />
        </mxCell>
        <mxCell id="n655" value="Một yêu cầu đi qua bốn tầng, mỗi tầng chỉ phụ thuộc vào tầng kế tiếp thông qua giao diện trừu tượng." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a5b6a;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="154" y="68" width="2100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e656" value="" style="html=1;rounded=0;startArrow=none;endArrow=none;endFill=1;strokeColor=#12314f;strokeWidth=3;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="104" as="sourcePoint" />
            <mxPoint x="2540" y="104" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n657" value="A · ĐƯỜNG ĐI CỦA MỘT YÊU CẦU QUA CÁC TẦNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#10739e;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1500" height="780" as="geometry" />
        </mxCell>
        <mxCell id="n658" value="Nginx :443" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="190" width="190" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n659" value="gateway-service&lt;br&gt;:8080 · HTTP/JSON" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="306" y="190" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="e660" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=2;dashed=0;fontSize=9;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n658" target="n659">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n661" value="&lt;b&gt;Vai trò chuyển đổi giao thức.&lt;/b&gt; Bên ngoài sử dụng HTTP/JSON để tương thích rộng; mạng nội bộ sử dụng gRPC/Protobuf để giảm kích thước gói tin và ràng buộc lược đồ chặt chẽ. Gateway đồng thời xác thực token và khởi tạo định danh vết." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="566" y="186" width="950" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n662" value="Một dịch vụ (ví dụ user-service)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#b1ddf0;opacity=10;strokeColor=#10739e;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="76" y="282" width="720" height="560" as="geometry" />
        </mxCell>
        <mxCell id="n663" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="96" y="358" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n664" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;internal/controller&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="138" y="326" width="300" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n665" value="Giải mã Protobuf, kiểm tra tính hợp lệ đầu vào, gọi tầng nghiệp vụ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="454" y="326" width="320" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n666" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="96" y="484" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n667" value="&lt;b&gt;Biz — Use Case&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;internal/biz&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="138" y="452" width="300" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n668" value="Chứa quy tắc nghiệp vụ. Chỉ tương tác qua giao diện trừu tượng, không biết công nghệ lưu trữ bên dưới." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
