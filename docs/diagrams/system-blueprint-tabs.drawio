        <mxCell id="n1275" value="&lt;b&gt;Bắt tay TLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Sinh khoá phiên, mã hoá tải trọng&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 03&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1276" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="666" y="218" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1277" value="&lt;b&gt;Đóng gói TCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Cổng nguồn 51234 → cổng đích 443&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1278" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1036" y="218" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1279" value="&lt;b&gt;Đóng gói IP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;192.168.1.5 → 13.212.0.5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1070" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1280" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1406" y="218" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1281" value="&lt;b&gt;Đóng gói khung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Tra ARP lấy địa chỉ cổng mặc định&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1440" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1282" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1776" y="218" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1283" value="&lt;b&gt;Chuyển thành tín hiệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Điều chế trên môi trường truyền dẫn&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1810" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1284" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2146" y="218" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1285" value="&lt;b&gt;Chuyển mạch nội bộ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Bộ chuyển mạch tra bảng MAC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2180" y="196" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1286" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="388" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1287" value="&lt;b&gt;Biên dịch địa chỉ NAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Nguồn đổi thành địa chỉ công cộng, tráo cổng&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="366" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1288" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="666" y="388" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1289" value="&lt;b&gt;Định tuyến từng chặng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Lớp 2 đóng lại mỗi chặng, lớp 3 giữ nguyên. Tuyến do BGP quyết định&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="366" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1290" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="514" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1291" value="&lt;b&gt;Xử lý tại biên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Kết thúc TLS, lọc WAF, giới hạn tần suất, mở phiên mới về máy chủ gốc&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 03&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="492" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1292" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="632" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1293" value="&lt;b&gt;Vào ranh giới VPC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Internet Gateway biên dịch địa chỉ đích; Security Group kiểm tra cổng và ghi nhớ phiên&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 02&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1294" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="750" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1295" value="&lt;b&gt;Giải mã và chuyển tiếp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Nginx giải mã, bổ sung tiêu đề nguồn, chuyển tới cổng nội bộ 8080&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 02&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="728" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1296" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="870" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1297" value="&lt;b&gt;Xác thực và chuyển giao thức&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Kiểm JWT, khởi tạo TraceID, chuyển HTTP/JSON sang gRPC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 05 · 03 · 10&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="848" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1298" value="13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="666" y="870" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1299" value="&lt;b&gt;Xử lý nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Controller kiểm tra đầu vào → Biz áp dụng quy tắc → Repo chọn nhóm kết nối&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 05&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="848" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1300" value="14" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="296" y="1008" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1301" value="&lt;b&gt;Truy cập dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Ghi vào Master, đọc từ Slave hoặc bộ nhớ đệm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 06&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="986" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1302" value="15" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="666" y="1008" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1303" value="&lt;b&gt;Phát sự kiện&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gửi vào Kafka hoặc NATS để xử lý bất đồng bộ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#8c8c8c&quot;&gt;tab 07 · 08&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="986" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1304" value="16" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
