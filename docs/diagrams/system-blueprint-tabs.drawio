          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1317" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#10739e;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1297" target="n1299">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1318" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b8860b;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1299" target="n1301">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1319" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#5c8a3c;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1301" target="n1303">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1320" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#7b5ea7;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1303" target="n1305">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1321" value="&lt;b&gt;Ranh giới đồng bộ và bất đồng bộ.&lt;/b&gt; Bước 14 nằm trong đường phản hồi trực tiếp cho bên gọi. Bước 15 và 16 diễn ra ngoài đường phản hồi: phản hồi được trả về ngay sau bước 14, còn việc đồng bộ mô hình đọc hoàn tất sau đó. Đây là nguồn gốc của độ trễ hiển thị mô tả tại tab 09." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1440" y="986" width="1380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n1322" value="&lt;b&gt;Hai lần biên dịch địa chỉ trên toàn tuyến.&lt;/b&gt; Lần thứ nhất tại thiết bị định tuyến của mạng cục bộ (bước 7), lần thứ hai tại ranh giới VPC (bước 10). Trên toàn bộ chặng trung gian giữa hai điểm này, gói tin lớp 3 được giữ nguyên vẹn.&lt;br&gt;&lt;b&gt;Hai lần thiết lập phiên mã hoá.&lt;/b&gt; Phiên thứ nhất giữa thiết bị người dùng và mạng biên, phiên thứ hai giữa mạng biên và máy chủ gốc. Nội dung được giải mã tại biên để kiểm tra, sau đó mã hoá lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1440" y="492" width="1380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n1323" value="B · CHIỀU VỀ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="1400" height="620" as="geometry" />
        </mxCell>
        <mxCell id="n1324" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1316" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1325" value="Dịch vụ trả phản hồi gRPC; Gateway chuyển đổi ngược về HTTP/JSON." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1296" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1326" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1392" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1327" value="Nginx nén nội dung và mã hoá bằng khoá phiên đã thiết lập." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1372" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1328" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1468" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1329" value="Đóng gói TCP và IP với địa chỉ nguồn là địa chỉ riêng của máy chủ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1448" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1330" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1544" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1331" value="Internet Gateway biên dịch địa chỉ nguồn thành địa chỉ công cộng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1524" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1332" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1620" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1333" value="Mạng biên nhận, giải mã, có thể lưu đệm, rồi mã hoá lại bằng khoá phiên với thiết bị người dùng." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1600" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1334" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1696" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1335" value="Thiết bị định tuyến của mạng cục bộ tra bảng phiên NAT và khôi phục địa chỉ đích nội bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1676" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1336" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1772" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1337" value="Bộ chuyển mạch chuyển tiếp tới đúng thiết bị; ứng dụng giải mã và hiển thị kết quả." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="124" y="1752" width="1284" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1338" value="C · ĐÍNH CHÍNH CÁC NHẬN ĐỊNH SAI VÀ BẢNG CỔNG DỊCH VỤ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1240" width="1380" height="620" as="geometry" />
        </mxCell>
        <mxCell id="n1339" value="Nhận định thường gặp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1292" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1340" value="Đính chính" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2016" y="1292" width="808" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1341" value="Địa chỉ MAC không đổi trên toàn tuyến." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1322" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1342" value="Không chính xác. Lớp 2 được đóng lại tại mỗi thiết bị định tuyến. Chỉ gói tin lớp 3 giữ nguyên, trừ khi đi qua NAT." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2016" y="1322" width="808" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1343" value="NAT diễn ra tại mọi thiết bị định tuyến." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1384" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1344" value="Không chính xác. NAT chỉ diễn ra tại hai điểm biên; các chặng trung gian chỉ thực hiện chuyển tiếp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2016" y="1384" width="808" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1345" value="HTTPS che giấu toàn bộ thông tin." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1446" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1346" value="Chưa đầy đủ. Địa chỉ đích, cổng và tên miền trong phần mở rộng SNI vẫn quan sát được. Chỉ tải trọng được mã hoá." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2016" y="1446" width="808" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1347" value="Ghi thành công là đọc thấy ngay ở mọi nơi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1508" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1348" value="Không đúng với hệ phân tán. Bản sao có độ trễ đồng bộ, chỉ mục tìm kiếm có chu kỳ làm mới. Đây là đặc tính cần thiết kế để thích ứng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2016" y="1508" width="808" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1349" value="Bảng cổng dịch vụ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1570" width="1308" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1350" value="22" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1606" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1351" value="SSH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1610" y="1606" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1352" value="80 · 443" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2176" y="1606" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1353" value="HTTP · HTTPS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2270" y="1606" width="554" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1354" value="8080" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1634" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1355" value="gateway-service" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
