        <mxCell id="n234" value="&lt;b&gt;Bảng MAC trên Switch&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Trước bước 3&lt;/i&gt;&lt;br&gt;&lt;code&gt;— trống —&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Sau bước 3&lt;/i&gt;&lt;br&gt;&lt;code&gt;Cổng 1 ↔ MAC của A&lt;/code&gt;&lt;br&gt;&lt;code&gt;Cổng 4 ↔ MAC của B&lt;/code&gt;&lt;br&gt;&lt;br&gt;Bảng này &lt;b&gt;không chứa địa chỉ IP&lt;/b&gt;. Ánh xạ IP ↔ MAC nằm ở bảng ARP trên máy trạm." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2270" y="300" width="290" height="236" as="geometry" />
        </mxCell>
        <mxCell id="n235" value="&lt;b&gt;Ý nghĩa của cơ chế phát tán.&lt;/b&gt; Khi chưa biết địa chỉ phần cứng của đích, khung tin được gửi tới địa chỉ quảng bá và bộ chuyển mạch đẩy ra mọi cổng. Chi phí này chỉ phát sinh ở lần đầu; sau đó bảng MAC được cập nhật và mọi khung tin tiếp theo đi thẳng tới đúng cổng.&lt;br&gt;&lt;br&gt;&lt;b&gt;Giới hạn ở quy mô lớn.&lt;/b&gt; Bộ nhớ bảng MAC của thiết bị vật lý là hữu hạn. Khi số lượng máy ảo sinh và huỷ liên tục ở quy mô điện toán đám mây, bảng này tràn và thiết bị rơi vào trạng thái phát tán liên tục. Đây là một trong ba lý do khiến mạng ảo hoá phải được xây dựng lại bằng phần mềm — trình bày tại tab 02." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="630" width="1270" height="180" as="geometry" />
        </mxCell>
