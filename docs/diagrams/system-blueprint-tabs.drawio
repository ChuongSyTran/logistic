        <mxCell id="e770" value="INSERT · UPDATE · DELETE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n766" target="n767">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e771" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#2e7d32;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n766" target="n768">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e772" value="dòng WAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b8860b;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n767" target="n768">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e773" value="dòng WAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b8860b;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n767" target="n769">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n774" value="&lt;b&gt;Cơ chế nhân bản theo dòng ghi (Streaming Replication)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trước khi thay đổi dữ liệu trên đĩa, hệ quản trị luôn ghi ý định thay đổi vào một nhật ký tuần tự — gọi là WAL trong PostgreSQL, binlog trong MySQL và translog trong Elasticsearch. Ba tên gọi cho cùng một nguyên lý.&lt;br&gt;&lt;br&gt;Nhân bản chính là việc máy chủ chính truyền liên tục dòng nhật ký này qua mạng; máy chủ bản sao nhận và thực thi lại đúng trình tự thao tác đó trên ổ đĩa cục bộ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao hiệu quả:&lt;/b&gt; ghi tuần tự có thông lượng gần với bộ nhớ trong, và nội dung truyền đi là mô tả thao tác chứ không phải bản sao dữ liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="186" width="630" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n775" value="&lt;b&gt;Cơ sở lựa chọn mô hình&lt;/b&gt;&lt;br&gt;• Tỷ lệ truy vấn đọc chiếm phần lớn tải hệ thống; tách luồng cho phép mở rộng phần này độc lập.&lt;br&gt;• Khi máy chủ chính gặp sự cố, một bản sao được nâng cấp thay thế trong thời gian ngắn.&lt;br&gt;• Tác vụ sao lưu chạy trên bản sao, không ảnh hưởng tới thông lượng phục vụ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ràng buộc với ứng dụng.&lt;/b&gt; Tầng truy cập dữ liệu phải duy trì hai nhóm kết nối riêng biệt và tự quyết định định tuyến từng truy vấn, hoặc bổ sung một lớp proxy đảm nhiệm việc này." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="400" width="630" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n776" value="&lt;b&gt;Ràng buộc bắt buộc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mọi lệnh ghi gửi tới bản sao đều bị từ chối ở mức bộ máy lưu trữ, không phụ thuộc vào quy ước ở tầng ứng dụng.&lt;br&gt;&lt;br&gt;Truy vấn cần dữ liệu mới nhất tuyệt đối phải được định tuyến tới máy chủ chính." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f3f00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="470" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n777" value="B · ĐỘ TRỄ ĐỒNG BỘ VÀ HỆ QUẢ VỚI TRẢI NGHIỆM NGƯỜI DÙNG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=8 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
