        <mxCell id="n290" value="&lt;code&gt;192.168.0.0/16&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1516" y="1638" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n291" value="Trùng dải phổ biến của thiết bị định tuyến gia đình; gây xung đột khi kết nối VPN." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1816" y="1638" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n292" value="&lt;b&gt;Phép toán xác định phạm vi mạng.&lt;/b&gt; Ký hiệu &lt;code&gt;/24&lt;/code&gt; nghĩa là 24 bit đầu thuộc phần mạng, 8 bit còn lại thuộc phần máy trạm. Hệ điều hành thực hiện phép AND nhị phân giữa địa chỉ đích và mặt nạ mạng để trả lời câu hỏi ở mục C: &lt;code&gt;10.0.1.37 AND 255.255.255.0 = 10.0.1.0&lt;/code&gt;. Kết quả trùng với địa chỉ mạng của giao diện thì gói tin được gửi trực tiếp; ngược lại gói tin được chuyển tới cổng mặc định." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b5e20;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="1748" width="2464" height="84" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
