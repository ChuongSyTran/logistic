        </mxCell>
        <mxCell id="n90" value="Nginx&lt;br&gt;:80 → :443" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="838" width="230" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n91" value="&lt;b&gt;Reverse proxy tại máy chủ.&lt;/b&gt; Kết thúc phiên TLS với chứng thư gốc, bổ sung &lt;code&gt;X-Real-IP&lt;/code&gt; và &lt;code&gt;X-Forwarded-For&lt;/code&gt;, nén phản hồi JSON, rồi chuyển tiếp tới cổng nội bộ 8080." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="408" y="834" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n92" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="916" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n93" value="PODMAN COMPOSE — mạng bridge nội bộ &quot;logistic_net&quot;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#b1ddf0;opacity=10;strokeColor=#10739e;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="160" y="950" width="1860" height="984" as="geometry" />
        </mxCell>
        <mxCell id="n94" value="gateway-service&lt;br&gt;:8080 · HTTP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="992" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n95" value="&lt;b&gt;Điểm vào duy nhất của tầng ứng dụng.&lt;/b&gt; Xác thực JWT, khởi tạo định danh vết (TraceID), chuyển đổi HTTP/JSON sang gRPC/Protobuf để gọi các dịch vụ nội bộ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="458" y="988" width="720" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n96" value="&lt;b&gt;Lý do dùng gRPC trong mạng nội bộ.&lt;/b&gt; Protobuf mã hoá nhị phân, kích thước nhỏ hơn JSON nhiều lần và ràng buộc lược đồ chặt chẽ; HTTP/2 cho phép ghép nhiều luồng trên một kết nối TCP." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1196" y="988" width="824" height="74" as="geometry" />
        </mxCell>
