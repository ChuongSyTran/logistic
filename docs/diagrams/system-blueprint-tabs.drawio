          <mxGeometry x="1536" y="656" width="230" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n467" value="Đóng gói khoá công khai&lt;br&gt;+ tên miền ⇒ CSR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
