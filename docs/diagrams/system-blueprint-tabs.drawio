        </mxCell>
        <mxCell id="e394" value="SSH :22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n391" target="n392">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e395" value="kết nối nội bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;startArrow=none;endArrow=blockThin;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=0;fontSize=10;fontColor=#12314f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n392" target="n393">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n396" value="Bastion là điểm truy cập duy nhất vào mạng riêng. Security Group của nó chỉ cho phép cổng 22 từ dải địa chỉ quản trị đã đăng ký, và toàn bộ phiên làm việc được ghi nhật ký." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1930" y="1458" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n397" value="ssh -L 19092:127.0.0.1:9092 -L 18090:127.0.0.1:8090 quantri@&amp;lt;dia-chi-bastion&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1560" width="1190" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n398" value="&lt;b&gt;Cơ chế chuyển tiếp cổng cục bộ.&lt;/b&gt; Tham số &lt;code&gt;-L 19092:127.0.0.1:9092&lt;/code&gt; mở cổng 19092 trên máy trạm; mọi kết nối tới cổng đó được truyền qua đường hầm SSH đã mã hoá, rồi từ phía Bastion mở kết nối tiếp tới &lt;code&gt;127.0.0.1:9092&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Kết quả.&lt;/b&gt; Giao diện quản trị của Kafka truy cập được tại &lt;code&gt;localhost:18090&lt;/code&gt; trên máy trạm trong khi không có cổng nào của cụm được mở ra Internet.&lt;br&gt;&lt;b&gt;Lưu ý cấu hình.&lt;/b&gt; Dịch vụ khai báo &lt;code&gt;listen: 127.0.0.1&lt;/code&gt; chỉ nhận kết nối từ chính máy chủ đó; khai báo &lt;code&gt;0.0.0.0&lt;/code&gt; mở cho toàn mạng nội bộ. Giá trị này cần được lựa chọn có chủ đích." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1618" width="1190" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
