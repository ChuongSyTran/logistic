        <mxCell id="n1274" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
