        <mxCell id="n512" value="Có đảo ngược được không" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#22303f;strokeColor=#0b1620;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="846" y="1560" width="470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n513" value="Encoding — Base64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1592" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n514" value="Chuyển đổi định dạng để dữ liệu đi an toàn qua giao thức truyền tải." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="326" y="1592" width="520" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n515" value="Có. Bất kỳ ai cũng giải mã được. Không mang tính bảo mật." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="1592" width="470" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n516" value="Hashing — SHA-256" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1646" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n517" value="Ánh xạ một chiều về chuỗi độ dài cố định 256 bit." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="326" y="1646" width="520" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n518" value="Không. Dùng để kiểm tra tính toàn vẹn." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="1646" width="470" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n519" value="Encryption — AES, RSA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="76" y="1700" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n520" value="Biến đổi hai chiều có khoá." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="326" y="1700" width="520" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n521" value="Có, khi sở hữu khoá tương ứng. Dùng để giữ bí mật." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#000000;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
