# Build context = gốc repo, KHÔNG phải ./vehicle_service
#   podman build -f vehicle_service/Dockerfile -t vehicle_service .
# Giải thích từng bước + cơ chế cache: xem docs/operations/build-process.md

FROM docker.io/library/golang:1.26-alpine AS builder

ENV GOWORK=off \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

WORKDIR /src

COPY api/go.mod api/go.sum ./api/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY vehicle_service/go.mod vehicle_service/go.sum ./vehicle_service/

WORKDIR /src/vehicle_service
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

WORKDIR /src
COPY api/ ./api/
COPY pkg/ ./pkg/
COPY vehicle_service/ ./vehicle_service/

WORKDIR /src/vehicle_service
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/vehicle_service_bin ./cmd


FROM docker.io/library/alpine:3.24

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /out/vehicle_service_bin .

EXPOSE 9005

CMD ["./vehicle_service_bin"]
